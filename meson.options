option('hosted',
       type: 'boolean',
       value: true,
       description: 'Enable hosted platform support (standard C stdlib — malloc/free, file I/O). Disable for bare-metal / freestanding toolchains.',
)

option('cxx_bindings',
       type: 'feature',
       value: 'enabled',
       description: 'Enable C++ bindings'
)

option('tests',
       type: 'feature',
       value: 'enabled',
       description: 'Build the test suite (requires cxx_bindings)'
)

option('glib',
       type: 'feature',
       value: 'auto',
       description: 'Enable GLib object and main loop integration.',
)

option('wyrm',
       type: 'feature',
       value: 'enabled',
       description: 'Enable wyrm standalone interpreter'
)

option('wyrm_bootstrap',
       type: 'string',
       value: '',
       description: 'A preexisting wyrm or wypoc that generates the embedded images: a bare name from PATH, else absolute or relative to the source root. Default: the wyrm on PATH. `ninja wyrm_bootstrap` builds a C one.',
)

option('embed_prebuilt',
       type: 'string',
       value: '',
       description: 'A generated tree of embedded images, instead of -Dwyrm_bootstrap. Needs only a C compiler. Absolute, or relative to the source root.',
)

option('bootstrap_stages',
       type: 'combo',
       choices: ['1', '2'],
       value: '1',
       description: '1: embed what wyrm_bootstrap generates. 2: embed what a wyrm built from that generates.',
)
