# wy/wyrm/compiler/expansion.wy - epic 10a M4
#
# The decorator-expansion driver `compile_module` calls (its `expander`
# argument) when a tree still holds a `decorate` node. It lives outside
# module.wy so that module.wy stays importable by pypoc's interpreter (this
# file needs the C VM's `std::expand` and wyrm::image).
#
# The module being compiled never executes. Its own top-level imports are
# compiled into a "scope" module; `std::expand::expand` (a throwaway VM, see
# src/platform/hosted/expand_native.c) loads that scope, runs
# wyrm::compiler::expand there on the tree and answers the fully expanded
# tree. See doc-llm/addendum-decorator-expansion.md and doc-llm/history/wypoc-vm-port/epic_10a.md.
#
# The scope also imports the predefined decorators first: `@template`
# (wyrm::template, syntax.md G7) needs no import of its own. It leaves out
# the module's imports of host modules (HOST_ONLY_IMPORTS): the expansion VM
# has none, and no decorator can come from one. So a module can still have
# a `__main` that uses std::io (wyrm::parser does).
#
# Requirements on the caller's include path: the `.wyc` images of
# wyrm::compiler::expand and of every module the compiled module imports (the
# expansion VM resolves them through the parent's import hook).

import std::expand
import wyrm::image::*
import wyrm::compiler::context::*
import wyrm::compiler::analysis::*
import wyrm::compiler::module::*

fn _ex_pairs_from(items):
    result := nil
    i := len(items)
    while i > 0:
        i = i - 1
        result = cons(items[i], result)
    return result

# The predefined decorators, imported into every expansion scope ahead of
# the module's own imports: `import wyrm::template::*`. The path head is
# built with sym(): stage0's parser does not take `'::` as a symbol literal.
PREDEFINED_IMPORTS := $[$['import, $[sym("::"), 'wyrm, 'template], $['all]]]

# The host modules an expansion scope skips, as the segments of their paths.
HOST_ONLY_IMPORTS := [$['std, 'io]]

# Whether `stmt`, an import, imports one of HOST_ONLY_IMPORTS: its path is
# `(:: seg...)` with the same segments.
fn _host_only_import(stmt) -> bool:
    path := car(cdr(stmt))
    if (not (path is pair)) or (car(path) != sym("::")):
        return false
    for host in HOST_ONLY_IMPORTS:
        segs := cdr(path)
        want := host
        while (segs is pair) and (want is pair) and (car(segs) == car(want)):
            segs = cdr(segs)
            want = cdr(want)
        if (segs == nil) and (want == nil):
            return true
    return false

# `body`: the statements of the module being compiled. Answers the expanded
# `$['module, ...]` tree, or an error value naming the module.
fn expand_decorators(body, module_name: str):
    imports := []
    for stmt in PREDEFINED_IMPORTS:
        imports ! append(stmt)
    for stmt in body:
        kind := node_kind(stmt)
        if ((kind == 'import) or (kind == 'import_static)) and not _host_only_import(stmt):
            imports ! append(stmt)
    scope_img := compile_module(cons('module, _ex_pairs_from(imports)), "__expand_scope__")
    if scope_img is error:
        return error("decorator expansion of '" + module_name + "': its imports do not compile: "
            + str(error_message(scope_img)))
    blob := to_wyc(scope_img)
    if blob is error:
        return error("decorator expansion of '" + module_name + "': cannot serialize its imports")
    expanded := std::expand::expand(cons('module, body), blob, "wyrm::compiler::expand")
    if expanded is error:
        return error("decorator expansion of '" + module_name + "' failed: " + str(error_message(expanded)))
    if node_kind(expanded) != 'module:
        return error("decorator expansion of '" + module_name + "' failed: the result is not a module tree")
    return expanded
