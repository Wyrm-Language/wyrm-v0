# wy/wyrm/compiler/predefined.wy - epic 10a M0
#
# The predefined-decorator pre-pass: `@template X` becomes `$['template, X]`
# before anything else reads the tree (called first by module.wy's
# `compile_module`), for the sole or innermost decorator of a statement.
# Any outer decorator is left exactly as written - still a `'decorated`
# node, still refused until 10a M3 gives the compiler a real expansion pass
# - and no shadow check happens here: there is no eval context yet to look
# a shadowing user decorator up in, so every `@template` is the built-in.
# M3 replaces this pre-pass with a real lookup (scope first, this built-in
# as the fallback), at which point shadowing works and this file's rewrite
# becomes its fallback shape.
#
# `@template` marks its operand as a *template*: a tree written to be
# quoted, whose code may never be run (see doc/language-spec.md's
# Decorators section). The marking is metadata on the tree, nothing more:
# module.wy's `'template` toplevel handler and statements.wy's statement
# handler are what hand the marking down to a definition's own frame
# (`FnContext.tolerant`, context.wy) so `_compile_or_stub` can stub a body
# that will not lower instead of failing the module.
#
# The `'template` node is produced by decoration, never by parsing - pypoc's
# `@template` is a pass-through that never emits it - so parser-truth checks
# against pypoc's sexpr.py are unaffected. It is recorded in wy/wyrm/ast.wy's
# node-kind table.
#
# The rewrite is a rebuild, not a mutation: the tree is walked like
# std::pairs' `replace`, but the replacement is computed per site, which
# `replace`'s value-replacement cannot do. Everything non-pair and non-list
# passes through untouched, so atoms and literals are shared, not copied.

import std::pairs::*
import wyrm::compiler::analysis::*

# The decorator this pre-pass knows about, by its bare spelling. D7 (epic
# 10a): `template` is a predefined, shadowable decorator, not a reserved
# name - the reserved-ness is an M3 lookup question, not a spelling one.
TEMPLATE_DECORATOR := 'template

# ---------------------------------------------------------------------------
# small local helpers - the `_tail`/`_field` shape every compiler file
# carries, under pre-pass-specific names so the amalgam's flat namespace
# (scripts/run_corpus_sweep.py) cannot shadow a sibling's copy.

fn _pd_tail(node, count: int):
    cur := node
    i := 0
    while i < count:
        if not (cur is pair):
            return error("index out of range")
        cur = cdr(cur)
        i = i + 1
    return cur

fn _pd_field(node, index: int):
    rest := _pd_tail(node, index)
    if rest is error:
        return rest
    return car(rest)

# ---------------------------------------------------------------------------
# site detection and the rewrite

# Is `dec` a `$['decorator, 'template, args]` node? The parser's `decorator`
# rule answers the name as a bare sym (parser.wy's `xid`), so the compare is
# symbol identity, which is value equality for syms on both engines.
fn _pd_is_template_decorator(dec) -> bool:
    if node_kind(dec) != 'decorator:
        return false
    return (_pd_field(dec, 1) catch nil) == TEMPLATE_DECORATOR

# Is `node` a `'decorated` whose innermost (last) decorator is the
# predefined `@template`? wy/wyrm's `'decorated` carries the decorator list
# `stmt_line` collected (ast.wy's table: `decorated -> (decorators, stmt)`),
# outermost first - so "innermost" is the last entry, and a sole decorator
# is both first and last.
#
# The list itself is `many(decorator)`'s product, whose concrete shape is
# an engine accident the parser never commits to (`[]`+`append` walks as a
# pair list under the tree-walking interpreter and as a native list under
# the C VM), so the last element is found both ways.
fn _pd_last_of(decs):
    if decs is nil:
        return nil
    if decs is list:
        if len(decs) == 0:
            return nil
        return decs[len(decs) - 1]
    if decs is pair:
        p := decs
        while cdr(p) is pair:
            p = cdr(p)
        return car(p)
    return nil

fn _pd_is_template_site(node) -> bool:
    if node_kind(node) != 'decorated:
        return false
    return _pd_is_template_decorator(_pd_last_of((_pd_field(node, 1) catch nil)))

# `$['template, X]` - the wrapper node (ast.wy's `template -> (tree)`).
fn _pd_template_of(inner):
    return $['template, inner]

# One site's rewrite. A sole `@template` disappears into the wrapper; an
# innermost one is peeled off the decorator list and the outer decorators
# keep their `'decorated` around the wrapper, so M3's outside-in expansion
# sees exactly the tree it would have seen without this pre-pass. The
# outer decorators are collected in the same shape the engine's `[]`+
# `append` produces, so the rewritten tree matches the parsed one.
fn _pd_rewrite(node):
    decs := _pd_field(node, 1)
    inner := _pd_field(node, 2)
    outers := []
    if decs is pair:
        p := decs
        while (cdr(p) is pair):
            outers ! append(car(p))
            p = cdr(p)
    elif decs is list:
        i := 0
        while i < (len(decs) - 1):
            outers ! append(decs[i])
            i = i + 1
    if len(outers) == 0:
        return _pd_template_of(inner)
    return $['decorated, outers, _pd_template_of(inner)]

# The tree, rebuilt with every template site rewritten. Sites inside quoted
# `$[...]` data rewrite too - the walker cannot tell quoted code from live
# code, and a `'decorated`-shaped literal carrying an innermost `@template`
# is not a shape anything else has a use for.
fn _pd_rewrite_tree(node):
    if _pd_is_template_site(node):
        return _pd_rewrite(node)
    if node is pair:
        return cons(_pd_rewrite_tree(car(node)), _pd_rewrite_tree(cdr(node)))
    if node is list:
        out := []
        for x in node:
            out ! append(_pd_rewrite_tree(x))
        return out
    return node

# The pre-pass entry point: `program_node`'s statement list with every
# `@template` application rewritten. Answers the rebuilt list - `compile_module`
# rebinds its `body` to it, so the declare pass, the definition index and the
# top-level walk all see the same rewritten tree.
fn expand_predefined_decorators(body):
    return _pd_rewrite_tree(body)
