# wy/wyrm/compiler/module.wy - epic 10 M6
#
# Wyrm port of pypoc/wypoc/compiler_bc/module.py: the module pipeline that
# turns a parsed program into a finished image - declare pass, hoisted
# imports, the top-level walk (init code), per-item static flushes, and the
# layout pass that places init at offset 0 and every function body after it.
# This is where the compiler becomes end-to-end runnable: `compile_module`
# answers the image dict `image.wy`'s `to_wyc()` serializes, and (with
# `check`) `verify.wy` has already blessed.
#
# Init code emits in the order spec 6.2 fixes: hoisted imports first, then
# top-level statements in source order, then a zero-value return. Function
# bodies are laid out after init once sizes are known (assemble).
#
# ---------------------------------------------------------------------------
# Deviations from module.py, each forced by the port
#
# 1. No decorator expansion. module.py's `_expand_decorators` runs real
#    wyrm code over the sexpr tree before lowering (see the prereport's
#    item 6: not `_dsl.wy`'s machinery, a `wyrm_eval_parse_tree`-equivalent
#    is new infrastructure). Epic 10a M0 added the slice of it that needs
#    no evaluation at all: predefined.wy's pre-pass rewrites `@template X`
#    to a `'template` wrapper before the walk, and the wrapper handlers
#    here and in statements.wy hand the marking down to the definition's
#    frame so `_compile_or_stub` can stub a body that will not lower. Any
#    other `decorated` node reaching the top-level walk is still refused
#    with `unsupported` - same as every other construct this port has no
#    lowering for; `decorators.wy` is already REFUSED in
#    test/bytecode/manifest.txt, so the deferral is precedented. M3
#    replaces the pre-pass with a real lookup (scope first, the built-in
#    as fallback) so shadowing works.
#
# 2. No message promotion. module.py's `_collect_promotions`/`_emit_promotion`
#    register a plain top-level `fn name` as the wildcard overload of a
#    same-named message, once per arity a typed overload uses
#    (llm-bytecode.md 9). No corpus fixture exercises it (`messages.wy` has
#    only dispatched fns), and promotion recompiles the body - doubling any
#    `static` in it, a caveat pypoc documents and defers itself. The hook is
#    where `_fn_def` left it: plain fns compile exactly as pypoc's
#    unpromoted path does.
#
# 3. No debug section. `emit_debug` is accepted and ignored: image.wy
#    deliberately never emits SEC_DEBUG (epic 9's deferral), and no wy/wyrm
#    node carries a source position to put in it anyway (see handlers.wy's
#    deviation 3). Compare with `--strip` semantically: the images here are
#    the stripped shape already.
#
# 4. Import shapes are wyrm's, not pypoc's flat Import dataclass (ast.wy's
#    module section): an `import`/`import_static` node holds one narrowing
#    body - a bare qualified_name, `import_as`, `import_items`, or
#    `import_all` (the wildcard). `import static` lowers exactly like
#    `import`, as in pypoc: `static` restricts usage by prose convention
#    this compiler does not enforce.
#
# 5. The image is the dict `image.wy` consumes (what its `sections()`/
#    `to_wyc()` encode), assembled here - init's words, then each pending
#    body at its code offset, then the exports/free documents derived from
#    the global slots' flags. Three non-serialized keys ride along:
#    "module_uses" (init's own message references), "init_nlocals" (the
#    init region's frame size, same value as the header's "l"), and
#    "unlowered" (the stub report: [function name, reason] per body that
#    would not lower and became a trapping stub - compiler-side only,
#    never serialized, read by compiler_main.wy's STUB lines and epic
#    10a's scan).

import wyrm::opcodes::*
import wyrm::compiler::context::*
import wyrm::compiler::analysis::*
import wyrm::compiler::expressions::*
import wyrm::compiler::statements::*
import wyrm::compiler::functions::*
import wyrm::compiler::classes::*
import wyrm::compiler::handlers::*
import wyrm::compiler::predefined::*
import wyrm::compiler::verify::*

# ---------------------------------------------------------------------------
# small local helpers - copied rather than imported; see analysis.wy's
# header for why (no cross-module access to a leading-underscore name).

fn _tail(node, count: int):
    cur := node
    i := 0
    while i < count:
        if not (cur is pair):
            return error("index out of range")
        cur = cdr(cur)
        i = i + 1
    return cur

fn _field(node, index: int):
    rest := _tail(node, index)
    if rest is error:
        return rest
    return car(rest)

fn _emit_pack(frame: FnContext, op, f: int = 0, a0: int = 0, a1: int = 0, a2: int = 0, w1: int | nil = nil) -> nil | error:
    words := pack(op, f=f, a0=a0, a1=a1, a2=a2, w1=w1)
    if words is error:
        return words
    frame ! emit_words(words)
    return nil

fn _emit_pairable(frame: FnContext, op, primary: int = 0, secondary: int = 0) -> nil | error:
    words := pack_pairable(op, primary, secondary)
    if words is error:
        return words
    frame ! emit_words(words)
    return nil

# `a::b::c` from a list of name parts (context.wy's _join_parts, which this
# file needs for import paths and free-name spellings).
fn _join_path(parts) -> str:
    out := ""
    i := 0
    n := len(parts)
    while i < n:
        if i > 0:
            out = out + "::"
        out = out + str(parts[i])
        i = i + 1
    return out

# The first `n` parts of an import path (wy has no list slices).
fn _prefix(parts, n: int) -> list:
    out := []
    i := 0
    while i < n:
        out ! append(parts[i])
        i = i + 1
    return out

# The name parts of an import path: a bare sym (`import_items`/`import_all`
# keep single-component paths bare) or a `qualified_name` node (whose SPECS
# entry lists no sub-nodes - the parts ride as plain fields).
fn _path_parts_of(path) -> list | error:
    parts := []
    if path is sym:
        parts ! append(str(path))
        return parts
    if node_kind(path) == 'qualified_name:
        rest := _tail(path, 1)
        while rest is pair:
            parts ! append(str(car(rest)))
            rest = cdr(rest)
        return parts
    return error("an import path is a name or a qualified name")

# One import statement's shape, normalized to what the hoist below emits:
# [path_parts, alias_or_nil, items_or_nil, wildcard, excepts_or_nil].
# `items` is a list of [name, binding] pairs. The narrowing body is one of
# a bare sym (single-component paths: `import geometry`),
# `qualified_name`, `import_as`, `import_items`, or `import_all`.
fn _import_shape(node) -> list | error:
    body := (_field(node, 1) catch nil)
    if body is nil:
        return error("an import needs a body")
    narrowing := car(body)
    if narrowing is sym:
        return [[str(narrowing)], nil, nil, false, nil]
    kind := node_kind(narrowing)
    if kind == 'qualified_name:
        parts := _path_parts_of(narrowing)
        if parts is error:
            return parts
        return [parts, nil, nil, false, nil]
    if kind == 'import_as:
        parts := _path_parts_of((_field(narrowing, 1) catch nil))
        if parts is error:
            return parts
        return [parts, str((_field(narrowing, 2) catch nil)), nil, false, nil]
    if kind == 'import_items:
        parts := _path_parts_of((_field(narrowing, 1) catch nil))
        if parts is error:
            return parts
        items := []
        p := (_field(narrowing, 2) catch nil)
        while p is pair:
            item := car(p)
            name := (_field(item, 1) catch nil)
            alias := (_field(item, 2) catch nil)
            if alias is nil:
                items ! append([str(name), str(name)])
            else:
                items ! append([str(name), str(alias)])
            p = cdr(p)
        return [parts, nil, items, false, nil]
    if kind == 'import_all:
        parts := _path_parts_of((_field(narrowing, 1) catch nil))
        if parts is error:
            return parts
        excepts := (_field(narrowing, 2) catch nil)
        return [parts, nil, nil, true, excepts]
    return error("an import body is a qualified name, import_as, import_items or import_all")

# ---------------------------------------------------------------------------
# the declare pass (module.py's _declare_module_names, over wyrm shapes)

fn _declare_module_names(body, module: ModuleContext) -> nil | error:
    # fn/co names are declared up front too - the docstring intent of
    # module.py's _declare_module_names ("`fn` definitions included"),
    # which its own code does not actually do. Without this, a recursive
    # top-level fn (`replace` in std::pairs) or a forward reference
    # (`field` calling the later-defined `list_tail`) compiles its body's
    # self/name read as a never-filled free global, faulting at run time.
    for node in body:
        kind := node_kind(node)
        if (kind == 'import) or (kind == 'import_static):
            shape := _import_shape(node)
            if shape is error:
                return shape
            parts := shape[0]
            index := module ! declare_global(parts[0])
            if index is error:
                return index
            if not shape[3]:
                # A wildcard binds no leaf name; every other form binds
                # root and leaf (or alias), plus each item's binding.
                leaf := shape[1]
                if leaf is nil:
                    leaf = parts[len(parts) - 1]
                index2 := module ! declare_global(leaf)
                if index2 is error:
                    return index2
                if not (shape[2] is nil):
                    for item in shape[2]:
                        index3 := module ! declare_global(item[1])
                        if index3 is error:
                            return index3
        elif kind == 'class_def:
            index4 := module ! declare_global((_field(node, 1) catch nil))
            if index4 is error:
                return index4
        elif (kind == 'fn_def) or (kind == 'co_def):
            # A dispatched `fn [T] name` is not a module global (it is
            # reached by sending `name`); its plain siblings are.
            if (_field(node, 2) catch nil) is nil:
                index6 := module ! declare_global((_field(node, 1) catch nil))
                if index6 is error:
                    return index6
        elif kind == 'template:
            # predefined.wy's rewrite (epic 10a M0): a template-wrapped
            # definition keeps the same binding it would have had bare -
            # a dispatched `fn [T]` binds no global, a plain
            # `fn`/`co` name does (recursion, forward references, value
            # calls) - so the branch mirrors fn_def's exactly, one wrapper
            # field down.
            inner := (_field(node, 1) catch nil)
            inner_kind := node_kind(inner)
            if (inner_kind == 'fn_def) or (inner_kind == 'co_def):
                if (_field(inner, 2) catch nil) is nil:
                    inner_name := (_field(inner, 1) catch nil)
                    index7 := module ! declare_global(inner_name)
                    if index7 is error:
                        return index7
    for name in own_declared_names(body):
        index5 := module ! declare_global(name)
        if index5 is error:
            return index5
    return nil

# ---------------------------------------------------------------------------
# the definition index (`foo::$ast` reads it - module.py's
# _collect_definitions, over wyrm shapes)

# Index every fn, co and class this module defines, by name. Built from the
# rewritten tree - after predefined.wy's pre-pass, so a `@template`
# definition is indexed as what the marking wrapped, the tree its binding
# would hold (10a M0's stand-in for module.py's "built from the expanded
# tree"; M3 will index what real expansion left behind). Nested definitions
# count: the walk is the same whole-tree one module.py's `program.walk()`
# is. First spelling wins (`setdefault`), matching pypoc.
#
# The index is compile-time state only - nothing is serialized - and it is
# what makes `::$ast` cheap for everyone else: a module that never says
# `::$ast` pays one dict, and only referenced trees are ever materialized
# (expressions.wy's `_astref`, at the reference site).
fn _collect_definitions(body, module: ModuleContext) -> nil | error:
    for node in walk_all_body(body):
        kind := node_kind(node)
        if kind == 'template:
            node = (_field(node, 1) catch nil)
            kind = node_kind(node)
        if (kind == 'fn_def) or (kind == 'co_def) or (kind == 'class_def):
            name := (_field(node, 1) catch nil)
            if not (name is nil):
                key := str(name)
                if not (key in module.definitions):
                    module.definitions[key] = node
    return nil

# ---------------------------------------------------------------------------
# imports (module.py's _hoist_imports and friends)

# `import a::b::c`: load each prefix in turn, then bind the root package
# and the leaf (or its alias) to module globals. The path is a constant
# string, not a table entry: the instruction reads it, splits it, and hands
# it to the loader.
fn _import_module(parts, alias, bind_leaf: bool, module: ModuleContext) -> nil | error:
    init := module.init_ctx
    mark := init ! mark()
    reg := init ! push()
    if reg is error:
        return reg
    depth := 1
    n := len(parts)
    while depth <= n:
        idx := (module.image) ! add_static(_join_path(_prefix(parts, depth)))
        if idx is error:
            return idx
        e := _emit_pairable(init, 'import, idx, reg)
        if e is error:
            return e
        if (depth == 1) and ((n > 1) or (not bind_leaf)):
            gidx := module ! global_index(parts[0])
            if gidx is error:
                return gidx
            e2 := _emit_pairable(init, 'gset, gidx, reg)
            if e2 is error:
                return e2
        depth = depth + 1
    if bind_leaf:
        leaf := alias
        if leaf is nil:
            leaf = parts[n - 1]
        gidx2 := module ! global_index(leaf)
        if gidx2 is error:
            return gidx2
        e3 := _emit_pairable(init, 'gset, gidx2, reg)
        if e3 is error:
            return e3
    return init ! free_to(mark)

# `import a::b::*`: load the module, then register its namespace for the
# resolution search. The except list is a window of interned symbols the
# instruction reads the way `tuple` reads its items.
fn _import_star(parts, excepts, module: ModuleContext) -> nil | error:
    init := module.init_ctx
    e0 := _import_module(parts, nil, false, module)
    if e0 is error:
        return e0
    idx := (module.image) ! add_static(_join_path(parts))
    if idx is error:
        return idx
    mark := init ! mark()
    names := []
    if not (excepts is nil):
        p := excepts
        while p is pair:
            names ! append(str(car(p)))
            p = cdr(p)
    for name in names:
        sym := (module.image) ! add_symbol(name)
        if sym is error:
            return sym
        reg := init ! push()
        if reg is error:
            return reg
        e1 := _emit_pairable(init, 'lsym, sym, reg)
        if e1 is error:
            return e1
    base := init ! mark()
    e2 := _emit_pack(init, 'import_star, f=len(names), a0=idx, a1=L(base))
    if e2 is error:
        return e2
    module.has_wildcard_import = true
    return init ! free_to(mark)

# Emit every import ahead of the resolve point; answer the item bindings
# (`import a::(x, y as z)`) that wait until the walk's own statements can
# have run - each is a reference into the dependency, read once into the
# global it was given, right after the hoisted block.
fn _hoist_imports(body, module: ModuleContext) -> list | error:
    pending := []
    for node in body:
        kind := node_kind(node)
        if (kind != 'import) and (kind != 'import_static):
            continue
        shape := _import_shape(node)
        if shape is error:
            return shape
        parts := shape[0]
        alias := shape[1]
        items := shape[2]
        wildcard := shape[3]
        excepts := shape[4]
        if wildcard:
            e := _import_star(parts, excepts, module)
            if e is error:
                return e
            continue
        e2 := _import_module(parts, alias, true, module)
        if e2 is error:
            return e2
        if not (items is nil):
            for item in items:
                pending ! append([parts, item[0], item[1]])
    return pending

# `import a::(x, y as z)`: a free slot named by the whole path - filled by
# the `import` above it that made the path reachable - copied into the
# global the statement binds. Two slots rather than one because the two are
# different names: `a::x` is what was read, `y` is what it became.
fn _bind_imported_names(pending: list, module: ModuleContext) -> nil | error:
    init := module.init_ctx
    for entry in pending:
        parts := entry[0]
        path_names := []
        for part in parts:
            path_names ! append(part)
        path_names ! append(entry[1])
        source := module ! declare_free_global(_join_path(path_names))
        if source is error:
            return source
        gidx := module ! global_index(entry[2])
        if gidx is error:
            return gidx
        mark := init ! mark()
        reg := init ! push()
        if reg is error:
            return reg
        e := _emit_pairable(init, 'gget, source, reg)
        if e is error:
            return e
        e2 := _emit_pairable(init, 'gset, gidx, reg)
        if e2 is error:
            return e2
        e3 := init ! free_to(mark)
        if e3 is error:
            return e3
    return nil

# ---------------------------------------------------------------------------
# the top-level handlers (module.py's @toplevel registry, keyed by kind)

# A plain top-level `fn`/`co`: a function entry plus, in init, a closure
# over it stored into the module global of its name. The promotion half of
# pypoc's `_fn_def` is not ported (deviation 2).
fn _plain_fn_toplevel(node, module: ModuleContext, tolerant: bool = false) -> nil | error:
    r := compile_function(node, module, nil, 0, nil, tolerant)
    if r is error:
        return r
    index := r[0]
    gidx := module ! declare_global((_field(node, 1) catch nil))
    if gidx is error:
        return gidx
    init := module.init_ctx
    reg := init ! push()
    if reg is error:
        return reg
    e := _emit_pack(init, 'closure, a0=reg, a1=index, a2=0, f=0)
    if e is error:
        return e
    return _emit_pairable(init, 'gset, gidx, reg)

fn _fn_toplevel(node, module: ModuleContext, extra, tolerant: bool = false) -> nil | error:
    if (_field(node, 2) catch nil) is nil:
        # A `$`-prefixed name is an ordinary function (parser.wy's `$_mk_*`
        # callbacks are called by name, as in pypoc); the old
        # "TreeBase-method shorthand" is gone.
        return _plain_fn_toplevel(node, module, tolerant)
    return compile_dispatched_fn_toplevel(node, module, tolerant)

# Imports were hoisted and emitted before the walk; nothing is left to do
# where the statement actually appears.
fn _import_toplevel(node, module: ModuleContext, extra) -> nil | error:
    return nil

# dispatch calls every handler with (node, frame, extra); the class entry
# point's two-parameter shape gets the wrapper it needs.
fn _class_toplevel(node, module: ModuleContext, extra) -> nil | error:
    return compile_class_toplevel(node, module)

# A `'template` wrapper (predefined.wy's rewrite of `@template X`, epic 10a
# M0). The marking is handed down to fn/co definitions so their frames
# compile tolerantly - a body that will not lower stubs instead of failing
# the module - and everything else compiles exactly as written: a class
# body's methods have no stub path to mark yet, and a template on a plain
# statement relieves nothing (outside a function body a lowering failure is
# a refusal either way).
fn _template_toplevel(node, module: ModuleContext, extra) -> nil | error:
    inner := (_field(node, 1) catch nil)
    kind := node_kind(inner)
    if (kind == 'fn_def) or (kind == 'co_def):
        return _fn_toplevel(inner, module, extra, true)
    if kind == 'class_def:
        return _class_toplevel(inner, module, extra)
    return compile_statement(inner, module.init_ctx)

register_toplevel(['class_def], _class_toplevel)
register_toplevel(['fn_def, 'co_def], _fn_toplevel)
register_toplevel(['import, 'import_static], _import_toplevel)
register_toplevel(['template], _template_toplevel)

# ---------------------------------------------------------------------------
# statics (module.py's _flush_statics)

# Run the `static` initializers the item just compiled declared: bound once
# where the owner is created (spec 7.2), in init, right after the closure
# that publishes it - never on every call.
fn _flush_statics(module: ModuleContext) -> nil | error:
    init := module.init_ctx
    pending := module.pending_statics
    module.pending_statics = []
    for entry in pending:
        index := entry[0]
        value_node := entry[1]
        mark := init ! mark()
        reg := init ! push()
        if reg is error:
            return reg
        r := compile_expr(value_node, init, reg)
        if r is error:
            return r
        e := _emit_pairable(init, 'gset, index, reg)
        if e is error:
            return e
        e2 := init ! free_to(mark)
        if e2 is error:
            return e2
    return nil

# ---------------------------------------------------------------------------
# assemble (module.py's _assemble, into the dict image.wy consumes)

fn _assemble(module: ModuleContext) -> dict | error:
    image := module.image
    init := module.init_ctx
    code := []
    for w in init.code:
        code ! append(w)
    for entry in module.pending:
        fn_entry := image.functions[entry[0]]
        fn_entry["code_offset"] = len(code)
        for w in entry[1].code:
            code ! append(w)
    exports := {}
    free := {}
    i := 0
    while i < len(image.globals):
        gslot := image.globals[i]
        if gslot["exported"]:
            exports[gslot["name"]] = i
        if gslot["free"]:
            free[gslot["name"]] = i
        i = i + 1
    uses := []
    for u in init.uses:
        uses ! append(u)
    stubs := []
    for s in image.unlowered:
        stubs ! append(s)
    img := {}
    img["name"] = image.module_name
    img["version"] = 1
    img["globals"] = len(image.globals)
    img["init_l"] = init.high
    img["init_nlocals"] = init.high
    img["module_uses"] = uses
    img["unlowered"] = stubs
    img["statics"] = image.statics
    img["slot_defaults"] = nil
    img["symbols"] = image.symbols
    img["functions"] = image.functions
    img["classes"] = image.classes
    img["messages"] = image.messages
    if len(exports) > 0:
        img["exports"] = exports
    if len(free) > 0:
        img["free"] = free
    img["code"] = code
    return img

# ---------------------------------------------------------------------------
# the entry point

# ---------------------------------------------------------------------------
# decorator expansion hook (epic 10a M3/M4)
#
# The module being compiled never executes. When its tree still holds a
# `'decorated` node after the predefined-decorator pre-pass, `compile_module`
# hands the statements to the caller's `expander` (wyrm::compiler::expansion's
# `expand_decorators` for the real thing: it compiles a scope module of the
# module's imports and runs std::expand). The hook keeps this file free of
# std::expand and wyrm::image, which pypoc's interpreter cannot import.

# Does any `'decorated` node remain in `node`? Walks pair chains iteratively,
# recursing only into elements, so depth follows tree nesting, not list length.
fn _has_decorated(node) -> bool:
    if node is pair:
        if car(node) == 'decorated:
            return true
        cur := node
        while cur is pair:
            if _has_decorated(car(cur)):
                return true
            cur = cdr(cur)
        return false
    if (node is list) or (node is tuple):
        for x in node:
            if _has_decorated(x):
                return true
    return false

# Compile a parsed program into a finished module image (the dict
# image.wy's `to_wyc` serializes), verifying it first unless `check` is
# false. Lowering is strict since 10a M0: a function body that will not
# lower fails the whole module, unless the definition is under a
# `@template` marking (predefined.wy's rewrite) - then the body becomes a
# trapping stub with the reason recorded on the image. Anything outside a
# function body is a refusal either way.
fn compile_module(program_node, module_name: str, source_file = nil, check: bool = true,
                  slot_optimization: bool = false, emit_debug: bool = false,
                  stub_unlowered: bool = false, expander = nil) -> dict | error:
    module := ModuleContext(module_name, source_file)
    module.slot_optimization = slot_optimization
    module.stub_unlowered = stub_unlowered
    body := cdr(program_node)
    if node_kind(program_node) != 'module:
        return error("compile_module needs a 'module node")

    # Predefined decorators first (epic 10a M0): `@template X` becomes a
    # `'template` wrapper before the declare pass or the walk reads the
    # tree, so every later stage sees one shape.
    rewritten := expand_predefined_decorators(body)
    if rewritten is error:
        return rewritten
    body = rewritten

    # Decorators that remain (anything but a lone `@template`, which the
    # pre-pass consumed) expand before lowering, by the caller's expander.
    # Modules without any pay nothing.
    if _has_decorated(body):
        if expander is nil:
            return error("'" + module_name + "' has decorators but no expander was supplied (see wyrm::compiler::expansion)")
        expanded := expander(body, module_name)
        if expanded is error:
            return expanded
        body = cdr(expanded)

    d := _declare_module_names(body, module)
    if d is error:
        return d
    c := _collect_definitions(body, module)
    if c is error:
        return c
    pending := _hoist_imports(body, module)
    if pending is error:
        return pending
    b := _bind_imported_names(pending, module)
    if b is error:
        return b

    init := module.init_ctx
    visible := []
    for name in module.globals:
        visible ! append(name)
    scopes := init ! allocate_block_scopes(body, visible)
    if scopes is error:
        return scopes

    for node in body:
        mark := init ! mark()
        var r: nil | error
        if supported(TOPLEVEL_HANDLERS, node):
            r = dispatch(TOPLEVEL_HANDLERS, node, module, nil)
        else:
            r = compile_statement(node, init)
        if r is error:
            return r
        f := _flush_statics(module)
        if f is error:
            return f
        fr := init ! free_to(mark)
        if fr is error:
            return fr

    # Module init returns no values: the loader calls it for its effects.
    e := _emit_pack(init, 'return, a0=0, f=0)
    if e is error:
        return e
    p := init ! patch_labels()
    if p is error:
        return p

    img := _assemble(module)
    if img is error:
        return img
    if check:
        v := verify(img)
        if v is error:
            return v
    return img

# ---------------------------------------------------------------------------
# REPL session (doc/repl-plan.md, M2)
#
# One ModuleContext (and its ModuleImage) lives for the whole session, so
# global slots, statics, symbols, functions, classes and - crucially - message
# identities keep their absolute numbering from one input to the next. Each
# input compiles into a *delta*: the tail of every pool beyond what earlier
# inputs left, an init of its own as a function-table entry (the delta
# header's `i`), and code offsets that continue where the last input's code
# ended. Nothing about the ordinary compile_module path changes.
#
# Each input is a scope nested in the ones before it (ModuleContext.
# _declare_session_global): redeclaring a name shadows it with a fresh slot,
# and a name used before anything defines it is a forward reference the first
# declaration fills. A failed input is rolled back to a snapshot taken before
# it, so a bad line changes nothing.

class SessionContext:
    slot module: ModuleContext
    slot inputs: int
    slot code_len: int
    # What undoing the last successful compile needs (session_undo): the
    # snapshot taken before it, the undo list of older global entries it
    # touched, and the session's code length before it.
    slot last_snap
    slot last_undo
    slot last_code_len

    fn init():
        m := ModuleContext("__repl__", nil)
        m.session_declared = {}
        this.module = m
        this.inputs = 0
        this.code_len = 0
        this.last_snap = nil
        this.last_undo = []
        this.last_code_len = 0

fn new_session() -> SessionContext:
    return SessionContext()

# The elements of `items` from index `start` on (wy has no list slices).
fn _from(items: list, start: int) -> list:
    out := []
    i := start
    n := len(items)
    while i < n:
        out ! append(items[i])
        i = i + 1
    return out

# Shrink `items` to `n` elements (a helper so no statement has to start with `(`).
fn _truncate(items: list, n: int) -> nil:
    items ! resize(n)
    return nil

# Everything an input can change that is not append-only: pool lengths (to
# truncate back to) and shallow copies of the name dictionaries (to put back).
fn _session_snapshot(session: SessionContext) -> dict:
    m := session.module
    image := m.image
    snap := {}
    snap["lens"] = [len(image.statics), len(image.symbols), len(image.messages), len(image.globals), len(image.functions), len(image.classes), len(m.static_imports)]
    snap["image_dicts"] = [copy(image._static_index), copy(image._symbol_index), copy(image._message_index), copy(image._global_index), copy(image._free_index)]
    snap["module_dicts"] = [copy(m.globals), copy(m.classes), copy(m.class_statics), copy(m.slot_names), copy(m.superclasses), copy(m.definitions), copy(m.promoted_arities), copy(m.session_pending)]
    snap["wildcard"] = m.has_wildcard_import
    return snap

fn _session_restore(session: SessionContext, snap: dict) -> nil:
    m := session.module
    image := m.image
    # Older global entries this input touched (a filled forward slot): put back.
    undo := m.session_undo
    i := len(undo) - 1
    while i >= 0:
        entry := image.globals[undo[i][0]]
        entry["exported"] = undo[i][1]
        entry["free"] = undo[i][2]
        i = i - 1
    lens := snap["lens"]
    _truncate(image.statics, lens[0])
    _truncate(image.symbols, lens[1])
    _truncate(image.messages, lens[2])
    _truncate(image.globals, lens[3])
    _truncate(image.functions, lens[4])
    _truncate(image.classes, lens[5])
    _truncate(m.static_imports, lens[6])
    d := snap["image_dicts"]
    image._static_index = d[0]
    image._symbol_index = d[1]
    image._message_index = d[2]
    image._global_index = d[3]
    image._free_index = d[4]
    e := snap["module_dicts"]
    m.globals = e[0]
    m.classes = e[1]
    m.class_statics = e[2]
    m.slot_names = e[3]
    m.superclasses = e[4]
    m.definitions = e[5]
    m.promoted_arities = e[6]
    m.session_pending = e[7]
    m.has_wildcard_import = snap["wildcard"]
    m.session_undo = []
    m.session_filled = []
    m.pending = []
    m.pending_statics = []
    return nil

# Compile one input (a `'module` tree) against the session; answers the delta
# image dict `image.wy`'s to_wyc() serializes, or an error, in which case the
# session is exactly as it was. `expander` is the decorator hook, as for
# compile_module. Verification is skipped: verify.wy reads a whole image, and
# the loader bounds-checks every delta.
fn compile_snippet(session: SessionContext, program_node, expander = nil) -> dict | error:
    if node_kind(program_node) != 'module:
        return error("compile_snippet needs a 'module node")
    snap := _session_snapshot(session)
    before := session.code_len
    r := _compile_snippet_body(session, program_node, expander)
    if r is error:
        _session_restore(session, snap)
        return r
    session.last_snap = snap
    session.last_code_len = before
    return r

# Undo the last successful compile_snippet: for a host that then could not
# load its delta (the session was full), so the two sides stay in step. A
# no-op when there is nothing to undo.
fn session_undo_last(session: SessionContext) -> nil:
    snap := session.last_snap
    if snap is nil:
        return nil
    session.module.session_undo = session.last_undo
    _session_restore(session, snap)
    session.code_len = session.last_code_len
    session.last_snap = nil
    return nil

fn _compile_snippet_body(session: SessionContext, program_node, expander) -> dict | error:
    module := session.module
    image := module.image
    session.inputs = session.inputs + 1
    name := "<repl-" + str(session.inputs) + ">"

    module.session_declared = {}
    module.session_undo = []
    module.session_filled = []
    module.pending = []
    module.pending_statics = []
    image.module_uses = []
    image.unlowered = []
    module.init_ctx = FnContext(module, name, nil, nil, 0, true, nil)

    wm_statics := len(image.statics)
    wm_symbols := len(image.symbols)
    wm_messages := len(image.messages)
    wm_globals := len(image.globals)
    wm_functions := len(image.functions)
    wm_classes := len(image.classes)

    body := cdr(program_node)
    rewritten := expand_predefined_decorators(body)
    if rewritten is error:
        return rewritten
    body = rewritten
    if _has_decorated(body):
        if expander is nil:
            return error("this input has decorators but no expander was supplied (see wyrm::compiler::expansion)")
        expanded := expander(body, name)
        if expanded is error:
            return expanded
        body = cdr(expanded)

    d := _declare_module_names(body, module)
    if d is error:
        return d
    c := _collect_definitions(body, module)
    if c is error:
        return c
    pending := _hoist_imports(body, module)
    if pending is error:
        return pending
    b := _bind_imported_names(pending, module)
    if b is error:
        return b

    init := module.init_ctx
    visible := []
    for gname in module.globals:
        visible ! append(gname)
    scopes := init ! allocate_block_scopes(body, visible)
    if scopes is error:
        return scopes

    nodes := []
    for node in body:
        nodes ! append(node)
    last := len(nodes) - 1
    returned := false
    idx := 0
    for node in nodes:
        mark := init ! mark()
        var r: nil | error
        if (idx == last) and (node_kind(node) == 'expr_stmt) and (not supported(TOPLEVEL_HANDLERS, node)):
            # A trailing bare expression is the input's value: return it.
            value := (_field(node, 1) catch nil)
            reg := compile_expr(value, init, nil)
            if reg is error:
                return reg
            f0 := _flush_statics(module)
            if f0 is error:
                return f0
            re := init ! emit_return(reg)
            if re is error:
                return re
            returned = true
            idx = idx + 1
            continue
        if supported(TOPLEVEL_HANDLERS, node):
            r = dispatch(TOPLEVEL_HANDLERS, node, module, nil)
        else:
            r = compile_statement(node, init)
        if r is error:
            return r
        f := _flush_statics(module)
        if f is error:
            return f
        fr := init ! free_to(mark)
        if fr is error:
            return fr
        idx = idx + 1

    if not returned:
        nreg := init ! push()
        if nreg is error:
            return nreg
        en := _emit_pack(init, 'lnil, a0=nreg)
        if en is error:
            return en
        re2 := init ! emit_return(nreg)
        if re2 is error:
            return re2
    p := init ! patch_labels()
    if p is error:
        return p

    init_index := image ! add_function(name, nil, init.high, 0, 0, nil, 0, 1, nil)
    if init_index is error:
        return init_index

    # Lay out: this input's init, then each pending body, at offsets that
    # continue the session's code.
    base := session.code_len
    code := []
    for w in init.code:
        code ! append(w)
    image.functions[init_index]["code_offset"] = base
    for entry in module.pending:
        fn_entry := image.functions[entry[0]]
        fn_entry["code_offset"] = base + len(code)
        for w in entry[1].code:
            code ! append(w)

    exports := {}
    free := {}
    i := wm_globals
    while i < len(image.globals):
        gslot := image.globals[i]
        if gslot["exported"]:
            exports[gslot["name"]] = i
        if gslot["free"]:
            free[gslot["name"]] = i
        i = i + 1
    for filled in module.session_filled:
        exports[filled[0]] = filled[1]

    img := {}
    img["name"] = "__repl__"
    img["version"] = 1
    img["globals"] = len(image.globals)
    img["init_l"] = init.high
    img["init_nlocals"] = init.high
    img["module_uses"] = []
    img["unlowered"] = _from(image.unlowered, 0)
    img["statics"] = _from(image.statics, wm_statics)
    img["slot_defaults"] = nil
    img["symbols"] = _from(image.symbols, wm_symbols)
    img["functions"] = _from(image.functions, wm_functions)
    img["classes"] = _from(image.classes, wm_classes)
    img["messages"] = _from(image.messages, wm_messages)
    if len(exports) > 0:
        img["exports"] = exports
    if len(free) > 0:
        img["free"] = free
    img["code"] = code
    img["delta"] = {"bc": base, "bf": wm_functions, "bs": wm_statics, "by": wm_symbols, "bk": wm_classes, "bm": wm_messages, "bg": wm_globals, "i": init_index}

    session.code_len = base + len(code)
    session.last_undo = module.session_undo
    module.session_undo = []
    return img
