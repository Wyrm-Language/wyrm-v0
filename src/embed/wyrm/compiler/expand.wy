# wy/wyrm/compiler/expand.wy - epic 10a M3
#
# The decorator expander. It does NOT run in the compiling VM: `std::expand`
# (src/platform/hosted/expand_native.c) creates a throwaway machine, loads a
# "scope" module (only the compiling module's imports), loads this module and
# calls `expand_tree(tree, scope)` there. Only tree-shaped data crosses in and
# out. See doc-llm/addendum-decorator-expansion.md for the language rules and
# doc-llm/history/wypoc-vm-port/epic_10a.md (D1-D10) for the design.
#
# What it does: walk the module tree in source order. A `(decorate name
# target arg...)` node (ast.md "Decorators") expands its target first, so
# stacked decorators apply innermost first, then applies its decorator to
# the result as an ordinary message send (`bind_message` finds the decorator
# among the scope's messages: a `fn [TreeBase] name(...)` imported by the
# module, or the predefined `@template`) and replaces the node with
# the answer, then walks the answer until no `decorate` remains.
#
# Arguments are FORMS, not values (D9): a pure literal argument arrives as its
# value, anything else as a TreeBase box of its tree.
#
# Pure wyrm, no host access: everything here must work in an expansion VM,
# which has no `std::io` and no other host module.

# The decorator currently being applied: [name] - the host reads it to name a
# decorator that faulted instead of answering.
_STATE := [nil]

# Expansions performed so far this call, against a runaway decorator that
# answers another application of itself.
_EXPANSIONS := [0]
_MAX_EXPANSIONS := 1000000

# Answer of _literal for an argument that is not a literal.
_NOT_LITERAL := '__not_a_literal__

fn _ex_kind(node):
    if node is pair:
        return car(node)
    if node is sym:
        return node
    return nil

fn _ex_field(node, index: int):
    cur := node
    i := 0
    while i < index:
        if not (cur is pair):
            return nil
        cur = cdr(cur)
        i = i + 1
    if not (cur is pair):
        return nil
    return car(cur)

# The elements of a list-shaped value (a pair list, native list or tuple,
# whatever the parser produced); nil is empty.
fn _ex_items(value):
    out := []
    if value is pair:
        cur := value
        while cur is pair:
            out ! append(car(cur))
            cur = cdr(cur)
    elif value is list:
        for x in value:
            out ! append(x)
    elif value is tuple:
        for x in value:
            out ! append(x)
    return out

# A pair list of `items`, ending in `tail`.
fn _ex_pairs(items, tail):
    result := tail
    i := len(items)
    while i > 0:
        i = i - 1
        result = cons(items[i], result)
    return result

# ---------------------------------------------------------------------------
# arguments: literal value, or a tree box

fn _ex_literal(arg):
    kind := _ex_kind(arg)
    if kind == 'true:
        return true
    if kind == 'false:
        return false
    if kind == 'nil:
        return nil
    if kind == 'int or kind == 'float or kind == 'str or kind == 'sym:
        return _ex_field(arg, 1)
    if kind == 'neg:
        v := _ex_literal(_ex_field(arg, 1))
        if v is int or v is float:
            return 0 - v
        return _NOT_LITERAL
    if kind == 'array or kind == 'tuple:
        vals := []
        for item in _ex_items(cdr(arg)):
            v := _ex_literal(item)
            if v == _NOT_LITERAL:
                return _NOT_LITERAL
            vals ! append(v)
        if kind == 'tuple:
            return tuple(*vals)
        return vals
    return _NOT_LITERAL

fn _ex_arg_value(arg):
    v := _ex_literal(arg)
    if v == _NOT_LITERAL:
        return tree_box(arg)
    return v

# ---------------------------------------------------------------------------
# applying one decorator

fn _ex_decorator_error(name, message):
    return error("@" + str(name) + ": " + message)

# Apply `dec` (a `$['decorator, name, args]` node) to the raw `operand` tree.
# Answers the new tree, or an error value.
fn _ex_apply(dec, operand, scope):
    name := _ex_field(dec, 1)
    args := _ex_field(dec, 2)
    _STATE[0] = name
    vals := []
    for a in _ex_items(args):
        vals ! append(_ex_arg_value(a))
    bound := bind_message(scope, tree_box(operand), name)
    if bound is error:
        return _ex_decorator_error(name,
            str(error_message(bound)) + " (the decorator's module must be imported in a form that brings its messages into scope, e.g. `import m::*`)")
    answer := bound(*vals)
    if answer is error:
        return _ex_decorator_error(name, str(error_message(answer)))
    return sexpr(answer)

# ---------------------------------------------------------------------------
# the walk

fn _ex_walk_pairs(node, scope):
    items := []
    cur := node
    while cur is pair:
        r := _walk(car(cur), scope)
        if r is error:
            return r
        items ! append(r)
        cur = cdr(cur)
    return _ex_pairs(items, cur)

# One `(decorate name target arg...)` (ast.md "Decorators"): the target is
# expanded first, so stacked decorators apply innermost first, then this
# decorator is applied to it; the answer is walked again, since it may hold
# decorators of its own. There is no position coercion: an expression in
# statement position needs no wrapper (ast.md R2).
fn _ex_decorate(node, scope):
    name := _ex_field(node, 1)
    target := _walk(_ex_field(node, 2), scope)
    if target is error:
        return target
    args := cdr(cdr(cdr(node)))
    _EXPANSIONS[0] = _EXPANSIONS[0] + 1
    if _EXPANSIONS[0] > _MAX_EXPANSIONS:
        return _ex_decorator_error(name, "expansion did not terminate")
    answer := _ex_apply($['decorator, name, args], target, scope)
    if answer is error:
        return answer
    return _walk(answer, scope)

fn _walk(node, scope):
    if node is pair:
        if car(node) == 'decorate:
            return _ex_decorate(node, scope)
        return _ex_walk_pairs(node, scope)
    if node is list:
        out := []
        for x in node:
            r := _walk(x, scope)
            if r is error:
                return r
            out ! append(r)
        return out
    if node is tuple:
        out := []
        for x in node:
            r := _walk(x, scope)
            if r is error:
                return r
            out ! append(r)
        return tuple(*out)
    return node

# Entry point called by std::expand: `tree` fully expanded, or an error value.
fn expand_tree(tree, scope):
    _EXPANSIONS[0] = 0
    return _walk(tree, scope)
