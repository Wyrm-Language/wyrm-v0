# wy/wyrm/compiler/verify.wy - epic 10 M6
#
# Wyrm port of pypoc/wypoc/compiler_bc/verify.py: structural verification
# of a finished module image. The verifier re-reads the image the way the
# VM's loader will and checks the things a lowering bug quietly gets wrong -
# a jump into the middle of an instruction, a register operand past the end
# of its frame, a call window that runs off the frame, a table index out of
# range, a referenced-name set that does not match the message identities
# the body actually reads.
#
# Deliberately structural, not semantic: it says nothing about whether the
# program is *right*, only that the image is well formed. `compile_module`
# runs it on every image it produces, so a lowering bug surfaces as an
# `error` value at compile time rather than as a crash in a VM.
#
# ---------------------------------------------------------------------------
# Deviations from verify.py, each forced by the port
#
# 1. The image is the dict module.wy assembles, not a ModuleImage object:
#    functions are long-key dicts ("name"/"params"/"nlocals"/"code_offset"/
#    "ncaptures"/"dispatch"/"uses"), the init region's frame size is
#    "init_nlocals" (same value as the header's "l"), init's own message
#    references are "module_uses" - all three non-serialized keys module.wy
#    adds for exactly this consumer (the third is "unlowered", the stub
#    report, which verify ignores) - and the globals table is the header's
#    *count* (an int), not a list, since the wire format records only how
#    many global slots exist.
#
# 2. Refusals are `error` values naming the region and word offset, where
#    verify.py raises CompileError; the message text is the same.
#
# 3. Region membership walks are linear scans over small lists where pypoc
#    uses Python sets (`referenced`, `boundaries`, a region's `uses`); no
#    corpus body is big enough for the difference to matter, and wyrm lists
#    answer `in` in O(n).

import wyrm::opcodes::*

# The first problem found is the answer; nothing keeps checking after it.
fn verify(image: dict) -> nil | error:
    regions := _regions(image)
    if regions is error:
        return regions
    for region in regions:
        e := _verify_region(image, region)
        if e is error:
            return e
    return nil

# ---------------------------------------------------------------------------
# regions

# Split the code array into the init routine and each function body. Bodies
# are laid out end to end in code-offset order, so each one runs to the
# start of the next.
fn _regions(image: dict) -> list | error:
    offsets := []
    fns := []
    for entry in image["functions"]:
        offsets ! append(entry["code_offset"])
        fns ! append(entry)
    # insertion sort by code_offset (a handful of functions per module)
    i := 1
    while i < len(offsets):
        off := offsets[i]
        entry := fns[i]
        j := i - 1
        while j >= 0:
            if offsets[j] <= off:
                break
            offsets[j + 1] = offsets[j]
            fns[j + 1] = fns[j]
            j = j - 1
        offsets[j + 1] = off
        fns[j + 1] = entry
        i = i + 1
    code_len := len(image["code"])
    regions := []
    init_end := code_len
    if len(offsets) > 0:
        init_end = offsets[0]
    regions ! append({"name": "<init>", "start": 0, "end": init_end,
                      "nlocals": image["init_nlocals"], "pframe": 0,
                      "uses": image["module_uses"]})
    k := 0
    while k < len(offsets):
        entry := fns[k]
        end := code_len
        if k + 1 < len(offsets):
            end = offsets[k + 1]
        ncaptures := entry["ncaptures"]
        if ncaptures is nil:
            ncaptures = 0
        dispatch := entry["dispatch"]
        ndispatch := 0
        if dispatch is not nil:
            ndispatch = len(dispatch)
        pframe := len(entry["params"]) + ncaptures + ndispatch
        regions ! append({"name": entry["name"], "start": offsets[k], "end": end,
                          "nlocals": entry["nlocals"], "pframe": pframe,
                          "uses": entry["uses"]})
        k = k + 1
    return regions

# ---------------------------------------------------------------------------
# per-region walk

fn _verify_region(image: dict, region: dict) -> nil | error:
    boundaries := []
    instructions := []
    offset := region["start"]
    while offset < region["end"]:
        u := unpack(image["code"], offset)
        if u is error:
            return error("verify: " + region["name"] + " at word " + str(offset) + ": " + str(u))
        nwords := u["nwords"]
        if offset + nwords > region["end"]:
            return _fail(region, offset, "instruction runs past the end of the body")
        boundaries ! append(offset)
        instructions ! append([offset, u["entry"], u["is_wide"], u["fields"], nwords])
        offset = offset + nwords
    boundaries ! append(region["end"])

    referenced := []
    for inst in instructions:
        inst_offset := inst[0]
        entry := inst[1]
        is_wide := inst[2]
        fields := inst[3]
        nwords := inst[4]
        operands := entry["operands"]
        if is_wide:
            operands = entry["wide_operands"]
        unread := _unread_operands(entry, fields)
        for label in operands:
            if label in unread:
                continue
            oslot := operands[label][0]
            kind := operands[label][1]
            raw := fields[oslot]
            if (kind == "reg") or (kind == "reg8"):
                reg := raw
                if kind == "reg8":
                    reg = from_reg8(raw)
                e := _check_register(region, inst_offset, entry, label, reg)
                if e is error:
                    return e
            elif kind == "rel":
                e2 := _check_jump(region, inst_offset, entry, raw, nwords, boundaries, oslot)
                if e2 is error:
                    return e2
            elif kind == "message":
                e3 := _check_index(region, inst_offset, entry, label, raw, image["messages"])
                if e3 is error:
                    return e3
                if not (raw in referenced):
                    referenced ! append(raw)
            elif kind == "static":
                e4 := _check_index(region, inst_offset, entry, label, raw, image["statics"])
                if e4 is error:
                    return e4
            elif kind == "symbol":
                e5 := _check_index(region, inst_offset, entry, label, raw, image["symbols"])
                if e5 is error:
                    return e5
            elif kind == "global":
                if raw >= image["globals"]:
                    return _fail(region, inst_offset, str(entry["name"]) + " " + str(label) + " is index " + str(raw) + ", but there are only " + str(image["globals"]) + " global slot(s)")
            elif kind == "function":
                e6 := _check_index(region, inst_offset, entry, label, raw, image["functions"])
                if e6 is error:
                    return e6
            elif kind == "class":
                e7 := _check_index(region, inst_offset, entry, label, raw, image["classes"])
                if e7 is error:
                    return e7
        windows := _windows(entry, fields)
        for window in windows:
            e8 := _check_window(region, inst_offset, entry, window[0], window[1])
            if e8 is error:
                return e8

    return _check_uses(image, region, referenced)

# ---------------------------------------------------------------------------
# individual checks

fn _check_register(region: dict, offset: int, entry: dict, label, reg: int) -> nil | error:
    index := reg_index(reg)
    if is_p(reg):
        if index >= region["pframe"]:
            return _fail(region, offset, str(entry["name"]) + " " + str(label) + " is P" + str(index) + ", but the P frame holds " + str(region["pframe"]) + " slot(s)")
    elif index >= region["nlocals"]:
        return _fail(region, offset, str(entry["name"]) + " " + str(label) + " is L" + str(index) + ", but the frame holds " + str(region["nlocals"]) + " slot(s)")
    return nil

fn _check_window(region: dict, offset: int, entry: dict, base: int, count: int) -> nil | error:
    if is_p(base):
        return _fail(region, offset, str(entry["name"]) + " window base is P" + str(reg_index(base)) + "; windows live in the L frame")
    if base + count > region["nlocals"]:
        return _fail(region, offset, str(entry["name"]) + " window L" + str(base) + "..L" + str(base + count - 1) + " runs past the " + str(region["nlocals"]) + "-slot frame")
    return nil

fn _check_jump(region: dict, offset: int, entry: dict, raw: int, nwords: int, boundaries: list, oslot) -> nil | error:
    bits := 16
    if oslot == "w1":
        bits = 32
    delta := _signed(raw, bits)
    target := offset + nwords + delta
    if (target < region["start"]) or (target > region["end"]):
        return _fail(region, offset, str(entry["name"]) + " jumps to word " + str(target) + ", outside the body [" + str(region["start"]) + ", " + str(region["end"]) + ")")
    if not (target in boundaries):
        return _fail(region, offset, str(entry["name"]) + " jumps to word " + str(target) + ", which is not an instruction boundary")
    return nil

fn _check_index(region: dict, offset: int, entry: dict, label, raw: int, table) -> nil | error:
    n := 0
    if table is not nil:
        n = len(table)
    if raw >= n:
        return _fail(region, offset, str(entry["name"]) + " " + str(label) + " is index " + str(raw) + ", but that table has " + str(n) + " entr(ies)")
    return nil

# The scope's `u` set is exactly the `messages` entries its code reads.
# A class's superclass and a method's dispatch types used to belong here
# too; they are global slots now, so they are not part of this set.
fn _check_uses(image: dict, region: dict, referenced: list) -> nil | error:
    for index in referenced:
        if not (index in region["uses"]):
            return _fail(region, region["start"], "references " + _message_name(image, index) + " without listing it in its referenced-name set")
    for index in region["uses"]:
        if not (index in referenced):
            return _fail(region, region["start"], "lists " + _message_name(image, index) + " in its referenced-name set but never reads it")
    return nil

fn _message_name(image: dict, index: int) -> str:
    msgs := image["messages"]
    if msgs is nil:
        return "msg#" + str(index)
    if index >= len(msgs):
        return "msg#" + str(index)
    return "msg#" + str(index) + " (" + _join_path(msgs[index]["_path"]) + ")"

fn _join_path(parts) -> str:
    out := ""
    i := 0
    n := len(parts)
    while i < n:
        if i > 0:
            out = out + "::"
        out = out + str(parts[i])
        i = i + 1
    return out

fn _fail(region: dict, offset: int, message: str) -> error:
    return error("verify: " + region["name"] + " at word " + str(offset) + ": " + message)

# ---------------------------------------------------------------------------
# register windows

# Operand labels this instruction does not actually read: an empty window
# has a base register the VM never touches - `return count=0` and
# `dict dst, base, 0` are both meaningful with any base at all, and the
# compiler naturally leaves it pointing one past the last live slot.
# Checking it would reject correct code, so it is skipped here for the same
# reason the disassembler leaves it out of `return count=0`.
fn _unread_operands(entry: dict, fields: dict) -> list:
    if fields["f"] != 0:
        return []
    name := entry["name"]
    if (name == "return") or (name == "yield"):
        return ["base"]
    if (name == "tuple") or (name == "list") or (name == "plist") or (name == "dict"):
        return ["base"]
    if name == "closure":
        return ["caps"]
    if name == "unpack":
        return ["dst"]
    return []

# The `(base, count)` runs of frame slots an instruction touches.
fn _windows(entry: dict, fields: dict) -> list:
    name := entry["name"]
    a0 := fields["a0"]
    a1 := fields["a1"]
    a2 := fields["a2"]
    f := fields["f"]
    if name == "return":
        if f != 0:
            return [[a0, f]]
        return []
    if name == "call":
        # callee plus arguments going in, results coming back
        return [[a0, f + 1], [a0, _max1(a1)]]
    if name == "super":
        # no callee slot: the dispatch is already in progress, so the
        # window is the arguments alone (spec 3.3)
        return [[a0, _max1(f)], [a0, _max1(a1)]]
    if name == "call_va":
        return [[a0, 3], [a0, _max1(a1)]]
    if name == "msg":
        return [[a0, f + 1], [a0, _max1(a2)]]
    if name == "msg_va":
        return [[a0, 3], [a0, _max1(a2)]]
    if name == "yield":
        return [[a0, _max1(f)]]
    if (name == "tuple") or (name == "list") or (name == "plist"):
        return [[a1, f]]
    if name == "dict":
        return [[a1, 2 * f]]
    if name == "unpack":
        return [[a0, f]]
    if name == "closure":
        if f != 0:
            return [[a2, f]]
        return []
    return []

fn _max1(value: int) -> int:
    if value < 1:
        return 1
    return value

fn _signed(raw: int, bits: int) -> int:
    sign := 1
    shift := bits - 1
    while shift > 0:
        sign = sign * 2
        shift = shift - 1
    return (raw & (sign - 1)) - (raw & sign)
