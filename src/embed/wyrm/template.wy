# `@template` - marks a definition written to be quoted (project design syntax.md
# G7): a tree whose code may never run, read through `name::$ast`.
#
#     import wyrm::template::*
#
#     @template
#     fn $tmpl(e):
#         this ! peek(0)
#
# The decorator answers the definition wrapped in an annotation,
# `(annotate template (true) <definition>)`, for the compiler to read. A
# compiler lowers the definition as usual, and if lowering fails it emits a
# trap in its place instead of an error (this compiler: a trapping stub
# with the recorded reason). `name::$ast` is the tree without the
# annotation. The same source as wypoc's corelib/wyrm/template.wy.

fn [TreeBase] template():
    return $['annotate, 'template, $['true], sexpr(this)]
