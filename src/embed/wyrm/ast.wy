# AST Types
import std::pairs::*

# -------------------------------
# S-Expression AST manipulation
# -------------------------------

N_AUTO_TYPE := $['type, 'auto]

fn n_type(typename: sym | nil) -> pair:
    if typename is nil:
        return $['type, 'auto]
    return $['type, typename]

fn n_define(variable: sym, type_expr: pair | nil, initial: pair | nil) -> pair:
    return $['define, variable, type_expr, initial]

fn n_set(target: sym | pair, value: pair) -> pair:
    return $['set, target, value]

fn n_set_values(targets: pair, value: pair) -> pair:
    return $['set_values, targets, value]

# ---------------------------------------------------------------------------
# Reading trees. The shapes are the canonical ones: the project's
# design/ast.md, and its conformance/ast/schema.sexp as data. Names are bare
# symbols, lists are pair lists, and every other node is headed by its kind.

# The elements of a pair list as a native list.
fn s_items(field) -> list:
    out := []
    cur := field
    while cur is pair:
        out ! append(car(cur))
        cur = cdr(cur)
    return out

# The kind of a node; a bare symbol is a name reference.
fn s_kind(node):
    if node is pair:
        return car(node)
    if node is sym:
        return 'name
    return nil

# The identifier a name reference spells.
fn s_get_name(literal) -> sym:
    if literal is sym:
        return literal
    return error("name expected")

# `~x`: (~ x).
fn s_unary_target(e):
    return cadr(e)

fn s_is_drop(node) -> bool:
    return (node is pair) and (car(node) == '~)

# `lhs OP rhs`: (OP lhs rhs).
fn s_binop_op(e):
    return car(e)

fn s_binop_lhs(e):
    return cadr(e)

fn s_binop_rhs(e):
    return caddr(e)

# A call: (apply callee arg...).
fn s_call_target(call):
    return cadr(call)

fn s_call_args(call) -> list:
    return s_items(cddr(call))

# `$[a, b, ...]`: (list a b ...).
fn s_is_pairlist(node) -> bool:
    return (node is pair) and (car(node) == 'list)

fn s_pairlist_items(node) -> list:
    return s_items(cdr(node))

# (fn_def name dispatch params ret body)
_FN_DEF_BODY := 5

fn s_fn_body(e):
    return car(list_tail(sexpr(e), _FN_DEF_BODY))

# A body's statements, as a native list: a body is one form or (do s...)
# (ast.md R2).
fn s_body_items(body) -> list:
    if body is nil:
        return []
    if (body is pair) and (car(body) == 'do):
        return s_items(cdr(body))
    return [body]

# ---------------------------------------------------------------------------
# Building trees. Lists of nodes are pair lists.

# The literal nil (ast.md R3).
NIL_EXPR := $['nil]

fn mk_sym(s: sym) -> pair:
    return $['sym, s]

fn mk_str(s: str) -> pair:
    return $['str, s]

fn mk_type(s: sym) -> pair:
    return $['type, s]

# `lhs op rhs`
fn mk_binop(lhs, op: sym, rhs):
    return $[op, lhs, rhs]

# A reference to the identifier `name`.
fn mk_name(name: sym):
    return name

# A call of the callee expression `target` on the pair list `args`.
fn mk_call_expr(target, args):
    return cons('apply, cons(target, args))

fn mk_call(func: sym, args) -> pair:
    return mk_call_expr(func, args)

# A body of the pair list of statements `stmts`: one form, or (do s...)
# for more; nil for none (ast.md R2).
fn _s_body(stmts):
    if stmts is nil:
        return nil
    if cdr(stmts) is nil:
        return car(stmts)
    return cons('do, stmts)

# `do:` over the pair list of statements `stmts`.
fn mk_do(stmts):
    return cons('do, stmts)

# `if cond: then else: else`, each branch a pair list of statements (the
# else one may be nil): (cond (test body) (else body)).
fn mk_if(cond, then_stmts, else_stmts):
    orelse := _s_body(else_stmts)
    if orelse is nil:
        return $['cond, $[cond, _s_body(then_stmts)]]
    return $['cond, $[cond, _s_body(then_stmts)], $['else, orelse]]

# `lhs is <typename>`
fn mk_is_type(lhs, typename: sym):
    return $['is, lhs, mk_type(typename)]

# `obj[idx]`
fn mk_index(obj, idx):
    return $['index, obj, idx]

# `this ! name()`: a send of the message `name` to `this`, no arguments.
fn mk_this_send(name: sym):
    return $['apply, $['bind_msg, 'this, name]]

# The identifier-name positions of these nodes are not references, so a
# template substitution must leave them alone (the port's names are bare
# symbols: `tok.kind` must not lose its `kind` when a hole is named `kind`).
# attr and bind_msg fields name members.
fn _s_subst(node, hole, repl):
    if node is sym:
        if node == hole:
            return repl
        return node
    if not (node is pair):
        return node
    head := car(node)
    if head == 'sym or head == 'str or head == 'int or head == 'float or head == 'char or head == 'type:
        return node
    if head == 'attr:
        # (attr obj name)
        return $['attr, _s_subst(cadr(node), hole, repl), caddr(node)]
    if head == 'bind_msg:
        # (bind_msg receiver selector)
        return $['bind_msg, _s_subst(cadr(node), hole, repl), caddr(node)]
    # Any other pair - a node or a list of nodes/names alike; a kind symbol
    # never equals a hole, so every element (the head too) is substituted.
    return _s_subst_tail(node, hole, repl)

# The rest of a node's fields (or a list of nodes): each element substituted,
# cells rebuilt, without treating a cell's first element as a node head.
fn _s_subst_tail(cells, hole, repl):
    if cells is pair:
        return cons(_s_subst(car(cells), hole, repl), _s_subst_tail(cdr(cells), hole, repl))
    return _s_subst(cells, hole, repl)

# `tree` with every reference to `hole` replaced by `repl`.
fn s_substitute(tree, hole, repl):
    return _s_subst(tree, hole, repl)

# Given a template function, substitute the given arguments into its body
# and answer the statements as a `do`.
fn mk_expand_n(tmpl_ast, *subs) -> pair:
    body := s_fn_body(sexpr(tmpl_ast))
    out := []
    for stmt in s_body_items(body):
        expanded := stmt
        for sub in subs:
            hole := try (car(sub) catch sub[0])
            repl := try (cdr(sub) catch sub[1])
            expanded = s_substitute(expanded, hole, repl)
        out ! append(expanded)
    return mk_do(chain(out))

# @brief Build expansion of template function AST (1 type)
fn mk_expand(tmpl_ast, name, replace) -> pair:
    return mk_expand_n(tmpl_ast, pair(name, replace))
