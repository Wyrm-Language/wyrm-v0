# Decoding of raw token text into native values.

import std::ctype::*

# expect - our sym(str) should generate proper symbol
fn decode_sym(text: str) -> sym:
    return sym(text)

# An integer token's value: decimal, `0x` hex or `0b` binary, with `_`
# separators (tokenizer.wy's integer literal). Parsed digit by digit: the
# native int() is strtol-based, so it takes neither `0b` nor `_`, and it
# reads a leading 0 as octal.
fn decode_int(text: str) -> int:
    n := len(text)
    base := 10
    i := 0
    if (n > 2) and (text[0] == 48):
        if (text[1] == \x) or (text[1] == \X):
            base = 16
            i = 2
        elif (text[1] == \b) or (text[1] == \B):
            base = 2
            i = 2
    value := 0
    while i < n:
        d := _digit_value(text[i])
        if d >= 0:
            value = value * base + d
        i = i + 1
    return value

# The value of the digit character `c` (0-9, a-f, A-F), or -1 (`_`).
fn _digit_value(c: int) -> int:
    if (c >= 48) and (c <= 57):
        return c - 48
    if (c >= 97) and (c <= 102):
        return c - 87
    if (c >= 65) and (c <= 70):
        return c - 55
    return -1

# A float token's value. The grammar allows `_` separators in the digits
# (tokenizer.wy's float_literal), which the native float() does not take.
fn decode_float(text: str) -> float:
    digits := ""
    n := len(text)
    run_start := 0
    i := 0
    while i < n:
        if text[i] == 95:
            digits = digits + (text ! substr(run_start, i - run_start))
            run_start = i + 1
        i = i + 1
    return float(digits + (text ! substr(run_start, n - run_start)))

fn _char_at(body: str, idx: int) -> int | sym:
    return body[idx] catch 'EOF

# `count` hex digits starting at `start` are all present and valid -
# doc/language-spec.md's `\x<<HexLiteral>>` / `\u<<Literal>>`.
fn _valid_hex_run(body: str, start: int, count: int) -> bool:
    j := 0
    while j < count:
        c := _char_at(body, start + j)
        if c == 'EOF or not is_hexdigit(c):
            return false
        j = j + 1
    return true

# UTF-8 encode a single codepoint as a str, the only way to turn a
# computed int codepoint into wyrm text (no chr()-style builtin exists).
fn _encode_codepoint(cp: int) -> str:
    if cp < 0x80:
        b := bytes(1)
        b!pack_u8(0, cp)
        return b!to_str()
    elif cp < 0x800:
        b := bytes(2)
        b!pack_u8(0, 0xC0 | (cp >> 6))
        b!pack_u8(1, 0x80 | (cp & 0x3F))
        return b!to_str()
    elif cp < 0x10000:
        b := bytes(3)
        b!pack_u8(0, 0xE0 | (cp >> 12))
        b!pack_u8(1, 0x80 | ((cp >> 6) & 0x3F))
        b!pack_u8(2, 0x80 | (cp & 0x3F))
        return b!to_str()
    else:
        b := bytes(4)
        b!pack_u8(0, 0xF0 | (cp >> 18))
        b!pack_u8(1, 0x80 | ((cp >> 12) & 0x3F))
        b!pack_u8(2, 0x80 | ((cp >> 6) & 0x3F))
        b!pack_u8(3, 0x80 | (cp & 0x3F))
        return b!to_str()

fn decode_str(text: str) -> str:
    body := text
    n := len(body)
    out := ""
    run_start := 0
    i := 0
    while i < n:
        if _char_at(body, i) != \\:
            i = i + 1
        else:
            if run_start < i:
                out = out + (body ! substr(run_start, i - run_start))
            next_c := _char_at(body, i + 1)
            if next_c == \return:
                skip := 2
                if _char_at(body, i + 2) == \newline:
                    skip = 3
                i = i + skip
            elif next_c == \newline:
                i = i + 2
            elif next_c == \r:
                out = out + "\r"
                i = i + 2
            elif next_c == \t:
                out = out + "\t"
                i = i + 2
            elif next_c == \n:
                out = out + "\n"
                i = i + 2
            elif next_c == \v:
                out = out + "\v"
                i = i + 2
            elif next_c == \b:
                out = out + "\b"
                i = i + 2
            elif next_c == \x:
                if _valid_hex_run(body, i + 2, 2):
                    code := int("0x" + (body ! substr(i + 2, 2)))
                    out = out + _encode_codepoint(code)
                    i = i + 4
                else:
                    out = out + (body ! substr(i, 1))
                    i = i + 1
            elif next_c == \u:
                if _valid_hex_run(body, i + 2, 4):
                    code := int("0x" + (body ! substr(i + 2, 4)))
                    out = out + _encode_codepoint(code)
                    i = i + 6
                else:
                    out = out + (body ! substr(i, 1))
                    i = i + 1
            else:
                out = out + (body ! substr(i, 1))
                i = i + 1
            run_start = i
    if run_start < n:
        out = out + (body ! substr(run_start, n - run_start))
    return out
