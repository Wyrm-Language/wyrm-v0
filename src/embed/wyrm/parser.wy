import wyrm::tokenizer::*
import wyrm::decode::*
import wyrm::ast
import std::io::*

import wyrm::_dsl::*

#>  # Wyrm Language Grammar
#>
#>  This grammar file is generated directly from the packrate/PEG style parser
#>  and lexxer included in the wyrm source tree. As wyrm is still at prototype
#>  stage, the grammar is expected to drift. However, at this point, the majority
#>  of primitives with basic execution should be considered stable.
#>
# Lexical Grammar sections
#>>include:tokenizer.wy

class Parser:
    slot buffer: str
    slot tokens: list
    slot pos: int
    slot cache_hits: dict
    slot cache_misses: list

    fn init(buffer: str):
        this.buffer = buffer
        this.tokens = TokenStream(buffer) ! scan()
        this.pos = 0
        this.cache_hits = {}
        this.cache_misses = []

    fn peek(n: int) -> Token:
        idx := this.pos + n
        last := len(this.tokens) - 1
        if idx > last:
            idx = last
        return this.tokens[idx]

    fn advance() -> Token:
        t := this ! peek(0)
        this.pos = this.pos + 1
        return t

    fn mark() -> int:
        return this.pos

    fn reset(mark: int):
        this.pos = mark

    fn _cache_key(id: int, pos: int) -> str:
        return str(id) + ":" + str(pos)

    fn get_cache(id: int, pos: int):
        key := this ! _cache_key(id, pos)
        if key in this.cache_hits:
            entry := this.cache_hits[key]
            this.pos = entry[1]
            return entry[0]
        if key in this.cache_misses:
            return 'NO_MATCH
        return 'NO_CACHE

    fn put_hit(id: int, pos: int, end_pos: int, result):
        key := this ! _cache_key(id, pos)
        this.cache_hits[key] = [result, end_pos]

    fn put_miss(id: int, pos: int):
        key := this ! _cache_key(id, pos)
        this.cache_misses ! append(key)

    fn clear():
        this.cache_hits = {}
        this.cache_misses = []

fn _as_list(expr):
    return $[expr]

#>  ```ebnf
#>    bool_literal    ::= "true" | "false" ;
#>  ```
#>
#>  _Example_: `true`, `false`
#>
fn [Parser] bool_literal():
    @accept apply_if(_as_list, $[value('true, 'TOK_KW_TRUE) | value('false, 'TOK_KW_FALSE)])

fn [Parser] nil_literal():
    @accept apply_if(_as_list, value('nil, 'TOK_KW_NIL))


fn [Parser] xid() -> sym:
    v := @accept 'TOK_XID
    if is_match(v):
        return sym(v!get_text(this.buffer))
    else:
        return v

fn _mk_qualified_name(segs):
    if cdr(segs) == nil:
        return sym(car(segs))
    return cons(sym("::"), segs)

# Qualified name; used for an expression of a fully qualified name
fn [Parser] qualified_name():
    @accept apply_if(_mk_qualified_name, cons(xid, many($[~'TOK_SCOPE, xid])))

# symbol_literal
fn [Parser] symbol_literal():
    @accept apply_if(_mk_sym, text('TOK_LITERAL_SYM))

fn _mk_sym(text):
    return $['sym, decode_sym(text)]

# string literal
fn [Parser] string_literal():
    @accept apply_if(_mk_string, text('TOK_STR))

fn _mk_string(text):
    return $['str, decode_str(text)]

# integer literal
fn _mk_int(text):
    return $['int, decode_int(text)]

# floating point literal
fn _mk_float(text):
    return $['float, decode_float(text)]

fn [Parser] number_literal():
    @accept $[apply_if(_mk_int, text('TOK_LITERAL_INT)) | apply_if(_mk_float, text('TOK_LITERAL_FLOAT))]

#>  ```ebnf
#>    char_literal    ::= "\" , ( ( any_char - ( control_char | " " ) ) | identifier ) ;
#>  ```
#>
#>  _Example_: `\a`, `\newline`
#>
fn [Parser] char_literal():
    @accept 'TOK_LITERAL_CHAR

# -----------------------------------------------------------------------------
#>  ## Program Structure
# -----------------------------------------------------------------------------
#>
#>  ```ebnf
#>  program ::= { stmt_sep } , [ stmt_list ], { stmt_sep }, tok_end ;
#>  ```
#>
#>  _S-Expression_
#>
#> `cons('module, stmt_list)` - given a stmt_list present
#> `(module)` - given stmt_list not present
#>

fn _mk_module(expr):
    cons('module, expr)

fn [Parser] program():
    @accept apply_if(_mk_module, ~many(stmt_sep), opt(stmt_list), ~expect("statement end", 'TOK_END))



# -----------------------------------------------------------------------------
#>  # Blocks and statements
# -----------------------------------------------------------------------------
#>
#> Blocks and Clause Bodies provide means for statements to have their own
#> sublist of statements. `stmt_sep` provides the various means of terminating
#> a statement. Statement grammars do not accept the terminator - that is
#> handled at this level.
#>
#>
#>  ```ebnf
#>  stmt_list ::= stmt , { stmt_sep , { stmt_sep } , stmt } , { stmt_sep } ;
#>  stmt_sep ::= NEWLINE | ";" | STMT_END ;
#>
#>  block           ::= indent_block | line_block | brace_block ;
#>  indent_block    ::= ":" , NEWLINE , INDENT , stmt_list , DEDENT ;
#>  line_block      ::= ":" , stmt ;
#>  brace_block     ::= "{" , stmt_list , "}" ;
#>  clause_body     ::= line_block , ( ";" , [ NEWLINE ] | NEWLINE )
#>                     | ( indent_block | brace_block ) , [ NEWLINE | STMT_END ] ;
#>  ```
#>
#> `clause_body` is the block before an `elif` or `else` clause, which
#> extends an otherwise complete statement. It takes the separator between
#> the block and the clause.
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  stmt          ; a block of one statement is that statement
#>  (cons 'do stmt_list) ; stmt_list is placed in 'do form
#>  ```
#>
#> `stmt_list` is a list of statements as collected in order

fn [Parser] stmt_list():
    @accept $[cons(stmt, many($[~stmt_sep, ~many(stmt_sep), stmt])), ~many(stmt_sep)]

fn [Parser] stmt_sep():
    @accept $['TOK_NEWLINE | 'TOK_SEMICOLON | 'TOK_STMT_END]

fn [Parser] indent_block():
    @accept $[~'TOK_COLON, ~'TOK_NEWLINE, ~'TOK_INDENT, stmt_list, ~'TOK_DEDENT]

fn [Parser] line_block():
    @accept $[~'TOK_COLON, apply_if(_as_list, stmt)]

fn [Parser] brace_block():
    @accept $[~'TOK_LBRACE, stmt_list, ~'TOK_RBRACE]

fn [Parser] raw_block():
    @accept $[indent_block | line_block | brace_block]

fn _multi_block(expr):
    if len(expr) < 2:
        car(expr)
    else:
        cons('do, expr)

fn [Parser] block():
    @accept apply_if(_multi_block, raw_block)

fn [Parser] clause_body():
    @accept $[
        $[apply_if(_multi_block, line_block),
          ~$[$['TOK_SEMICOLON, opt('TOK_NEWLINE)] | 'TOK_NEWLINE]]
        | $[apply_if(_multi_block, $[indent_block | brace_block]),
            ~opt($['TOK_NEWLINE | 'TOK_STMT_END])]
        ]

#>  ### Statements
#>
#>  Statements include all expressions with the addition of statements that
#>  introduce name definitions or scope operations.
#>
#>  ```ebnf
#>    stmt            ::= { decorator } ,
#>                         ( var_stmt
#>                         | assignment_stmt
#>                         | expression
#>                         | static_stmt
#>                         | import_stmt
#>                         | defer_stmt
#>                         | fn_def
#>                         | co_def
#>                         | class_def
#>                         | slot_def ) ;
#>  ```
#>
#>  _S-Expression_
#>
#> `stmt` expansion is specified by each stmt type.
#>

fn [Parser] expect_stmt_sep() -> bool:
    @accept $[expect("statement end", stmt_sep)]

fn $_mk_stmt(expr):
    decs := car(expr)
    stmt := cadr(expr)
    # The first decorator is the outermost: (decorate name target arg...)
    for d in reverse(decs):
        stmt = cons('decorate, cons(car(d), cons(stmt, cadr(d))))
    return stmt

fn [Parser] stmt():
    r := @accept apply_if($_mk_stmt,
        many(decorator),
        $[ var_stmt
         | assignment_stmt
         | expression
         | static_stmt
         | import_stmt
         | defer_stmt
         | fn_def
         | co_def
         | class_def
         | slot_def
        ])
    # A fully accepted statement is a commit point: nothing left
    # uncommitted can backtrack across it, so the packrat cache built
    # up while parsing it (see _dsl.wy's accept/get_cache/put_hit/
    # put_miss) can be dropped.
    if r != 'NO_MATCH and r is not error:
        this ! clear()
    r

fn $_mk_decorator(expr):
    name := car(expr)
    args := cadr(expr)
    return $[name, args]

#>  #### Decorators
#>
#>  Decorators provide macros to a statement line. Example:
#>
#>    - `@make_cached fn a_function() {`
#>    - `@accept dsl_language_statement`
#>
#>  ```ebnf
#>    decorator       ::= "@" , identifier , [ "(" , [ arg_list ] , ")" ] ;
#>  ```
fn [Parser] decorator():
    @accept apply_if($_mk_decorator,
        ~'TOK_AT, xid,
        opt($[~'TOK_LPAREN, opt(arg_list), ~'TOK_RPAREN]),
        ~opt('TOK_NEWLINE))

fn $_mk_defer(expr):
    on_type := car(expr)
    body := cadr(expr)
    if on_type == nil:
        return $['defer, body]
    return $['defer_on, on_type, body]

#>  ```ebnf
#>    defer_stmt      ::= "defer" , [ "on" , type_constraint ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  v := resource()
#>  defer:
#>      v ! release()
#>
#>  v := resource()
#>  defer on error:        # runs only if the calling block force-returned an error
#>      v ! release()
#>  ```
#>
fn [Parser] defer_stmt():
    @accept apply_if($_mk_defer, ~'TOK_KW_DEFER, opt($[~"on", type_expression]), block)

#>  ```ebnf
#>    if_stmt         ::= "if" , expression ,
#>                         { clause_body , "elif" , expression } ,
#>                         [ clause_body , "else" ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  if condition:
#>      statements
#>  elif condition_2:
#>      statements
#>  else:
#>      statements
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (cond (condition block) (condition_2 block) ... (else block)) ; a clause per if/elif
#>  (cond (a x))                                                  ; if a: x
#>  (cond (a x) (else y))                                         ; if a: x; else: y
#>  ```
#>

fn [Parser] if_stmt():
    @accept apply_if($_mk_if,
        ~'TOK_KW_IF, expression,
        many($[clause_body, ~'TOK_KW_ELIF, expression]),
        opt($[clause_body, ~'TOK_KW_ELSE]),
        block)

fn $_mk_if(expr):
    test := car(expr)
    clauses := nil
    for elif_clause in cadr(expr):
        clauses = cons($[test, car(elif_clause)], clauses)
        test = cadr(elif_clause)
    body := caddr(expr)
    last_block := car(cdddr(expr))
    if body == nil:
        clauses = cons($[test, last_block], clauses)
    else:
        clauses = cons($[test, body], clauses)
        clauses = cons($['else, last_block], clauses)
    return cons('cond, reverse(clauses))

fn $_mk_while(expr):
    return $['while, car(expr), cadr(expr)]

#>  ```ebnf
#>    while_stmt      ::= "while" , expression , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  while condition:
#>      statement
#>      if condition_2:
#>          break
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (while condition block)
#>  ```
#>
fn [Parser] while_stmt():
    @accept apply_if($_mk_while, ~'TOK_KW_WHILE, expression, block)

# expr is: name, iterable, body_before_else | nil, last_block
fn $_mk_for(expr):
    varname := car(expr)
    iterable := cadr(expr)
    body := caddr(expr)
    last_block := car(cdddr(expr))
    if body == nil:
        return $['for, varname, iterable, nil, last_block]
    return $['for, varname, iterable, last_block, body]

#>  ```ebnf
#>    for_stmt        ::= "for" , identifier , "in" , expression ,
#>                         [ clause_body , "else" ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  for name in iterable:
#>      statement
#>      if condition:
#>          break
#>  else:
#>      statement_if_no_break
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (for name iterable else_block block) ; else_block is () without an else
#>  ```
#>
fn [Parser] for_stmt():
    @accept apply_if($_mk_for,
        ~'TOK_KW_FOR, xid, ~'TOK_KW_IN, expression,
        opt($[clause_body, ~'TOK_KW_ELSE]),
        block)

fn $_mk_return(expr):
    if expr == nil:
        return $['return]
    return $['return, expr]

#>  ```ebnf
#>    return_stmt     ::= "return" , [ expression ] ;
#>  ```
fn [Parser] return_stmt():
    @accept apply_if($_mk_return, ~'TOK_KW_RETURN, opt(expression))

fn $_mk_break(expr):
    if expr == nil:
        return $['break]
    return $['break, expr]

fn $_mk_yield_from(expr):
    return $['yield_from, expr]

fn $_mk_yield(expr):
    if expr == nil:
        return $['yield]
    return $['yield, expr]

#>  ```ebnf
#>    yield_stmt      ::= "yield" , "from" , expression
#>                       | "yield" , [ expression ] ;
#>  ```
fn [Parser] yield_stmt():
    @accept $[
        apply_if($_mk_yield_from, ~'TOK_KW_YIELD, ~'TOK_KW_FROM, expression)
        | apply_if($_mk_yield, ~'TOK_KW_YIELD, opt(expression))
    ]

#>  ```ebnf
#>    break_stmt      ::= "break" , [ expression ] ;
#>  ```
fn [Parser] break_stmt():
    @accept apply_if($_mk_break, ~'TOK_KW_BREAK, opt(expression))

#>  ```ebnf
#>    continue_stmt   ::= "continue" ;
#>  ```
fn [Parser] continue_stmt():
    @accept apply_if(_as_list, value('continue, 'TOK_KW_CONTINUE))

#>  ```ebnf
#>    pass_stmt       ::= "pass" ;
#>  ```
fn [Parser] pass_stmt():
    @accept apply_if(_as_list, value('pass, 'TOK_KW_PASS))


#>  ```ebnf
#>    var_stmt        ::= "var" , var_target , { "," , var_target } , [ "=" , tuple_expression ] ;
#>    var_target      ::= identifier , [ ":" , type_expression ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  var foo: int = 5           # canonical declaration with type constraint
#>  var foo = 5                # declaration with inferred type
#>  var x: int, y: int = 6, 5  # multiple names, bound from a tuple init
#>  foo := 5                   # shorthand for the line above
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (define var_target type_expression expression) ; for 1 binding
#>  (define_values ((var_0 type_0)(var_1 type_1)) expression) ; for n binding
#>  ```
#>
fn [Parser] var_stmt():
    @accept apply_if($_mk_define_var,
        ~'TOK_KW_VAR,
        cons(var_target, many($[~'TOK_COMMA, var_target])),
        opt($[~'TOK_EQUAL, tuple_expression]))

fn [Parser] var_target():
    @accept $[xid, opt($[~'TOK_COLON, type_expression])]

# var_target's type_expr is already a finished type node (or nil if
# omitted) - not the raw type_atom list _mk_type_expression reduces.
fn _mk_type_or_auto(type_expr):
    if type_expr == nil:
        return $['type, 'auto]
    return type_expr

fn _build_define(pairs, init):
    if cdr(pairs) == nil:
        p := car(pairs)
        return $['define, sym(car(p)), _mk_type_or_auto(cadr(p)), init]
    typed := nil
    for p in pairs:
        typed = cons($[car(p), _mk_type_or_auto(cadr(p))], typed)
    return $['define_values, reverse(typed), init]

fn $_mk_define_var(expr):
    targets := car(expr)
    init := cadr(expr)
    return _build_define(targets, init)

fn $_mk_assign(expr):
    targets := car(expr)
    op := cadr(expr)
    value := caddr(expr)
    if op == 'assign_bind:
        pairs := nil
        for t in targets:
            pairs = cons($[t, nil], pairs)
        return _build_define(reverse(pairs), value)
    if op == 'assign_qeq:
        if cdr(targets) != nil:
            return error("?= only supports a single assignment target")
        return $['if_set, car(targets), value]
    # single value
    if cdr(targets) is nil:
        return n_set(car(targets), value)
    # multiple values
    return $['set_values, targets, value]

#>  ```ebnf
#>    assignment_stmt ::= target , { "," , target } , "=" , tuple_expression
#>                       | target , "?=" , tuple_expression ;
#>  ```
#>
#>  _Example_: `a, b = b, a` (swap; both names must already be declared)
#>
#>  _Example_: `k ?= 4`
#>
#>  ```scheme
#>  (set var value) ; set var to value
#>  (set_values (var1 var2) value) ; set multiple values
#>  ```
#>
fn [Parser] assignment_stmt():
    @accept apply_if($_mk_assign,
        cons(target, many($[~'TOK_COMMA, target])),
        assign_op,
        tuple_expression)

# Split a pair list into (all-but-last, last)
fn _split_last(lst):
    if lst is not pair:
        return error("bad construction")
    if cdr(lst) == nil:
        return $[nil, car(lst)]
    rest := _split_last(cdr(lst))
    return $[cons(car(lst), car(rest)), cadr(rest)]

fn $_mk_target_base(expr):
    if expr is not pair:
        return expr
    parts := _split_last(expr)
    butlast := car(parts)
    last := cadr(parts)
    if car(last) != 'attr_op:
        return expr
    base := butlast
    if cdr(base) == nil:
        base = car(base)
    return $['attr, base, cadr(last)]

fn $_mk_target(expr):
    base := car(expr)
    indices := cadr(expr)
    if indices == nil:
        return base
    return $['target, base, indices]

#>  ```ebnf
#>    target          ::= ( identifier | postfix_expr , "." , identifier ) , { "[" , expression , "]" } ;
#>  ```
#>
fn [Parser] target():
    @accept apply_if($_mk_target,
        apply_if($_mk_target_base, postfix_expr),
        many($[~'TOK_LBRACKET, expression, ~'TOK_RBRACKET]))

#>  ```ebnf
#>    assign_op       ::= "=" | "?=" | ":=" ;
#>  ```
fn [Parser] assign_op():
    @accept $[ value('assign, 'TOK_EQUAL) | value('assign_qeq, 'TOK_QEQ) | value('assign_bind, 'TOK_BIND) ]

fn $_mk_static(expr):
    name := car(expr)
    type_c := cadr(expr)
    init := caddr(expr)
    return $['static, name, _mk_type_or_auto(type_c), init]

#>  ```ebnf
#>    static_stmt     ::= "static" , identifier , [ ":" , type_constraint ] , [ "=" , expression ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  fn call_count():
#>      static foo: int = 0
#>      foo = foo + 1
#>      return foo
#>  ```
#>
fn [Parser] static_stmt():
    @accept apply_if($_mk_static,
        ~'TOK_KW_STATIC, xid,
        opt($[~'TOK_COLON, type_expression]),
        opt($[~'TOK_EQUAL, expression]))

#------------------------------------------------------------------------------
#>  ## Type Expression
#------------------------------------------------------------------------------

#>
#>  ```ebnf
#>    type_atom       ::= qualified_name | "nil" ;
#>    type_constraint ::= type_atom , { "|" , type_atom } ;
#>  ```

fn [Parser] type_atom():
    @accept $[ $[push('type), qualified_name]
             | $[push('type), value('nil, 'TOK_KW_NIL)]
             ]

fn [Parser] type_expression():
    @accept apply_if(_mk_type_expression, cons(type_atom, many($[~'TOK_OR, type_atom])))

fn _mk_type_expression(type_expr):
    if type_expr == nil:
        return $['type, 'auto]
    members := nil
    for atom in type_expr:
        members = cons(cadr(atom), members)
    return cons('type, reverse(members))

#------------------------------------------------------------------------------
#>  ## Modules and Imports
#------------------------------------------------------------------------------

fn _mk_import(expr):
    is_static := car(expr)
    body := cadr(expr)
    if is_static:
        cons('import_static, body)
    else:
        cons('import, body)

#>  ```ebnf
#>      import_stmt     ::= "import" , [ "static" ] , import_body ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  import mod::baz::bar
#>  import mod::baz as bt
#>  import std::io::(File, StreamReader, StreamWriter)
#>  import std::io::* except (File, StreamReader)
#>  import static std::io
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (import path spec)        ; spec is optional: at most one of the forms below
#>  (import_static path spec) ; the same, for `import static`
#>
#>  (import (:: mod baz bar))                       ; import mod::baz::bar
#>  (import (:: mod baz) (as bt))                   ; import mod::baz as bt
#>  (import (:: std io) (items (item File ()) ...)) ; import std::io::(File, ...)
#>  (import (:: std io) (all))                      ; import std::io::*
#>  (import (:: std io) (all File StreamReader))    ; ... except (File, StreamReader)
#>  (import std)                                    ; import std - no :: form required with single element
#>  (import_static (:: std io))                     ; import static std::io
#>  ```
#>
fn [Parser] import_stmt():
    @accept apply_if(_mk_import, $[~'TOK_KW_IMPORT, bool('TOK_KW_STATIC), import_body])


fn $_mk_import_all_except(expr):
    path := car(expr)
    ex := cadr(expr)
    return $[path, cons('all, ex)]

fn $_mk_import_all(path):
    return $[path, $['all]]

fn $_mk_import_items(expr):
    path := car(expr)
    items := cadr(expr)
    return $[path, cons('items, items)]

fn $_mk_import_as(expr):
    path := car(expr)
    alias := cadr(expr)
    return $[path, $['as, alias]]

#>  ```ebnf
#>      import_body     ::= qualified_name , "::" , "*" , "except" , except_names
#>                       | qualified_name , "::" , "*"
#>                       | qualified_name , "::" , "(" , import_item , { "," , import_item } , ")"
#>                       | qualified_name , [ "as" , identifier ] ;
#>  ```
fn [Parser] import_body():
    @accept $[
        apply_if($_mk_import_all_except, qualified_name, ~'TOK_SCOPE, ~'TOK_MUL, ~"except", except_names)
      | apply_if($_mk_import_all, qualified_name, ~'TOK_SCOPE, ~'TOK_MUL)
      | apply_if($_mk_import_items, qualified_name, ~'TOK_SCOPE, ~'TOK_LPAREN, import_item_list, ~'TOK_RPAREN)
      | apply_if($_mk_import_as, qualified_name, ~"as", xid)
      | apply_if(_as_list, qualified_name)
    ]


fn $_mk_import_item(expr):
    name := car(expr)
    alias := cadr(expr)
    return $['item, name, alias]

#>  ```ebnf
#>    import_item     ::= identifier , [ "as" , identifier ] ;
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (item name alias) ; alias is () without `as`
#>
#   (item open o) ; open as o
#>  ```
fn [Parser] import_item():
    @accept apply_if($_mk_import_item, xid, opt($[~"as", xid]))

fn [Parser] import_item_list():
    @accept cons(import_item, many($[~'TOK_COMMA, import_item]))

#>  ```ebnf
#>    except_names    ::= identifier
#>                       | "(" , identifier , { "," , identifier } , ")" ;
#>  ```
fn [Parser] except_names():
    @accept $[
        $[~'TOK_LPAREN, cons(xid, many($[~'TOK_COMMA, xid])), ~'TOK_RPAREN]
      | cons(xid, many($[~'TOK_COMMA, xid]))
    ]


# (* ---------------------------------------------------------------------
#    4. Functions
#    --------------------------------------------------------------------- *)

# class_target's receiver names -> (dispatch (type A) ...), or nil without one
fn _mk_dispatch(targets):
    if targets == nil:
        return nil
    types := nil
    for t in targets:
        types = cons($['type, t], types)
    return cons('dispatch, reverse(types))

fn $_mk_fn_def(expr):
    dispatch := car(expr)
    name := cadr(expr)
    params := caddr(expr)
    ret_type := car(cdddr(expr))
    body := cadr(cdddr(expr))
    return $['fn_def, name, _mk_dispatch(dispatch), params, _mk_type_or_auto(ret_type), body]

#>  ```ebnf
#>    fn_def          ::= "fn" , [ class_target ] , identifier , "(" , [ param_list ] , ")" ,
#>                         [ "->" , type_constraint ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  fn message(greeting: str, name: str) -> str:
#>      return greeting + name
#>
#>  fn [int, str] message(what: str) -> str:   # multi-dispatch on (int, str)
#>      ...
#>  ```
#>
fn [Parser] fn_def():
    @accept apply_if($_mk_fn_def,
        ~'TOK_KW_FN, opt(class_target), xid,
        ~'TOK_LPAREN, opt(param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

#>  ```ebnf
#>    class_target    ::= "[" , identifier , { "," , identifier } , "]" ;   (* multi-dispatch receivers *)
#>  ```
fn [Parser] class_target():
    @accept $[~'TOK_LBRACKET, cons(xid, many($[~'TOK_COMMA, xid])), ~'TOK_RBRACKET]

#>  ```ebnf
#>    param_list      ::= param , { "," , param } ;
#>  ```
fn [Parser] param_list():
    @accept cons(param, many($[~'TOK_COMMA, param]))

#>  ```ebnf
#>    param           ::= var_positional | var_keyword | plain_param ;
#>  ```
fn [Parser] param():
    @accept $[var_positional | var_keyword | plain_param]

fn $_mk_plain_param(expr):
    name := car(expr)
    type_c := cadr(expr)
    default := caddr(expr)
    return $['param, name, _mk_type_or_auto(type_c), default]

#>  ```ebnf
#>    plain_param     ::= identifier , [ ":" , type_constraint ] , [ "=" , expression ] ;
#>  ```
fn [Parser] plain_param():
    @accept apply_if($_mk_plain_param,
        xid, opt($[~'TOK_COLON, type_expression]), opt($[~'TOK_EQUAL, expression]))

fn $_mk_var_positional(expr):
    return $['spread_param, expr, $['type, 'auto]]

#>  ```ebnf
#>    var_positional  ::= "*" , identifier ;
#>  ```
fn [Parser] var_positional():
    @accept apply_if($_mk_var_positional, ~'TOK_MUL, xid)

fn $_mk_var_keyword(expr):
    return $['spread_kw_param, expr, $['type, 'auto]]

#>  ```ebnf
#>    var_keyword     ::= "**" , identifier ;
#>  ```
fn [Parser] var_keyword():
    @accept apply_if($_mk_var_keyword, ~'TOK_EXPONENT, xid)

# (* ---------------------------------------------------------------------
#    5. Coroutines
#    --------------------------------------------------------------------- *)

# co_param_list gives (co_params send params), or nil when empty
fn _co_send(co_params):
    if co_params == nil:
        return nil
    return cadr(co_params)

fn _co_plist(co_params):
    if co_params == nil:
        return nil
    return caddr(co_params)

fn $_mk_co_def(expr):
    dispatch := car(expr)
    name := cadr(expr)
    params := caddr(expr)
    ret_type := car(cdddr(expr))
    body := cadr(cdddr(expr))
    return $['co_def, name, _mk_dispatch(dispatch), _co_plist(params),
             _mk_type_or_auto(_co_send(params)), _mk_type_or_auto(ret_type), body]

#>  ```ebnf
#>    co_def          ::= "co" , [ class_target ] , identifier , "(" , [ co_param_list ] , ")" ,
#>                         [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] co_def():
    @accept apply_if($_mk_co_def,
        ~'TOK_KW_CO, opt(class_target), xid,
        ~'TOK_LPAREN, opt(co_param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_co_params(expr):
    send_type := car(expr)
    params := cadr(expr)
    return $['co_params, send_type, params]

fn $_mk_co_params_plain(expr):
    return $['co_params, nil, expr]

#>  ```ebnf
#>    co_param_list   ::= "<-" , type_constraint , [ "," , param_list ]   (* send-type, not a param *)
#>                       | param_list ;
#>  ```
fn [Parser] co_param_list():
    @accept $[
        apply_if($_mk_co_params, ~'TOK_LARROW, type_expression, opt($[~'TOK_COMMA, param_list]))
        | apply_if($_mk_co_params_plain, param_list)
    ]


#> ## Classes

fn $_mk_class_def(expr):
    name := car(expr)
    bases := cadr(expr)
    body := caddr(expr)
    base := nil
    if bases != nil:
        base = car(bases)
    return $['class_def, name, base, body]

#>  ```ebnf
#>    class_def       ::= "class" , identifier , [ "(" , [ arg_list ] , ")" ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  class person:
#>      slot name: str
#>
#>  class family_member(person):
#>      slot relation: str
#>  ```
#>
fn [Parser] class_def():
    @accept apply_if($_mk_class_def,
        ~'TOK_KW_CLASS, xid, opt($[~'TOK_LPAREN, opt(arg_list), ~'TOK_RPAREN]), block)

fn $_mk_slot_def(expr):
    name := car(expr)
    type_c := cadr(expr)
    init := caddr(expr)
    options := car(cdddr(expr))
    return $['slot_def, name, _mk_type_or_auto(type_c), init, options]

#>  ```ebnf
#>    slot_def        ::= "slot" , identifier , [ ":" , type_constraint ] ,
#>                         [ "=" , expression ] , [ "with" , slot_options ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  slot name: str = "John Doe"
#>
#>  slot name: str = "John Doe" with:
#>      setter = fn (value) { this.name = value; }
#>      getter = undefined;
#>  ```
#>
fn [Parser] slot_def():
    @accept apply_if($_mk_slot_def,
        ~'TOK_KW_SLOT, xid,
        opt($[~'TOK_COLON, type_expression]),
        opt($[~'TOK_EQUAL, expression]),
        opt($[~'TOK_KW_WITH, slot_options]))

#>  ```ebnf
#>    slot_options    ::= ":" , NEWLINE , INDENT , { slot_option , stmt_sep } , DEDENT
#>                       | "{" , { slot_option , [ ";" ] } , "}" ;
#>  ```
fn [Parser] slot_options():
    @accept $[
        $[~'TOK_COLON, ~'TOK_NEWLINE, ~'TOK_INDENT, many($[slot_option, ~stmt_sep]), ~'TOK_DEDENT]
        | $[~'TOK_LBRACE, many($[slot_option, ~opt('TOK_SEMICOLON)]), ~'TOK_RBRACE]
    ]

fn $_mk_slot_option(expr):
    kind := car(expr)
    value := cadr(expr)
    return $['slot_option, kind, value]

#>  ```ebnf
#>    slot_option     ::= ( "setter" | "getter" ) , "=" , ( expression | "undefined" ) ;
#>  ```
fn [Parser] slot_option():
    @accept apply_if($_mk_slot_option,
        $[value('setter, "setter") | value('getter, 'TOK_KW_GETTER)],
        ~'TOK_EQUAL,
        $[expression | value('undefined, "undefined")])


#> ## Expressions

fn $_mk_values(expr):
    if cdr(expr) != nil:
        return cons('tuple, expr)
    return car(expr)

fn $_mk_tuple(expr):
    return cons('tuple, expr)

fn _mk_tuple_one(expr):
    return $['tuple, expr]

#>  ```ebnf
#>    tuple_expression ::= list_expression ;        (* comma = tuple *)
#>  ```
fn [Parser] tuple_expression():
    @accept apply_if($_mk_values, list_expression)

fn $_mk_try(expr):
    return $['try, expr]

fn $_try_fn(expr):
    if car(expr):
        return $['try, cdr(expr)]
    return cdr(expr)

#>  ```ebnf
#>    try_expr ::= ( "try", catch_expr ) | catch_expr;
#>  ```
#>
#>  _Example_: `file := try open('badfile.txt')` (an error return propagates immediately)
#>
fn [Parser] expression():
    @accept $[apply_if($_mk_try, $[~'TOK_KW_TRY, catch_expr]) | catch_expr]

fn $_catch_fn(expr):
    base := car(expr)
    handler := cadr(expr)
    if handler == nil:
        return base
    return $['catch, base, handler]

#>  ```ebnf
#>    catch_expr ::= logical_expr , [ "catch" , expression ] ;
#>  ```
#>
#>  _Example_: `file := open('badfile.txt') catch open('goodfile.txt')`
#>
fn [Parser] catch_expr():
    @accept apply_if($_catch_fn, or_expr, opt($[~'TOK_KW_CATCH, expression]))

fn $_mk_or(expr):
    rest := cdr(expr)
    if rest == nil:
        return car(expr)
    return cons('or, expr)

#>  ```ebnf
#>    or_expr ::= logical_expr , { "or", logical_expr }
#>  ```
fn [Parser] or_expr():
    @accept apply_if($_mk_or, cons(and_expr, many(~'TOK_KW_OR, and_expr)))

fn $_mk_and(expr):
    rest := cdr(expr)
    if rest == nil:
        return car(expr)
    return cons('and, expr)

#>  ```ebnf
#>    and_expr ::= or_expr , { "and" , or_expr }
#>  ```
fn [Parser] and_expr():
    @accept apply_if($_mk_and, cons(not_expr, many(~'TOK_KW_AND, not_expr)))

fn $_mk_not(expr):
    $['not, expr]

#>  ```ebnf
#>    not_expr ::= "not" , not_expr | comparison
#>  ```
fn [Parser] not_expr():
    @accept $[apply_if($_mk_not, ~'TOK_KW_NOT, not_expr) | comparison]

# Comparison

fn $_mk_is(expr):
    if cadr(expr):
        return $['not, $['is, car(expr), caddr(expr)]]
    return $['is, car(expr), caddr(expr)]

fn $_mk_comparison(expr):
    $[cadr(expr), car(expr), caddr(expr)]

fn $_mk_in(expr):
    if cadr(expr):
        return $['not, $['in, car(expr), caddr(expr)]]
    return $['in, car(expr), caddr(expr)]

#>  ```ebnf
#>    comparison      ::= binary_expr , "is" , [ "not" ] , type_constraint
#>                       | binary_expr , [ "not" ] , "in" , binary_expr
#>                       | binary_expr , [ comp_op , binary_expr ] ;
#>    comp_op         ::= "<=" | ">=" | "<=>" | "<" | ">" | "==" | "!=" ;
#>  ```
fn [Parser] comparison():
    @accept $[
        apply_if($_mk_is, $[binary_expr, ~'TOK_KW_IS, bool('TOK_KW_NOT), type_expression])
        | apply_if($_mk_comparison, $[binary_expr, comp_op, binary_expr])
        | apply_if($_mk_in, $[binary_expr, bool('TOK_KW_NOT), ~'TOK_KW_IN, binary_expr])
        | binary_expr
    ]

fn [Parser] comp_op():
    @accept $[ value('<=, 'TOK_LE) |
               value('>=, 'TOK_GE) |
               value('<=>, 'TOK_SPACESHIP) |
               value('<, 'TOK_LT) |
               value('>, 'TOK_GT) |
               value('==, 'TOK_DEQUAL) |
               value('!=, 'TOK_NE) ]

# Binary Op

#: precedence for the operand, determines order of folding
fn _binary_prec(op) -> int:
    if op == '|:
        return 1
    if op == '^:
        return 2
    if op == '&:
        return 3
    if op == '<< or op == '>>:
        return 4
    if op == '+ or op == '-:
        return 5
    return 6

#: apply head op to operands and return result
fn _binary_reduce(ops, operands):
    rhs := car(operands)
    lhs := cadr(operands)
    return cons($[car(ops), lhs, rhs], cdr(cdr(operands)))

# expr is the flat list `operand op operand op operand ...`
fn $_binary_expr(expr):
    operands := $[car(expr)]
    ops := nil
    rest := cdr(expr)
    while rest != nil:
        op := car(rest)
        while ops != nil and _binary_prec(car(ops)) >= _binary_prec(op):
            operands = _binary_reduce(ops, operands)
            ops = cdr(ops)
        ops = cons(op, ops)
        operands = cons(cadr(rest), operands)
        rest = cdr(cdr(rest))
    while ops != nil:
        operands = _binary_reduce(ops, operands)
        ops = cdr(ops)
    return car(operands)

#>  ```ebnf
#>    binary_expr     ::= unary_expr , { binary_op , unary_expr } ;
#>    binary_op       ::= "|" | "^" | "&" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" ;
#>  ```
fn [Parser] binary_expr():
    @accept apply_if($_binary_expr, cons(unary_expr, manyflat($[binary_op, unary_expr])))

fn [Parser] binary_op():
    @accept $[ value('|, 'TOK_OR)
            | value('^, 'TOK_XOR)
            | value('&, 'TOK_AND)
            | value('<<, 'TOK_LSHIFT)
            | value('>>, 'TOK_RSHIFT)
            | value('+, 'TOK_PLUS)
            | value('-, 'TOK_MINUS)
            | value('*, 'TOK_MUL)
            | value('/, 'TOK_DIV)
            | value('%, 'TOK_MOD) ]

# unary_expr

fn $_mk_neg(expr):
    return $['neg, expr]

fn $_mk_pos(expr):
    return $['pos, expr]

fn $_mk_invert(expr):
    return $['~, expr]

#>  ```ebnf
#>    unary_expr      ::=
#>                       | ( "-" | "+" | "~" | "not" ) , unary_expr
#>                       | power_expr ;
#>  ```
fn [Parser] unary_expr():
    @accept $[
        apply_if($_mk_neg, $[~'TOK_MINUS, unary_expr])
        | apply_if($_mk_pos, $[~'TOK_PLUS, unary_expr])
        | apply_if($_mk_invert, $[~'TOK_TILDE, unary_expr])
        | apply_if($_mk_not, $[~'TOK_KW_NOT, unary_expr])
        | power_expr
    ]

fn $_mk_exp(expr):
    cons('**, expr)

#>  ```ebnf
#>    power_expr      ::= postfix_expr , [ "**" , unary_expr ] ;       (* right-assoc *)
#>  ```
fn [Parser] power_expr():
    @accept $[
        apply_if($_mk_exp, $[postfix_expr, ~'TOK_EXPONENT, unary_expr])
        | postfix_expr
    ]

# postfix

fn $_mk_postfix(expr):
    ops := cdr(expr)
    if ops == nil:
        return car(expr)
    current := car(expr)
    remaining := ops
    while remaining != nil:
        op := car(remaining)
        op_kind := car(op)
        if op_kind == 'call_op:
            current = cons('apply, cons(current, cdr(op)))
        elif op_kind == 'index_op:
            current = $['index, current, cadr(op)]
        elif op_kind == 'attr_op:
            current = $['attr, current, cadr(op)]
        elif op_kind == 'bind_msg_op:
            current = $['bind_msg, current, cadr(op)]
        else:
            # Unknown postfix op, return original
            return expr
        remaining = cdr(remaining)
    return current

#>  ```ebnf
#>    postfix_expr    ::= primary , { postfix_op } ;
#>    postfix_op      ::= call_op | index_op | attr_op | message_op ;
#>  ```
#                      (* "::" is qualified_name's job, not a postfix op -
#                         f()::x and a[0]::x are not valid. *)
#>  ```ebnf
#>    call_op         ::= "(" , [ arg_list ] , ")" ;
#>    index_op        ::= "[" , expression , "]" ;
#>    attr_op         ::= "." , identifier ;
#>    bind_msg        ::= "!" , identifier ;
#>  ```

fn [Parser] postfix_expr():
    @accept apply_if($_mk_postfix, cons(primary, many(postfix_op)))

fn [Parser] postfix_op():
    @accept $[call_op | index_op | attr_op | bind_msg_op]

fn [Parser] call_op():
    @accept  $[~'TOK_LPAREN, cons(push('call_op), opt(arg_list)), ~'TOK_RPAREN]

fn [Parser] index_op():
    @accept $[~'TOK_LBRACKET, push('index_op), expression, ~'TOK_RBRACKET]

fn [Parser] attr_op():
    @accept $[~'TOK_DOT, push('attr_op), xid]

fn [Parser] bind_msg_op():
    @accept $[~'TOK_BANG, push('bind_msg_op), xid]

#>  ```ebnf
#>    arg_list        ::= argument , { "," , argument } , [ "," ] ;
#>    argument        ::= expression
#>                       | identifier , "=" , expression          (* keyword argument *)
#>                       | "*" , expression                       (* spread positional *)
#>                       | "**" , expression ;                    (* spread keyword *)
#>  ```
fn [Parser] arg_list():
    @accept $[cons(argument, many(~'TOK_COMMA, argument)), ~opt('TOK_COMMA)]

fn $_mk_kwarg(expr):
    return $['kwarg, car(expr), cadr(expr)]

fn $_mk_spread(expr):
    return $['spread, expr]

fn $_mk_spread_kw(expr):
    return $['spread_kw, expr]

fn [Parser] argument():
    @accept $[
        apply_if($_mk_kwarg, xid, ~'TOK_EQUAL, expression)
      | apply_if($_mk_spread_kw, ~'TOK_EXPONENT, expression)
      | apply_if($_mk_spread, ~'TOK_MUL, expression)
      | expression
    ]


#>  ```ebnf
#>    primary         ::= literal
#>                       | decorated_expr
#>                       | qualified_name
#>                       | "(" , tuple_expression , ")"
#>                       | "(" , ")"                              (* empty tuple *)
#>                       | array_literal
#>                       | pair_literal
#>                       | dict_literal
#>                       | "return" , [ expression ]
#>                       | "yield" , "from" , expression
#>                       | "yield" , [ expression ]
#>                       | "break"
#>                       | "continue"
#>                       | "pass"
#>                       | if_stmt
#>                       | while_stmt
#>                       | for_stmt
#>                       | lambda_expr
#>                       | co_lambda_expr
#>                       | anonymous_class
#>                       | do_expr ;
#>
#>    decorated_expr  ::= decorator , { decorator } , expression ;
#>  ```
#>
#>  _Example_: `v := @accept 'TOK_XID` (see decorator in parser.wy)
#>
fn [Parser] decorated_expr():
    @accept apply_if($_mk_stmt, cons(decorator, many(decorator)), expression)

fn [Parser] primary():
    @accept $[ literal
             | decorated_expr
             | qualified_name
             | apply_if(_mk_tuple_one, $[~'TOK_LPAREN, expression, ~'TOK_COMMA, ~'TOK_RPAREN])
             | $[~'TOK_LPAREN, tuple_expression, ~'TOK_RPAREN]
             | array_literal
             | pair_literal
             | dict_literal
             | apply_if(_as_list, value('tuple, $[~'TOK_LPAREN, ~'TOK_RPAREN]))
             | return_stmt
             | yield_stmt
             | break_stmt
             | continue_stmt
             | pass_stmt
             | if_stmt
             | while_stmt
             | for_stmt
             | lambda_expr
             | co_lambda_expr
             | anonymous_class
             | do_expr
             ]

#>  ```ebnf
#>    literal         ::= nil_literal
#>                       | number_literal
#>                       | bool_literal
#>                       | string_literal
#>                       | symbol_literal
#>                       | char_literal
#>                       | "..." ;
#>  ```
fn [Parser] literal():
    @accept $[ nil_literal
               | number_literal
               | bool_literal
               | string_literal
               | symbol_literal
               | char_literal
             | apply_if(_as_list, value('ellipsis, 'TOK_ELLIPSIS))
             ]

fn $_mk_array(expr):
    cons('array, expr)

#>  ```ebnf
#>    array_literal   ::= "[" , [ list_expression ] , "]" ;
#>  ```
#>
#>  _Example_: `[1, 2, 3, 4]`
#>
fn [Parser] array_literal():
    @accept $[
        apply_if(_as_list, value('array, $[~'TOK_LBRACKET, ~'TOK_RBRACKET]))
        | apply_if($_mk_array, $[~'TOK_LBRACKET, list_expression, ~'TOK_RBRACKET])
    ]

fn $_mk_list(expr):
    cons('list, expr)

#>  ```ebnf
#>    pair_literal    ::= "$[" , [ list_expression ] , "]" ;             (* cons-list primitive *)
#>  ```
#>
#>  _Example_: `$[]` (empty), `$['a]` (single element), `$[1, 2, 3]` (proper pair list)
#>
fn [Parser] pair_literal():
    @accept $[
        apply_if(_as_list, value('list, $[~'TOK_LBRACKET_S, ~'TOK_RBRACKET]))
        | apply_if($_mk_list, $[~'TOK_LBRACKET_S, list_expression, ~'TOK_RBRACKET])
    ]

#>  ```ebnf
#>    list_expression ::= expression , { "," , expression } , [ "," ] ;
#>  ```
fn [Parser] list_expression():
    @accept $[cons(expression, many($[~'TOK_COMMA, expression])), ~opt('TOK_COMMA)]

fn $_mk_dict(expr):
    cons('dict, expr)

#>  ```ebnf
#>    dict_literal    ::= "{" , [ dict_pair , { "," , dict_pair } ] , "}" ;
#>    dict_pair       ::= expression , ":" , expression ;
#>  ```
#>
#>  _Example_: `{ "Name": 15 }`
#>
fn [Parser] dict_literal():
    @accept $[
        apply_if(_as_list, value('dict, $[~'TOK_LBRACE, ~'TOK_RBRACE]))
        | apply_if($_mk_dict,
            $[~'TOK_LBRACE, cons(dict_pair, many($[~'TOK_COMMA, dict_pair])), ~opt('TOK_COMMA), ~'TOK_RBRACE]
          )
    ]

fn [Parser] dict_pair():
    @accept $[expression,
        ~expect("expected ':' in dictionary entry", 'TOK_COLON),
         expect("dictionary value", expression)]

fn $_mk_lambda(expr):
    params := car(expr)
    ret_type := cadr(expr)
    body := caddr(expr)
    return $['lambda, params, _mk_type_or_auto(ret_type), body]

#>  #### Anonymous Closures and Types
#>
#>  These provide a way to create an anonymous class or function. Note that
#>  anonymous classes *must* provide their messages internally as message
#>  definitions require the lexical class name.
#>

#>  ```ebnf
#>    lambda_expr     ::= "fn" , "(" , [ param_list ] , ")" , [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] lambda_expr():
    @accept apply_if($_mk_lambda,
        ~'TOK_KW_FN, ~'TOK_LPAREN, opt(param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_co_lambda(expr):
    params := car(expr)
    ret_type := cadr(expr)
    body := caddr(expr)
    return $['co_lambda, _co_plist(params), _mk_type_or_auto(_co_send(params)),
             _mk_type_or_auto(ret_type), body]

#>  ```ebnf
#>    co_lambda_expr  ::= "co" , "(" , [ co_param_list ] , ")" , [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] co_lambda_expr():
    @accept apply_if($_mk_co_lambda,
        ~'TOK_KW_CO, ~'TOK_LPAREN, opt(co_param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_class_expr(expr):
    bases := car(expr)
    body := cadr(expr)
    return $['class_expr, bases, body]

#>  ```ebnf
#>  anonymous_class ::= "class" , [ "(" , [ qualified_name ] , ")" ] , block ;
#>  ```
#>
#>  _Example_:
#>  ```wyrm
#>  AnonPerson := class() { slot name: str; slot age: int; }
#>
#>  # Equivalent
#>  class NamedPerson:
#>      slot name: str
#>      slot age: int
#
#>  ```
fn [Parser] anonymous_class():
    @accept apply_if($_mk_class_expr,
        ~'TOK_KW_CLASS, opt($[~'TOK_LPAREN, opt(qualified_name), ~'TOK_RPAREN]), block)

#>  ```ebnf
#>    do_expr         ::= "do" , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  complex_answer := do:
#>      step_1()
#>      step_2()
#>      10
#>  # complex_answer == 10
#>  ```
#>
fn [Parser] do_expr():
    @accept cons(value('do, 'TOK_KW_DO), raw_block)


# (* ---------------------------------------------------------------------
#    10. Operator precedence
#    --------------------------------------------------------------------- *)

# (*   tuple_expr        ,               (loosest: builds a tuple)
#      assign_expr       ?=  try/catch
#      logical_expr      or
#                         and             (tighter than or)
#      not_expr          not              (prefix; own tier)
#      comparison        is  <=  >=  <=>  <  >  ==  !=  in   (non-associative - no chaining)
#      binary_expr       |
#                         ^
#                         &
#                         <<  >>
#                         +   -
#                         *   /   %
#      unary_expr        -  +  ~  not     (prefix; "not" here is a second,
#                                           tighter tier from the one above -
#                                           see the note at unary_expr)
#      power_expr        **               (right-associative)
#      postfix_expr       .  ()  []  !  ::   (tightest)

#    All binary_expr and logical_expr levels are left-associative. *)

fn __main():
    f := open(car(__ARGS), "r")
    content := f!readall()
    program := Parser(content)!program()
    println(program)

# Simple Demo
if __name__ == "__main__":
    __main()
