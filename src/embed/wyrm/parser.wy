import wyrm::tokenizer::*
import wyrm::decode::*
import wyrm::ast
import std::pairs::*
import wyrm::ast::*

import wyrm::_dsl::*

#>  # Wyrm Language Grammar
#>
#>  This grammar file is generated directly from the packrate/PEG style parser
#>  and lexxer included in the wyrm source tree. As wyrm is still at prototype
#>  stage, the grammar is expected to drift. However, at this point, the majority
#>  of primitives with basic execution should be considered stable.
#>
# Lexical Grammar sections
#>>include:tokenizer.wy

class Parser:
    slot buffer: str
    slot tokens: list
    slot pos: int
    slot cache_hits: dict
    slot cache_misses: list

    fn init(buffer: str):
        this.buffer = buffer
        this.tokens = TokenStream(buffer) ! scan()
        this.pos = 0
        this.cache_hits = {}
        this.cache_misses = []

    fn peek(n: int) -> Token:
        idx := this.pos + n
        last := len(this.tokens) - 1
        if idx > last:
            idx = last
        return this.tokens[idx]

    fn advance() -> Token:
        t := this ! peek(0)
        this.pos = this.pos + 1
        return t

    fn mark() -> int:
        return this.pos

    fn reset(mark: int):
        this.pos = mark

    fn _cache_key(id: int, pos: int) -> str:
        return str(id) + ":" + str(pos)

    fn get_cache(id: int, pos: int):
        key := this ! _cache_key(id, pos)
        if key in this.cache_hits:
            entry := this.cache_hits[key]
            this.pos = entry[1]
            return entry[0]
        if key in this.cache_misses:
            return 'NO_MATCH
        return 'NO_CACHE

    fn put_hit(id: int, pos: int, end_pos: int, result):
        key := this ! _cache_key(id, pos)
        this.cache_hits[key] = [result, end_pos]

    fn put_miss(id: int, pos: int):
        key := this ! _cache_key(id, pos)
        this.cache_misses ! append(key)

    fn clear():
        this.cache_hits = {}
        this.cache_misses = []


#>  ```ebnf
#>    bool_literal    ::= "true" | "false" ;
#>  ```
#>
#>  _Example_: `true`, `false`
#>
fn [Parser] bool_literal():
    @accept apply_if(_mk_atom, $[value('true, 'TOK_KW_TRUE) | value('false, 'TOK_KW_FALSE)])

fn [Parser] nil_literal():
    @accept apply_if(_mk_atom, value('nil, 'TOK_KW_NIL))

# A node with no fields: `(nil)`, `(true)`, `(pass)`... (ast.md R3: these are
# headed nodes, never bare symbols, so a bare symbol is always a name).
fn _mk_atom(kind: sym):
    return cons(kind, nil)

# A node whose one field is optional: `(return)` or `(return x)`, and the
# same for yield and break.
fn _mk_opt_tail(kind: sym, expr):
    if expr is nil:
        return cons(kind, nil)
    return $[kind, expr]


fn [Parser] xid() -> sym:
    v := @accept 'TOK_XID
    if is_match(v):
        return sym(v!get_text(this.buffer))
    else:
        return v

# A path of two or more segments is (:: a b c) (ast.md). The head is built
# with sym(): stage0's parser does not take `'::` as a symbol literal.
_SCOPE := sym("::")

fn _mk_qualified_name(segs):
    if cdr(segs) == nil:
        return sym(car(segs))
    return cons(_SCOPE, segs)

# Qualified name; used for an expression of a fully qualified name
fn [Parser] qualified_name():
    @accept apply_if(_mk_qualified_name, cons(xid, many($[~'TOK_SCOPE, xid])))

# symbol_literal
fn [Parser] symbol_literal():
    @accept apply_if(_mk_sym, text('TOK_LITERAL_SYM))

fn _mk_sym(text):
    return $['sym, decode_sym(text)]

# string literal
fn [Parser] string_literal():
    @accept apply_if(_mk_string, text('TOK_STR))

fn _mk_string(text):
    return $['str, decode_str(text)]

# integer literal
fn _mk_int(text):
    return $['int, decode_int(text)]

# floating point literal
fn _mk_float(text):
    return $['float, decode_float(text)]

fn [Parser] number_literal():
    @accept $[apply_if(_mk_int, text('TOK_LITERAL_INT)) | apply_if(_mk_float, text('TOK_LITERAL_FLOAT))]

#>  ```ebnf
#>    char_literal    ::= "\" , ( ( any_char - ( control_char | " " ) ) | identifier ) ;
#>  ```
#>
#>  _Example_: `\a`, `\newline`
#>
# Character names for the `\newline`-style escapes - the same table the
# interpreter's eval_char_literal consults (pypoc/wypoc/
# wyrm_eval_parse_tree.py's CHAR_NAMES).
_CHAR_NAMES := {"newline": 10, "space": 32, "tab": 9, "return": 13, "backspace": 8, "formfeed": 12, "null": 0}

# A char literal's node: `$['char, codepoint]` - the u32 codepoint, the
# same representation string indexing produces, which expressions.wy's
# _char_lit lowers to `i8`. This transform is what the epic report's M1-M4
# checkpoint flagged as missing (char_literal answered the raw token, so
# no char literal could ever reach lowering).
fn _mk_char(text):
    body := text ! substr(1, len(text) - 1)
    if len(body) == 1:
        return $['char, body[0]]
    named := (_CHAR_NAMES[body] catch nil)
    if named is nil:
        return error("unknown character name " + text)
    return $['char, named]

fn [Parser] char_literal():
    @accept apply_if(_mk_char, text('TOK_LITERAL_CHAR))

# -----------------------------------------------------------------------------
#>  ## Program Structure
# -----------------------------------------------------------------------------
#>
#>  ```ebnf
#>  program ::= { [stmt_sep] , top_level_stmt } ;
#>  top_level_stmt ::= import_stmt | stmt_line ;
#>  ```
#>

fn _mk_module(expr):
    cons('module, expr)

# Epic 8 M3 finding: program() never required reaching end-of-input, so any
# top_level_stmt that failed to match partway through the file (for any
# reason - a genuine syntax error, or a legitimate construct a parser bug
# happens to choke on, e.g. a lambda as a slot_option value once nested
# inside enough context) silently truncated the AST to whatever parsed
# before that point, with no error at all - `program := Parser(content)
# !program()` in __main() below never checked for one either. Requiring
# ~'TOK_END here turns any such case into an honest parse failure instead
# of a silently wrong (but well-formed-looking) partial tree.
fn [Parser] program():
    @accept $[apply_if(_mk_module, many($[~opt(stmt_sep), top_level_stmt])), ~opt(stmt_sep), ~'TOK_END]


fn [Parser] top_level_stmt():
    @accept $[import_stmt | stmt_line]


# -----------------------------------------------------------------------------
#>  # Blocks and statements
# -----------------------------------------------------------------------------

#>  ```ebnf
#>  block           ::= ":" , NEWLINE , INDENT , stmt_list , DEDENT
#>                     | ":" , stmt_line, [stmt_sep]
#>                     | "{" , stmt_list , "}" ;
#>  ```

# A body holds exactly one form (ast.md R2): a block of one statement is
# that statement, and a block of more is `(do s...)`.
fn [Parser] block():
    @accept apply_if(_mk_body, block_stmts)

# A block's statements as a pair list, whichever form it was written in.
fn [Parser] block_stmts():
    @accept $[
        $[~'TOK_COLON, ~'TOK_NEWLINE, ~'TOK_INDENT, stmt_list, ~'TOK_DEDENT]
      | apply_if(_mk_one_stmt, $[~'TOK_COLON, stmt_line, ~opt(stmt_sep)])
      | $[~'TOK_LBRACE, stmt_list, ~'TOK_RBRACE]
     ]

fn _mk_one_stmt(stmt):
    return cons(stmt, nil)

fn _mk_body(stmts):
    if cdr(stmts) == nil:
        return car(stmts)
    return cons('do, stmts)

#>  ### Statements
#>
#>  Statements include all expressions with the addition of statements that
#>  introduce name definitions or scope operations.
#>
#>  ```ebnf
#>    stmt_line       ::= { decorator } ,
#>                         ( var_stmt
#>                         | assignment_stmt
#>                         | expression
#>                         | static_stmt
#>                         | import_stmt
#>                         | defer_stmt
#>                         | fn_def
#>                         | co_def
#>                         | class_def
#>                         | slot_def ) ;
#>    stmt_list ::= stmt_line , { [stmt_sep] , stmt_line } , [stmt_sep] ;
#>    stmt_sep ::= NEWLINE | ";" | EOF ;
#>  ```

fn [Parser] stmt_list():
    @accept $[cons(stmt_line, many($[~opt(stmt_sep), stmt_line])), ~opt(stmt_sep)]

fn [Parser] stmt_sep():
    @accept $['TOK_NEWLINE | 'TOK_SEMICOLON | 'TOK_END]

fn [Parser] expect_stmt_sep() -> bool:
    @accept $[expect("statement end", stmt_sep)]

# Each decorator is one (decorate name target arg...) node, the arguments
# spliced like apply's; stacked decorators nest, the first written
# outermost, so the innermost applies first (ast.md "Decorators").
fn $_mk_stmt_line(expr):
    decs := car(expr)
    target := cadr(expr)
    if decs == nil:
        return target
    p := reverse(decs)
    while p is pair:
        dec := car(p)
        target = cons('decorate, cons(cadr(dec), cons(target, caddr(dec))))
        p = cdr(p)
    return target

fn [Parser] stmt_line():
    r := @accept apply_if($_mk_stmt_line,
        many(decorator),
        $[ var_stmt
         | assignment_stmt
         | expression
         | static_stmt
         | import_stmt
         | defer_stmt
         | fn_def
         | co_def
         | class_def
         | slot_def
        ])
    # A fully accepted statement is a commit point: nothing left
    # uncommitted can backtrack across it, so the packrat cache built
    # up while parsing it (see _dsl.wy's accept/get_cache/put_hit/
    # put_miss) can be dropped.
    if r != 'NO_MATCH and r is not error:
        this ! clear()
    r

fn $_mk_decorator(expr):
    name := car(expr)
    args := cadr(expr)
    return $['decorator, name, args]

#>  #### Decorators
#>
#>  Decorators provide macros to a statement line. Example:
#>
#>    - `@make_cached fn a_function() {`
#>    - `@accept dsl_language_statement`
#>
#>  ```ebnf
#>    decorator       ::= "@" , identifier , [ "(" , [ arg_list ] , ")" ] ;
#>  ```
fn [Parser] decorator():
    @accept apply_if($_mk_decorator,
        ~'TOK_AT, xid,
        opt($[~'TOK_LPAREN, opt(arg_list), ~'TOK_RPAREN]),
        ~opt('TOK_NEWLINE))

fn $_mk_defer(expr):
    cond := car(expr)
    body := cadr(expr)
    # `defer: body` is (defer body); `defer on T: body` is (defer_on T body).
    if cond is nil:
        return $['defer, body]
    return $['defer_on, cond, body]

#>  ```ebnf
#>    defer_stmt      ::= "defer" , [ "on" , type_constraint ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  v := resource()
#>  defer:
#>      v ! release()
#>
#>  v := resource()
#>  defer on error:        # runs only if the calling block force-returned an error
#>      v ! release()
#>  ```
#>
fn [Parser] defer_stmt():
    @accept apply_if($_mk_defer, ~'TOK_KW_DEFER, opt($[~"on", type_expression]), block)

# `if`/`elif`/`else` is one `cond` (ast.md): a `(test body)` clause per arm,
# and `(else body)` last when there is an else.
fn $_mk_if(expr):
    test := car(expr)
    body := cadr(expr)
    elifs := caddr(expr)
    else_block := car(cdddr(expr))
    tail := nil
    if not (else_block is nil):
        tail = cons($['else, else_block], nil)
    clauses := nil
    if elifs is pair:
        clauses = reverse(elifs)
    while clauses is pair:
        clause := car(clauses)
        tail = cons($[car(clause), cadr(clause)], tail)
        clauses = cdr(clauses)
    return cons('cond, cons($[test, body], tail))

#>  ```ebnf
#>    if_stmt         ::= "if" , expression , block ,
#>                         { "elif" , expression , block } ,
#>                         [ "else" , block ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  if condition:
#>      statements
#>  elif condition_2:
#>      statements
#>  else:
#>      statements
#>  ```
#>
fn [Parser] if_stmt():
    @accept apply_if($_mk_if,
        ~'TOK_KW_IF, expression, block,
        many($[~'TOK_KW_ELIF, expression, block]),
        opt($[~'TOK_KW_ELSE, block]))

fn $_mk_while(expr):
    return $['while, car(expr), cadr(expr)]

#>  ```ebnf
#>    while_stmt      ::= "while" , expression , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  while condition:
#>      statement
#>      if condition_2:
#>          break
#>  ```
#>
fn [Parser] while_stmt():
    @accept apply_if($_mk_while, ~'TOK_KW_WHILE, expression, block)

fn $_mk_for(expr):
    varname := car(expr)
    iterable := cadr(expr)
    body := caddr(expr)
    else_block := car(cdddr(expr))
    # (for target iter else body): the else clause before the body (ast.md).
    return $['for, varname, iterable, else_block, body]

#>  ```ebnf
#>    for_stmt        ::= "for" , identifier , "in" , expression , block ,
#>                         [ "else" , block ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  for name in iterable:
#>      statement
#>      if condition:
#>          break
#>  else:
#>      statement_if_no_break
#>  ```
#>
fn [Parser] for_stmt():
    @accept apply_if($_mk_for,
        ~'TOK_KW_FOR, xid, ~'TOK_KW_IN, expression, block, opt($[~'TOK_KW_ELSE, block]))

fn $_mk_return(expr):
    return _mk_opt_tail('return, expr)

#>  ```ebnf
#>    return_stmt     ::= "return" , [ expression ] ;
#>  ```
fn [Parser] return_stmt():
    # tuple_expression, not expression: `return a, b` is a comma list - the
    # one place the bare statement form needs the comma tier (pypoc's
    # expression is an expr_list for the same reason). `$_mk_values` wraps
    # multi-element lists in 'tuple, which statements.wy's _return lowers
    # as a multi-value return; a single element passes through unwrapped.
    @accept apply_if($_mk_return, ~'TOK_KW_RETURN, opt(tuple_expression))

fn $_mk_yield_from(expr):
    return $['yield_from, expr]

fn $_mk_yield(expr):
    return _mk_opt_tail('yield, expr)

#>  ```ebnf
#>    yield_stmt      ::= "yield" , "from" , expression
#>                       | "yield" , [ expression ] ;
#>  ```
fn [Parser] yield_stmt():
    @accept $[
        apply_if($_mk_yield_from, ~'TOK_KW_YIELD, ~'TOK_KW_FROM, expression)
        | apply_if($_mk_yield, ~'TOK_KW_YIELD, opt(expression))
    ]

#>  ```ebnf
#>    break_stmt      ::= "break" , [ expression ] ;
#>  ```
fn [Parser] break_stmt():
    @accept apply_if($_mk_break, ~'TOK_KW_BREAK, opt(expression))

fn $_mk_break(expr):
    return _mk_opt_tail('break, expr)

#>  ```ebnf
#>    continue_stmt   ::= "continue" ;
#>  ```
fn [Parser] continue_stmt():
    @accept apply_if(_mk_atom, value('continue, 'TOK_KW_CONTINUE))

#>  ```ebnf
#>    pass_stmt       ::= "pass" ;
#>  ```
fn [Parser] pass_stmt():
    @accept apply_if(_mk_atom, value('pass, 'TOK_KW_PASS))


#>  ```ebnf
#>    var_stmt        ::= "var" , var_target , { "," , var_target } , [ "=" , tuple_expression ] ;
#>    var_target      ::= identifier , [ ":" , type_expression ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  var foo: int = 5           # canonical declaration with type constraint
#>  var foo = 5                # declaration with inferred type
#>  var x: int, y: int = 6, 5  # multiple names, bound from a tuple init
#>  foo := 5                   # shorthand for the line above
#>  ```
#>
#>  _S-Expression_
#>
#>  ```scheme
#>  (define var_target type_expression expression) ; for 1 binding
#>  (define_values ((var_0 type_0)(var_1 type_1)) expression) ; for n binding
#>  ```
#>
fn [Parser] var_stmt():
    @accept apply_if($_mk_define_var,
        ~'TOK_KW_VAR,
        cons(var_target, many($[~'TOK_COMMA, var_target])),
        opt($[~'TOK_EQUAL, tuple_expression]))

fn [Parser] var_target():
    @accept $[xid, opt($[~'TOK_COLON, type_expression])]

# var_target's type_expr is already a finished type node (or nil if
# omitted) - not the raw type_atom list _mk_type_expression reduces.
fn _mk_type_or_auto(type_expr):
    if type_expr == nil:
        return $['type, 'auto]
    return type_expr

fn _build_define(pairs, init):
    if cdr(pairs) == nil:
        p := car(pairs)
        return $['define, sym(car(p)), _mk_type_or_auto(cadr(p)), init]
    typed := nil
    for p in pairs:
        typed = cons($[car(p), _mk_type_or_auto(cadr(p))], typed)
    return $['define_values, reverse(typed), init]

fn $_mk_define_var(expr):
    targets := car(expr)
    init := cadr(expr)
    return _build_define(targets, init)

fn $_mk_assign(expr):
    targets := car(expr)
    op := cadr(expr)
    value := caddr(expr)
    if op == 'assign_bind:
        pairs := nil
        for t in targets:
            pairs = cons($[t, nil], pairs)
        return _build_define(reverse(pairs), value)
    if op == 'assign_qeq:
        if cdr(targets) != nil:
            return error("?= only supports a single assignment target")
        return $['if_set, car(targets), value]
    # single value
    if cdr(targets) is nil:
        return n_set(car(targets), value)
    # multiple values
    return $['set_values, targets, value]

#>  ```ebnf
#>    assignment_stmt ::= target , { "," , target } , "=" , tuple_expression
#>                       | target , "?=" , tuple_expression ;
#>  ```
#>
#>  _Example_: `a, b = b, a` (swap; both names must already be declared)
#>
#>  _Example_: `k ?= 4`
#>
#>  ```scheme
#>  (set var value) ; set var to value
#>  (set_values (var1 var2) value) ; set multiple values
#>  ```
#>
fn [Parser] assignment_stmt():
    @accept apply_if($_mk_assign,
        cons(target, many($[~'TOK_COMMA, target])),
        assign_op,
        tuple_expression)

# Split a pair list into (all-but-last, last)
fn _split_last(lst):
    if cdr(lst) == nil:
        return $[nil, car(lst)]
    rest := _split_last(cdr(lst))
    return $[cons(car(lst), car(rest)), cadr(rest)]

fn $_mk_target_base(expr):
    if expr is not pair:
        return expr
    parts := _split_last(expr)
    butlast := car(parts)
    last := cadr(parts)
    if car(last) != 'attr_op:
        return expr
    base := butlast
    if cdr(base) == nil:
        base = car(base)
    return $['attr, base, cadr(last)]

fn $_mk_target(expr):
    base := car(expr)
    indices := cadr(expr)
    if indices == nil:
        return base
    return $['target, base, indices]

#>  ```ebnf
#>    target          ::= ( identifier | postfix_expr , "." , identifier ) , { "[" , expression , "]" } ;
#>  ```
#>
fn [Parser] target():
    @accept apply_if($_mk_target,
        apply_if($_mk_target_base, postfix_expr),
        many($[~'TOK_LBRACKET, expression, ~'TOK_RBRACKET]))

#>  ```ebnf
#>    assign_op       ::= "=" | "?=" | ":=" ;
#>  ```
fn [Parser] assign_op():
    @accept $[ value('assign, 'TOK_EQUAL) | value('assign_qeq, 'TOK_QEQ) | value('assign_bind, 'TOK_BIND) ]

fn $_mk_static(expr):
    name := car(expr)
    type_c := cadr(expr)
    init := caddr(expr)
    if type_c is nil:
        type_c = $['type, 'auto]
    return $['static, name, type_c, init]

#>  ```ebnf
#>    static_stmt     ::= "static" , identifier , [ ":" , type_constraint ] , [ "=" , expression ] ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  fn call_count():
#>      static foo: int = 0
#>      foo = foo + 1
#>      return foo
#>  ```
#>
fn [Parser] static_stmt():
    @accept apply_if($_mk_static,
        ~'TOK_KW_STATIC, xid,
        opt($[~'TOK_COLON, type_expression]),
        opt($[~'TOK_EQUAL, expression]))

#------------------------------------------------------------------------------
#>  ## Type Expression
#------------------------------------------------------------------------------

#>
#>  ```ebnf
#>    type_atom       ::= qualified_name | "nil" ;
#>    type_constraint ::= type_atom , { "|" , type_atom } ;
#>  ```

fn [Parser] type_atom():
    @accept $[ $[push('type), qualified_name]
             | $[push('type), value('nil, 'TOK_KW_NIL)]
             ]

fn [Parser] type_expression():
    @accept apply_if(_mk_type_expression, cons(type_atom, many($[~'TOK_OR, type_atom])))

# A union is one flat type node, (type a b ...) (ast.md): each atom's
# name or path, not a nested (type x).
fn _mk_type_expression(type_expr):
    if type_expr == nil:
        return $['type, 'auto]
    if cdr(type_expr) == nil:
        return car(type_expr)
    atoms := nil
    p := reverse(type_expr)
    while p is pair:
        atoms = cons(cadr(car(p)), atoms)
        p = cdr(p)
    return cons('type, atoms)

#------------------------------------------------------------------------------
#>  ## Modules and Imports
#------------------------------------------------------------------------------

# (import path spec?) and (import_static path spec?) (ast.md). import_body
# answers `$[path, spec_or_nil]`.
fn _mk_import(expr):
    is_static := car(expr)
    parts := cadr(expr)
    head := 'import
    if is_static:
        head = 'import_static
    if cadr(parts) is nil:
        return $[head, car(parts)]
    return $[head, car(parts), cadr(parts)]

#>  ```ebnf
#>      import_stmt     ::= "import" , [ "static" ] , import_body ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  import mod::baz::bar
#>  import mod::baz as bt
#>  import std::io::(File, StreamReader, StreamWriter)
#>  import std::io::* except (File, StreamReader)
#>  import static std::io
#>  ```
#>
fn [Parser] import_stmt():
    @accept apply_if(_mk_import, $[~'TOK_KW_IMPORT, bool('TOK_KW_STATIC), import_body, ~expect("statement end", stmt_sep)])


# The import specs (ast.md): (all except...), (items (item name alias)...)
# and (as name).
fn $_mk_import_all_except(expr):
    path := car(expr)
    ex := cadr(expr)
    return $[path, cons('all, ex)]

fn $_mk_import_all(path):
    return $[path, $['all]]

fn $_mk_import_items(expr):
    path := car(expr)
    items := cadr(expr)
    return $[path, cons('items, items)]

fn $_mk_import_as(expr):
    path := car(expr)
    alias := cadr(expr)
    return $[path, $['as, alias]]

fn $_mk_import_path(path):
    return $[path, nil]

#>  ```ebnf
#>      import_body     ::= qualified_name , "::" , "*" , "except" , except_names
#>                       | qualified_name , "::" , "*"
#>                       | qualified_name , "::" , "(" , import_item , { "," , import_item } , ")"
#>                       | qualified_name , [ "as" , identifier ] ;
#>  ```
fn [Parser] import_body():
    @accept $[
        apply_if($_mk_import_all_except, qualified_name, ~'TOK_SCOPE, ~'TOK_MUL, ~"except", except_names)
      | apply_if($_mk_import_all, qualified_name, ~'TOK_SCOPE, ~'TOK_MUL)
      | apply_if($_mk_import_items, qualified_name, ~'TOK_SCOPE, ~'TOK_LPAREN, import_item_list, ~'TOK_RPAREN)
      | apply_if($_mk_import_as, qualified_name, ~"as", xid)
      | apply_if($_mk_import_path, qualified_name)
    ]


fn $_mk_import_item(expr):
    name := car(expr)
    alias := cadr(expr)
    return $['item, name, alias]

#>  ```ebnf
#>    import_item     ::= identifier , [ "as" , identifier ] ;
#>  ```
fn [Parser] import_item():
    @accept apply_if($_mk_import_item, xid, opt($[~"as", xid]))

fn [Parser] import_item_list():
    @accept cons(import_item, many($[~'TOK_COMMA, import_item]))

#>  ```ebnf
#>    except_names    ::= identifier
#>                       | "(" , identifier , { "," , identifier } , ")" ;
#>  ```
fn [Parser] except_names():
    @accept $[
        $[~'TOK_LPAREN, cons(xid, many($[~'TOK_COMMA, xid])), ~'TOK_RPAREN]
      | cons(xid, many($[~'TOK_COMMA, xid]))
    ]


# (* ---------------------------------------------------------------------
#    4. Functions
#    --------------------------------------------------------------------- *)

# A missing annotation is (type auto), never nil (ast.md).
fn _auto_type(type_c):
    if type_c is nil:
        return $['type, 'auto]
    return type_c

# `[T, U]` is (dispatch (type T) (type U)); no class target is nil.
fn _mk_dispatch(names):
    if names is nil:
        return nil
    out := nil
    p := reverse(names)
    while p is pair:
        out = cons($['type, car(p)], out)
        p = cdr(p)
    return cons('dispatch, out)

# A co_param_list (`<- send, params`) as `[params, send]`.
fn _co_split(co_list):
    if co_list is nil:
        return [nil, $['type, 'auto]]
    return [caddr(co_list), _auto_type(cadr(co_list))]

fn $_mk_fn_def(expr):
    dispatch := car(expr)
    name := cadr(expr)
    params := caddr(expr)
    ret_type := car(cdddr(expr))
    body := cadr(cdddr(expr))
    return $['fn_def, name, _mk_dispatch(dispatch), params, _auto_type(ret_type), body]

#>  ```ebnf
#>    fn_def          ::= "fn" , [ class_target ] , identifier , "(" , [ param_list ] , ")" ,
#>                         [ "->" , type_constraint ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  fn message(greeting: str, name: str) -> str:
#>      return greeting + name
#>
#>  fn [int, str] message(what: str) -> str:   # multi-dispatch on (int, str)
#>      ...
#>  ```
#>
fn [Parser] fn_def():
    @accept apply_if($_mk_fn_def,
        ~'TOK_KW_FN, opt(class_target), xid,
        ~'TOK_LPAREN, opt(param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

#>  ```ebnf
#>    class_target    ::= "[" , identifier , { "," , identifier } , "]" ;   (* multi-dispatch receivers *)
#>  ```
fn [Parser] class_target():
    @accept $[~'TOK_LBRACKET, cons(xid, many($[~'TOK_COMMA, xid])), ~'TOK_RBRACKET]

#>  ```ebnf
#>    param_list      ::= param , { "," , param } ;
#>  ```
fn [Parser] param_list():
    @accept cons(param, many($[~'TOK_COMMA, param]))

#>  ```ebnf
#>    param           ::= var_positional | var_keyword | plain_param ;
#>  ```
fn [Parser] param():
    @accept $[var_positional | var_keyword | plain_param]

# A parameter is (name type default), `*rest` is (* rest type) and `**kw`
# is (** kw type) (ast.md: Scheme formals style).
fn $_mk_plain_param(expr):
    name := car(expr)
    type_c := cadr(expr)
    default := caddr(expr)
    return $[name, _auto_type(type_c), default]

#>  ```ebnf
#>    plain_param     ::= identifier , [ ":" , type_constraint ] , [ "=" , expression ] ;
#>  ```
fn [Parser] plain_param():
    @accept apply_if($_mk_plain_param,
        xid, opt($[~'TOK_COLON, type_expression]), opt($[~'TOK_EQUAL, expression]))

fn $_mk_var_positional(expr):
    return $['*, expr, $['type, 'auto]]

#>  ```ebnf
#>    var_positional  ::= "*" , identifier ;
#>  ```
fn [Parser] var_positional():
    @accept apply_if($_mk_var_positional, ~'TOK_MUL, xid)

fn $_mk_var_keyword(expr):
    return $['**, expr, $['type, 'auto]]

#>  ```ebnf
#>    var_keyword     ::= "**" , identifier ;
#>  ```
fn [Parser] var_keyword():
    @accept apply_if($_mk_var_keyword, ~'TOK_EXPONENT, xid)

# (* ---------------------------------------------------------------------
#    5. Coroutines
#    --------------------------------------------------------------------- *)

# (co_def name dispatch params send ret body): the send type is a field of
# its own (ast.md), no co_params wrapper.
fn $_mk_co_def(expr):
    dispatch := car(expr)
    name := cadr(expr)
    parts := _co_split(caddr(expr))
    ret_type := car(cdddr(expr))
    body := cadr(cdddr(expr))
    return $['co_def, name, _mk_dispatch(dispatch), parts[0], parts[1], _auto_type(ret_type), body]

#>  ```ebnf
#>    co_def          ::= "co" , [ class_target ] , identifier , "(" , [ co_param_list ] , ")" ,
#>                         [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] co_def():
    @accept apply_if($_mk_co_def,
        ~'TOK_KW_CO, opt(class_target), xid,
        ~'TOK_LPAREN, opt(co_param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_co_params(expr):
    send_type := car(expr)
    params := cadr(expr)
    return $['co_params, send_type, params]

fn $_mk_co_params_plain(expr):
    return $['co_params, nil, expr]

#>  ```ebnf
#>    co_param_list   ::= "<-" , type_constraint , [ "," , param_list ]   (* send-type, not a param *)
#>                       | param_list ;
#>  ```
fn [Parser] co_param_list():
    @accept $[
        apply_if($_mk_co_params, ~'TOK_LARROW, type_expression, opt($[~'TOK_COMMA, param_list]))
        | apply_if($_mk_co_params_plain, param_list)
    ]


#> ## Classes

# (class_def name base body): one base or nil (ast.md: single inheritance).
fn $_mk_class_def(expr):
    name := car(expr)
    base := cadr(expr)
    body := caddr(expr)
    return $['class_def, name, base, body]

#>  ```ebnf
#>    class_def       ::= "class" , identifier , [ "(" , [ qualified_name ] , ")" ] , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  class person:
#>      slot name: str
#>
#>  class family_member(person):
#>      slot relation: str
#>  ```
#>
fn [Parser] class_def():
    @accept apply_if($_mk_class_def,
        ~'TOK_KW_CLASS, xid, opt($[~'TOK_LPAREN, opt(qualified_name), ~'TOK_RPAREN]), block)

# (slot_def name type init body) (syntax.md G3): a virtual slot's body is
# its subscope block, one form or (do ...), defining `fn getter`/`fn
# setter`; a data slot's body is nil.
fn $_mk_slot_def(expr):
    name := car(expr)
    type_c := cadr(expr)
    init := caddr(expr)
    body := car(cdddr(expr))
    if type_c is nil:
        type_c = $['type, 'auto]
    return $['slot_def, name, type_c, init, body]

#>  ```ebnf
#>    slot_def        ::= "slot" , identifier , [ ":" , type_constraint ] ,
#>                         [ "=" , expression ] , [ block ] ;     (* block: a virtual slot (G3) *)
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  slot name: str = "John Doe"
#>
#>  slot age: int:
#>      fn getter(): now() - this.birth_timestamp
#>      fn setter(age: int): this.birth_timestamp = now() - age
#>  ```
#>
fn [Parser] slot_def():
    @accept apply_if($_mk_slot_def,
        ~'TOK_KW_SLOT, xid,
        opt($[~'TOK_COLON, type_expression]),
        opt($[~'TOK_EQUAL, expression]),
        opt(block))

#> ## Expressions

fn $_mk_values(expr):
    if cdr(expr) != nil:
        return cons('tuple, expr)
    return car(expr)

fn $_mk_tuple(expr):
    return cons('tuple, expr)

#>  ```ebnf
#>    tuple_expression ::= list_expression ;        (* comma = tuple *)
#>  ```
fn [Parser] tuple_expression():
    @accept apply_if($_mk_values, list_expression)

# A parenthesized expression list. Unlike tuple_expression, a trailing comma
# is significant here: `(x,)` is a one-element tuple, `(x)` is just x
# (list_expression discards the trailing comma, which is right for the
# bare `return a, b` form but wrong inside parens).
fn $_mk_paren(expr):
    items := car(expr)
    if (cdr(items) != nil) or (cadr(expr) != nil):
        return cons('tuple, items)
    return car(items)

fn [Parser] paren_expression():
    @accept apply_if($_mk_paren,
        $[cons(expression, many($[~'TOK_COMMA, expression])),
          opt($[~'TOK_COMMA, push('trailing)])])

fn $_mk_try(expr):
    return $['try, expr]

fn $_try_fn(expr):
    if car(expr):
        return $['try, cdr(expr)]
    return cdr(expr)

#>  ```ebnf
#>    try_expr ::= ( "try", catch_expr ) | catch_expr;
#>  ```
#>
#>  _Example_: `file := try open('badfile.txt')` (an error return propagates immediately)
#>
fn [Parser] expression():
    @accept $[apply_if($_mk_try, $[~'TOK_KW_TRY, catch_expr]) | catch_expr]

fn $_catch_fn(expr):
    base := car(expr)
    handler := cadr(expr)
    if handler == nil:
        return base
    return $['catch, base, handler]

#>  ```ebnf
#>    catch_expr ::= logical_expr , [ "catch" , expression ] ;
#>  ```
#>
#>  _Example_: `file := open('badfile.txt') catch open('goodfile.txt')`
#>
fn [Parser] catch_expr():
    @accept apply_if($_catch_fn, or_expr, opt($[~'TOK_KW_CATCH, expression]))

fn $_mk_or(expr):
    rest := cdr(expr)
    if rest == nil:
        return car(expr)
    return cons('or, expr)

#>  ```ebnf
#>    or_expr ::= logical_expr , { "or", logical_expr }
#>  ```
fn [Parser] or_expr():
    @accept apply_if($_mk_or, cons(and_expr, many(~'TOK_KW_OR, and_expr)))

fn $_mk_and(expr):
    rest := cdr(expr)
    if rest == nil:
        return car(expr)
    return cons('and, expr)

#>  ```ebnf
#>    and_expr ::= or_expr , { "and" , or_expr }
#>  ```
fn [Parser] and_expr():
    @accept apply_if($_mk_and, cons(not_expr, many(~'TOK_KW_AND, not_expr)))

fn $_mk_not(expr):
    $['not, expr]

#>  ```ebnf
#>    not_expr ::= "not" , not_expr | comparison
#>  ```
fn [Parser] not_expr():
    @accept $[apply_if($_mk_not, ~'TOK_KW_NOT, not_expr) | comparison]

# Comparison

fn $_mk_is(expr):
    if cadr(expr):
        return $['not, $['is, car(expr), caddr(expr)]]
    return $['is, car(expr), caddr(expr)]

fn $_mk_comparison(expr):
    # Comparisons are ordinary non-associative binary operators, headed by
    # the operator like the others: `(< lhs rhs)` (ast.md R5).
    $[cadr(expr), car(expr), caddr(expr)]

fn $_mk_in(expr):
    if cadr(expr):
        return $['not, $['in, car(expr), caddr(expr)]]
    return $['in, car(expr), caddr(expr)]

#>  ```ebnf
#>    comparison      ::= binary_expr , "is" , [ "not" ] , type_constraint
#>                       | binary_expr , [ "not" ] , "in" , binary_expr
#>                       | binary_expr , [ comp_op , binary_expr ] ;
#>    comp_op         ::= "<=" | ">=" | "<=>" | "<" | ">" | "==" | "!=" ;
#>  ```
fn [Parser] comparison():
    @accept $[
        apply_if($_mk_is, $[binary_expr, ~'TOK_KW_IS, bool('TOK_KW_NOT), type_expression])
        | apply_if($_mk_comparison, $[binary_expr, comp_op, binary_expr])
        | apply_if($_mk_in, $[binary_expr, bool('TOK_KW_NOT), ~'TOK_KW_IN, binary_expr])
        | binary_expr
    ]

fn [Parser] comp_op():
    @accept $[ value('<=, 'TOK_LE) |
               value('>=, 'TOK_GE) |
               value('<=>, 'TOK_SPACESHIP) |
               value('<, 'TOK_LT) |
               value('>, 'TOK_GT) |
               value('==, 'TOK_DEQUAL) |
               value('!=, 'TOK_NE) ]

# Binary Op: builds the $[op, lhs, rhs] tree from the flat
# (operand op operand op ...) sequence binary_expr()'s grammar rule
# produces, matching mk_binop/s_binop_lhs/s_binop_rhs's assumed shape
# (ast.wy). The rule itself is flat, so precedence is applied here, tightest
# last (wyrm.gram's bitwise_or / xor / and / shift / additive / mult tiers);
# every tier is left-associative.
fn _binop_prec(op) -> int:
    if op == '|:
        return 1
    if op == '^:
        return 2
    if op == '&:
        return 3
    if (op == '<<) or (op == '>>):
        return 4
    if (op == '+) or (op == '-):
        return 5
    return 6

# Pop the innermost operator and its two operands, push the `(op l r)` node.
fn _reduce_binop(operands, ops):
    n := len(ops)
    m := len(operands)
    node := $[ops[n - 1], operands[m - 2], operands[m - 1]]
    ops ! resize(n - 1)
    operands ! resize(m - 2)
    operands ! append(node)

fn $_binary_expr(expr):
    rest := cdr(expr)
    if rest == nil:
        return car(expr)
    operands := [car(expr)]
    ops := []
    while rest != nil:
        op := car(rest)
        while (len(ops) > 0) and (_binop_prec(ops[len(ops) - 1]) >= _binop_prec(op)):
            _reduce_binop(operands, ops)
        ops ! append(op)
        operands ! append(cadr(rest))
        rest = cddr(rest)
    while len(ops) > 0:
        _reduce_binop(operands, ops)
    return operands[0]

#>  ```ebnf
#>    binary_expr     ::= unary_expr , { binary_op , unary_expr } ;
#>    binary_op       ::= "|" | "^" | "&" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" ;
#>  ```
fn [Parser] binary_expr():
    @accept apply_if($_binary_expr, cons(unary_expr, manyflat($[binary_op, unary_expr])))

fn [Parser] binary_op():
    @accept $[ value('|, 'TOK_OR)
            | value('^, 'TOK_XOR)
            | value('&, 'TOK_AND)
            | value('<<, 'TOK_LSHIFT)
            | value('>>, 'TOK_RSHIFT)
            | value('+, 'TOK_PLUS)
            | value('-, 'TOK_MINUS)
            | value('*, 'TOK_MUL)
            | value('/, 'TOK_DIV)
            | value('%, 'TOK_MOD) ]

# unary_expr

fn $_mk_neg(expr):
    return $['neg, expr]

fn $_mk_pos(expr):
    return $['pos, expr]

fn $_mk_invert(expr):
    return $['~, expr]

#>  ```ebnf
#>    unary_expr      ::=
#>                       | ( "-" | "+" | "~" | "not" ) , unary_expr
#>                       | power_expr ;
#>  ```
fn [Parser] unary_expr():
    @accept $[
        apply_if($_mk_neg, $[~'TOK_MINUS, unary_expr])
        | apply_if($_mk_pos, $[~'TOK_PLUS, unary_expr])
        | apply_if($_mk_invert, $[~'TOK_TILDE, unary_expr])
        | apply_if($_mk_not, $[~'TOK_KW_NOT, unary_expr])
        | power_expr
    ]

fn $_mk_exp(expr):
    cons('**, expr)

#>  ```ebnf
#>    power_expr      ::= postfix_expr , [ "**" , unary_expr ] ;       (* right-assoc *)
#>  ```
fn [Parser] power_expr():
    @accept $[
        apply_if($_mk_exp, $[postfix_expr, ~'TOK_EXPONENT, unary_expr])
        | postfix_expr
    ]

# postfix

fn $_mk_postfix(expr):
    ops := cdr(expr)
    if ops == nil:
        return car(expr)
    current := car(expr)
    remaining := ops
    while remaining != nil:
        op := car(remaining)
        op_kind := car(op)
        if op_kind == 'call_op:
            # (apply callee arg...): the arguments are spliced (ast.md R5).
            current = cons('apply, cons(current, cdr(op)))
        elif op_kind == 'index_op:
            current = $['index, current, cadr(op)]
        elif op_kind == 'attr_op:
            current = $['attr, current, cadr(op)]
        elif op_kind == 'message_op:
            # `recv ! name` binds: (bind_msg recv name). With parentheses it
            # is also applied: (apply (bind_msg recv name) arg...).
            # cddr(op) is $[args_or_nil, marker]; the marker tells
            # `recv ! name()` (a send, no arguments) from `recv ! name`.
            parts := cddr(op)
            current = $['bind_msg, current, cadr(op)]
            if cadr(parts) == 'send:
                current = cons('apply, cons(current, car(parts)))
        else:
            # Unknown postfix op, return original
            return expr
        remaining = cdr(remaining)
    return current

#>  ```ebnf
#>    postfix_expr    ::= primary , { postfix_op } ;
#>    postfix_op      ::= call_op | index_op | attr_op | message_op ;
#>  ```
#                      (* "::" is qualified_name's job, not a postfix op -
#                         f()::x and a[0]::x are not valid. *)
#>  ```ebnf
#>    call_op         ::= "(" , [ arg_list ] , ")" ;
#>    index_op        ::= "[" , expression , "]" ;
#>    attr_op         ::= "." , identifier ;
#>    message_op      ::= "!" , identifier , [ "(" , [ arg_list ] , ")" ] ;
#>  ```

# `if`/`while`/`for` are block-form primaries: they end at a DEDENT, and no
# NEWLINE token follows it. Letting postfix ops chain onto them would glue a
# next line that starts with `(` or `[` onto the block as a call/index
# (`for ...: <block>` then `(this.x) ! append(v)` parsed as one expression).
# A block-form primary therefore takes no postfix ops; parenthesize it to
# chain (`(if a: b else: c).x`).
fn [Parser] block_primary():
    @accept $[if_stmt | while_stmt | for_stmt]

fn [Parser] postfix_expr():
    @accept $[
        block_primary
      | apply_if($_mk_postfix, cons(primary, many(postfix_op)))
    ]

fn [Parser] postfix_op():
    @accept $[call_op | index_op | attr_op | message_op]

fn [Parser] call_op():
    @accept  $[~'TOK_LPAREN, cons(push('call_op), opt(arg_list)), ~'TOK_RPAREN]

fn [Parser] index_op():
    @accept $[~'TOK_LBRACKET, push('index_op), expression, ~'TOK_RBRACKET]

fn [Parser] attr_op():
    @accept $[~'TOK_DOT, push('attr_op), xid]

fn $_mk_message_bound(expr):
    # expr is the bare selector name: `recv ! name`.
    return $['message_op, expr, nil, 'bound]

fn [Parser] message_op():
    @accept $[
        $[~'TOK_BANG, cons(push('message_op), cons(xid, $[~'TOK_LPAREN, opt(arg_list), ~'TOK_RPAREN, push('send)]))]
      | apply_if($_mk_message_bound, $[~'TOK_BANG, xid])
    ]

#>  ```ebnf
#>    arg_list        ::= argument , { "," , argument } ;
#>    argument        ::= expression
#>                       | identifier , "=" , expression          (* keyword argument *)
#>                       | "*" , expression                       (* spread positional *)
#>                       | "**" , expression ;                    (* spread keyword *)
#>  ```
# A trailing comma is allowed, as in list literals: `f(a, b,)`.
fn [Parser] arg_list():
    @accept $[cons(argument, many($[~'TOK_COMMA, argument])), ~opt('TOK_COMMA)]

fn $_mk_kwarg(expr):
    return $['kwarg, car(expr), cadr(expr)]

fn $_mk_spread(expr):
    return $['spread, expr]

fn $_mk_spread_kw(expr):
    return $['spread_kw, expr]

# Epic 8 M3 finding: this was `@accept expression` only - the documented
# keyword/spread forms below were never implemented, so `f(x=1)` failed to
# match `argument` at all and (since arg_list is wrapped in `opt(...)` by
# every caller) silently degraded to a zero-argument call instead of
# faulting. `**expr` (TOK_EXPONENT) is tried before `*expr` (TOK_MUL) - the
# tokens can't collide, but keeping the longer-lexeme form first matches the
# convention elsewhere in this file. kwarg/spread/spread_kw are wyrm-only
# node kinds: pypoc's sexpr.py 'call Row is just (func, args) with no
# separate keyword-argument concept exposed at this layer (DIVERGES).
fn [Parser] argument():
    @accept $[
        apply_if($_mk_kwarg, $[xid, ~'TOK_EQUAL, expression])
        | apply_if($_mk_spread_kw, $[~'TOK_EXPONENT, expression])
        | apply_if($_mk_spread, $[~'TOK_MUL, expression])
        | expression
    ]


#>  ```ebnf
#>    primary         ::= literal
#>                       | qualified_name
#>                       | "(" , tuple_expression , ")"
#>                       | "(" , ")"                              (* empty tuple *)
#>                       | array_literal
#>                       | pair_literal
#>                       | dict_literal
#>                       | "return" , [ expression ]
#>                       | "yield" , "from" , expression
#>                       | "yield" , [ expression ]
#>                       | "break"
#>                       | "continue"
#>                       | "pass"
#>                       | if_stmt
#>                       | while_stmt
#>                       | for_stmt
#>                       | lambda_expr
#>                       | co_lambda_expr
#>                       | anonymous_class
#>                       | do_expr ;
#>  ```
#>  ```ebnf
#>    decorated_expr  ::= decorator , { decorator } , expression ;
#>  ```
#>
#>  _Example_: `v := @accept 'TOK_XID` (see decorator in parser.wy)
#>
fn [Parser] decorated_expr():
    @accept apply_if($_mk_stmt_line, cons(decorator, many(decorator)), expression)

fn [Parser] primary():
    @accept $[ literal
             | decorated_expr
             | qualified_name
             | $[~'TOK_LPAREN, paren_expression, ~'TOK_RPAREN]
             | array_literal
             | pair_literal
             | dict_literal
             | apply_if(_mk_atom, $[~'TOK_LPAREN, ~'TOK_RPAREN, push('tuple)])

             | return_stmt
             | yield_stmt
             | break_stmt
             | continue_stmt
             | pass_stmt
             | if_stmt
             | while_stmt
             | for_stmt
             | lambda_expr
             | co_lambda_expr
             | anonymous_class
             | do_expr
             ]

#>  ```ebnf
#>    literal         ::= nil_literal
#>                       | number_literal
#>                       | bool_literal
#>                       | string_literal
#>                       | symbol_literal
#>                       | char_literal
#>                       | "..." ;
#>  ```
fn [Parser] literal():
    @accept $[ nil_literal
               | number_literal
               | bool_literal
               | string_literal
               | symbol_literal
               | char_literal
               | apply_if(_mk_atom, value('ellipsis, 'TOK_ELLIPSIS))
             ]

fn $_mk_array(expr):
    cons('array, expr)

#>  ```ebnf
#>    array_literal   ::= "[" , [ list_expression ] , "]" ;
#>  ```
#>
#>  _Example_: `[1, 2, 3, 4]`
#>
fn [Parser] array_literal():
    @accept $[
        apply_if(_mk_atom, value('array, $[~'TOK_LBRACKET, ~'TOK_RBRACKET]))
        | apply_if($_mk_array, $[~'TOK_LBRACKET, list_expression, ~'TOK_RBRACKET])
    ]

fn $_mk_list(expr):
    cons('list, expr)

#>  ```ebnf
#>    pair_literal    ::= "$[" , [ list_expression ] , "]" ;             (* cons-list primitive *)
#>  ```
#>
#>  _Example_: `$[]` (empty), `$['a]` (single element), `$[1, 2, 3]` (proper pair list)
#>
fn [Parser] pair_literal():
    @accept $[
        apply_if(_mk_atom, value('list, $[~'TOK_LBRACKET_S, ~'TOK_RBRACKET]))
        | apply_if($_mk_list, $[~'TOK_LBRACKET_S, list_expression, ~'TOK_RBRACKET])
    ]

#>  ```ebnf
#>    list_expression ::= expression , { "," , expression } , [ "," ] ;
#>  ```
fn [Parser] list_expression():
    @accept $[cons(expression, many($[~'TOK_COMMA, expression])), ~opt('TOK_COMMA)]

fn $_mk_dict(expr):
    cons('dict, expr)

#>  ```ebnf
#>    dict_literal    ::= "{" , [ dict_pair , { "," , dict_pair } ] , "}" ;
#>    dict_pair       ::= expression , ":" , expression ;
#>  ```
#>
#>  _Example_: `{ "Name": 15 }`
#>
fn [Parser] dict_literal():
    @accept $[
        apply_if(_mk_atom, value('dict, $[~'TOK_LBRACE, ~'TOK_RBRACE]))
        | apply_if($_mk_dict,
            $[~'TOK_LBRACE, cons(dict_pair, many($[~'TOK_COMMA, dict_pair])), ~opt('TOK_COMMA), ~'TOK_RBRACE]
          )
    ]

fn [Parser] dict_pair():
    @accept $[expression,
        ~expect("expected ':' in dictionary entry", 'TOK_COLON),
         expect("dictionary value", expression)]

fn $_mk_lambda(expr):
    params := car(expr)
    ret_type := cadr(expr)
    body := caddr(expr)
    return $['lambda, params, _auto_type(ret_type), body]

#>  #### Anonymous Closures and Types
#>  
#>  These provide a way to create an anonymous class or function. Note that
#>  anonymous classes *must* provide their messages internally as message
#>  definitions require the lexical class name.
#>

#>  ```ebnf
#>    lambda_expr     ::= "fn" , "(" , [ param_list ] , ")" , [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] lambda_expr():
    @accept apply_if($_mk_lambda,
        ~'TOK_KW_FN, ~'TOK_LPAREN, opt(param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_co_lambda(expr):
    parts := _co_split(car(expr))
    ret_type := cadr(expr)
    body := caddr(expr)
    return $['co_lambda, parts[0], parts[1], _auto_type(ret_type), body]

#>  ```ebnf
#>    co_lambda_expr  ::= "co" , "(" , [ co_param_list ] , ")" , [ "->" , type_constraint ] , block ;
#>  ```
fn [Parser] co_lambda_expr():
    @accept apply_if($_mk_co_lambda,
        ~'TOK_KW_CO, ~'TOK_LPAREN, opt(co_param_list), ~'TOK_RPAREN,
        opt($[~'TOK_RARROW, type_expression]), block)

fn $_mk_class_expr(expr):
    bases := car(expr)
    body := cadr(expr)
    return $['class_expr, bases, body]

#>  ```ebnf
#>  anonymous_class ::= "class" , [ "(" , [ qualified_name ] , ")" ] , block ;
#>  ```
#>
#>  _Example_:
#>  ```wyrm
#>  AnonPerson := class() { slot name: str; slot age: int; }
#>
#>  # Equivalent
#>  class NamedPerson:
#>      slot name: str
#>      slot age: int
#
#>  ```
fn [Parser] anonymous_class():
    @accept apply_if($_mk_class_expr,
        ~'TOK_KW_CLASS, opt($[~'TOK_LPAREN, opt(qualified_name), ~'TOK_RPAREN]), block)

#>  ```ebnf
#>    do_expr         ::= "do" , block ;
#>  ```
#>
#>  _Example_:
#>
#>  ```wyrm
#>  complex_answer := do:
#>      step_1()
#>      step_2()
#>      10
#>  # complex_answer == 10
#>  ```
#>
# `do:` is always `(do s...)`, one statement or more (ast.md R2).
fn [Parser] do_expr():
    @accept apply_if(_mk_do, ~'TOK_KW_DO, block_stmts)

fn _mk_do(stmts):
    return cons('do, stmts)


# (* ---------------------------------------------------------------------
#    10. Operator precedence
#    --------------------------------------------------------------------- *)

# (*   tuple_expr        ,               (loosest: builds a tuple)
#      assign_expr       ?=  try/catch
#      logical_expr      or
#                         and             (tighter than or)
#      not_expr          not              (prefix; own tier)
#      comparison        is  <=  >=  <=>  <  >  ==  !=  in   (non-associative - no chaining)
#      binary_expr       |
#                         ^
#                         &
#                         <<  >>
#                         +   -
#                         *   /   %
#      unary_expr        -  +  ~  not     (prefix; "not" here is a second,
#                                           tighter tier from the one above -
#                                           see the note at unary_expr)
#      power_expr        **               (right-associative)
#      postfix_expr       .  ()  []  !  ::   (tightest)

#    All binary_expr and logical_expr levels are left-associative. *)
