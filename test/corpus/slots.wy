# Plan C9b (syntax.md G3): a virtual slot is a subscope defining fn getter
# and/or fn setter; without a setter it is read-only. (`with` is still a
# keyword in wyrm's tokenizer, so this no longer shows it as a name.)
class Person:
    slot birth: int = 1990
    slot age:
        fn getter(): 2026 - this.birth
        fn setter(years: int): this.birth = 2026 - years
    slot _id: int = 7
    slot id: int:
        fn getter(): this._id

p := Person()
println(p.age, p.id)
p.age = 30
println(p.birth, p.age)
