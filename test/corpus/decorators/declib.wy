# The decorator half of the decorator fixture, written in wyrm.
#
# A decorator is a message on TreeBase: it receives the tree of whatever it
# decorates and answers the tree to compile instead. Decorators run at compile
# time (doc/llm-bytecode.md 7.2), so by the time the bytecode compiler lowers
# the importing module, no `Decorated` node is left in it.
fn nth(node, n) -> TreeBase:
    i := 0
    while i < n:
        node = cdr(node)
        i = i + 1
    return car(node)

# A definition is (fn_def name dispatch params ret body) (the project's
# design/ast.md), with the body one form or (do s...).
_FN_DEF_BODY := 5

# Answers its subject unchanged - the identity decorator.
fn [TreeBase] unchanged():
    return this

# Prepends a `println` to a definition's body: the result is
# (do announce body).
fn [TreeBase] traced(label):
    s := sexpr(this)
    announce := $['apply, 'println, $['str, label]]
    body := $['do, announce, nth(s, _FN_DEF_BODY)]
    return $['fn_def, nth(s, 1), nth(s, 2), nth(s, 3), nth(s, 4), body]
