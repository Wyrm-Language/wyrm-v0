# Epic 7 M5 exit criterion: the `header` section of a module image built by
# hand with `bytes` methods, as CBOR (project design/wire_encoding.md) since
# the image format moved off BSON. The C VM's std::io exposes raw POSIX
# natives directly (open/write/close on an int handle).
import std::io

out := bytes(0)

# map(3): {"n": "hello", "g": 2, "l": 3}, keys in the order the compiler
# writes them. 0xA3 is the map header for three pairs.
out!append(163)

# "n": "hello"  (text(1) "n", text(5) "hello")
out!append(97)
out!append("n")
out!append(101)
out!append("hello")

# "g": 2  (the unsigned integer 2 is the single byte 0x02)
out!append(97)
out!append("g")
out!append(2)

# "l": 3
out!append(97)
out!append("l")
out!append(3)

handle := std::io::open("bytes_header.bin", "wb")

handle!write(out)

handle!close()
