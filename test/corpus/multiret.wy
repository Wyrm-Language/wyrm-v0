# `return a, b` is one value, a tuple: a caller gets the whole tuple, and
# there are no result windows.
fn divmod(a, b):
    return a / b, a % b

fn shift(a, b, c):
    return b, c, a

fn only_one(a, b):
    var first = divmod(a, b)
    return first

fn passthrough(a, b, c):
    var first = shift(a, b, c)
    return first

println(divmod(17, 5))
println(only_one(17, 5))
println(passthrough(1, 2, 3))
