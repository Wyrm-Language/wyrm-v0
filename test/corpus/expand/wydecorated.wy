# Epic 10a M3/M4: decorators/decorated.wy for the port's tree shapes; same
# behaviour and the same output (wydecorated.out == decorators/decorated.out).
import static wydeclib

@unchanged()
fn plain(value):
    return value * 2

@traced("calling loud")
fn loud(value):
    return value + 1

println(plain(21))
println(loud(1))
