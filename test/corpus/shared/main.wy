# design/modules.md M2: an imported name is the exporter's binding, not a
# copy. Every spelling below reads counter's own `count`, after `bump`
# assigned it twice.
import counter
import counter::*
import counter::(bump as step, count as c)
import tools::gauge

bump()
step()
println(count)
println(c)
println(counter::count)
# `gauge::LEVEL` names tools::gauge's LEVEL: the leaf an import binds.
println(gauge::LEVEL)
