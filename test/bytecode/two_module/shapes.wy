# The class library half of the cross-module fixture: instance methods stay
# registered on this module's message identities; the importer dispatches on
# them through adoption (src/link.c wy_link_adopt_messages).
class Shape:
    slot name: str = "shape"
    slot sides: int = 0

    fn init(label, count):
        this.name = label
        this.sides = count

    fn describe():
        return this.name

    fn corners():
        return this.sides

class Square(Shape):
    slot size: int = 1

    fn init(edge):
        this.name = "square"
        this.sides = 4
        this.size = edge

    fn area():
        return this.size * this.size
