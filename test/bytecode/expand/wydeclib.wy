# Epic 10a M3/M4: the decorator half of wydecorated.wy, written against the
# self-hosted parser's tree shapes (pypoc's decorators/declib.wy builds
# pypoc's 8-field 'fn node; the port's parser produces
# `$['fn_def, name, dispatch, params, ret_type, body]` with pair lists and
# bare-symbol identifiers). Compiled by the port only (scripts/
# run_corpus_sweep.py), never by pypoc.
fn nth(node, n):
    i := 0
    while i < n:
        node = cdr(node)
        i = i + 1
    return car(node)

# Answers its subject unchanged - the identity decorator.
fn [TreeBase] unchanged():
    return this

# Prepends a `println` to a definition's body.
fn [TreeBase] traced(label):
    s := sexpr(this)
    announce := $['expr_stmt, $['call, 'println, cons($['str, label], nil)]]
    body := cons(announce, nth(s, 5))
    return $['fn_def, nth(s, 1), nth(s, 2), nth(s, 3), nth(s, 4), body]
