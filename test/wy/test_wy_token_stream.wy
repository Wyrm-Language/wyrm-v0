import wyrm::tokenizer as tok
import wyrm::tokenizer::*
import std::io::*;

# Render a token list as a compact space separated string of kinds.
# INDENT / DEDENT / NEWLINE / STMT_END are abbreviated to keep expectations
# readable; `if` and `else` both render as k.
fn render(tokens: list) -> str:
    out := ""
    for token in tokens:
        name := ""
        if token.kind is error:
            name = "ERR"
        elif token.kind == 'TOK_INDENT:
            name = ">"
        elif token.kind == 'TOK_DEDENT:
            name = "<"
        elif token.kind == 'TOK_NEWLINE:
            name = "."
        elif token.kind == 'TOK_STMT_END:
            name = "|"
        elif token.kind == 'TOK_SEMICOLON:
            name = ";"
        elif token.kind == 'TOK_COLON:
            name = ":"
        elif token.kind == 'TOK_KW_IF or token.kind == 'TOK_KW_ELSE:
            name = "k"
        elif token.kind == 'TOK_END:
            name = "$"
        elif token.kind == 'TOK_XID:
            name = "x"
        else:
            name = "?"
        out = out + name
    return out

fn check(name: str, buffer: str, expected: str):
    defer on error:
        println("FAIL on error:", name)
        exit(1)

    stream := tok::TokenStream(buffer)
    tokens := try stream ! scan()
    found := render(tokens)
    if found != expected:
        println("FAIL", name, "- expected", expected, "got", found)
        exit(1)
    println("PASS", name)


println("Token Stream Tests")

check("empty", "", "$")
check("single line", "a\n", "x.$")
check("no trailing newline", "a", "x.$")
check("blank lines collapse", "a\n\n\n b\n", "x.>x.<|$")
check("simple indent", "a\n b\n", "x.>x.<|$")
check("indent and dedent", "a\n b\nc\n", "x.>x.<|x.$")
check("nested indent", "a\n b\n  c\nd\n", "x.>x.>x.<|<|x.$")
check("multi dedent to middle", "a\n b\n  c\n d\n", "x.>x.>x.<|x.<|$")
check("comment only line no indent", "a\n    # note\nb\n", "x.x.$")
check("dedent at eof", "a\n b\n  c\n", "x.>x.>x.<|<|$")
check("group suppresses newline", "f(\na\n)\n", "x?x?.$")
check("group suppresses indent", "f(\n        a\n)\n", "x?x?.$")
check("line starting with close paren", "f(\na\n)\nb\n", "x?x?.x.$")
check("tab vs space mismatch", "a\n\tb\n        c\n", "x.>x.ERRx.<|$")
check("bad unindent", "a\n    b\n  c\n", "x.>x.<|ERRx.$")
check("semicolon separator", "a; b\n", "x;x.$")
check("semicolon at end of line", "a;\nb\n", "x;.x.$")
check("semicolon only line", "a\n;\nb\n", "x.;.x.$")
check("semicolon in group", "f(a;\nb)\n", "x?x;x?.$")
check("one-line if else", "if a: b; else: c\n", "kx:x;k:x.$")
check("else after one-line block", "if a: b\nelse: c\n", "kx:x.k:x.$")
check("else after indented block", "if a:\n b\nelse:\n c\n", "kx:.>x.<|k:.>x.<|$")

println("...Done")
