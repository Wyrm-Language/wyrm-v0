import wyrm::parser::parser::*
import wyrm::ast::*
import std::io::*

fn check(what: str, got, want):
    if got == want:
        println("PASS " + what)
    else:
        println("FAIL " + what + " got " + str(got))


p_xid_1 := Parser("std")
r_xid_1 := p_xid_1!xid()
check("basic xid", r_xid_1, "std")

p_xid_2 := Parser("std.asdf")
r_xid_2 := p_xid_2!xid()
check("basic xid split on operator", r_xid_2, "std")

p_xid_3 := Parser("$_ope1n$.asdf")
r_xid_3 := p_xid_3!xid()
check("xid includes $", r_xid_3, "$_ope1n$")

p_import_1 := Parser("import std::io")
r_import_1 := p_import_1!import_stmt()
check("import matches", r_import_1 != 'NO_MATCH, true)

p_import_2 := Parser("import std::io 12345")
r_import_2 := p_import_2!import_stmt()
check("import with garbage", r_import_2 is error, true)

