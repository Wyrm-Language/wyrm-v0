# Basic tuple
check("tuple expr", len(Parser("a, b, c")!expression()), 4)

# Proper double try
p_tuple_dtry := Parser("try a, try b")!expression()
check("double try tuple", 
    len(p_tuple_dtry) == 3 
    and cadr(cadr(p_tuple_dtry)) == "a"
    and cadr(caddr(p_tuple_dtry)) == "b",
    true)

check("try expr", car(Parser("try a")!expression()), 'try)


