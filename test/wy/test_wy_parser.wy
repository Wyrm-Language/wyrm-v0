# print("basic array", Parser("[]")!expression(), "\n")
# print("basic array 2", Parser("[a]")!expression(), "\n")
# print("basic array 2", Parser("[a, b, [c, [e]]]")!expression(), "\n")

# print("dictionary", Parser("{\"key\": 5, \"key2\": 10}")!expression(), "\n")

r_do := Parser("do: 5")!expression()
check("do expr kind", car(r_do), 'do)
check("do expr body", is_num_tok(cadr(r_do)), true)

check("return bare", Parser("return")!expression(), $[ 'return, nil ])
check("return val", Parser("return a")!expression(), $[ 'return, "a" ])
check("yield bare", Parser("yield")!expression(), $[ 'yield, nil ])
check("yield val", Parser("yield a")!expression(), $[ 'yield, "a" ])
check("yield from", Parser("yield from a")!expression(), $[ 'yield_from, "a" ])
check("break", Parser("break")!expression(), 'break)
check("continue", Parser("continue")!expression(), 'continue)
check("pass", Parser("pass")!expression(), 'pass)
check("if", Parser("if a: b")!expression(), $[ 'if, "a", "b", nil, nil ])
check("if else", Parser("if a: b else: c")!expression(), $[ 'if, "a", "b", nil, "c" ])
check("while", Parser("while a: b")!expression(), $[ 'while, "a", "b" ])
check("for", Parser("for x in a: b")!expression(), $[ 'for, "x", "a", "b", nil ])

# var statement tests
check("var simple", Parser("var x")!stmt_line(), $[ 'var, $[ $[ "x", nil ] ] ])
check("var with type", Parser("var x: int")!stmt_line(), $[ 'var, $[ $[ "x", $[ "int" ] ] ] ])

r_var_init := Parser("var x = 5")!stmt_line()
check("var with init target", $[ car(r_var_init), cadr(r_var_init) ], $[ 'var, $[ $[ "x", nil ] ] ])
check("var with init value", is_num_tok(caddr(r_var_init)), true)

r_var_type_init := Parser("var x: int = 5")!stmt_line()
check("var with type and init target", $[ car(r_var_type_init), cadr(r_var_type_init) ],
    $[ 'var, $[ $[ "x", $[ "int" ] ] ] ])
check("var with type and init value", is_num_tok(caddr(r_var_type_init)), true)

check("var multiple", Parser("var x, y")!stmt_line(),
    $[ 'var, $[ $[ "x", nil ], $[ "y", nil ] ] ])

r_var_multi_init := Parser("var x, y = 5")!stmt_line()
check("var multiple with init target", $[ car(r_var_multi_init), cadr(r_var_multi_init) ],
    $[ 'var, $[ $[ "x", nil ], $[ "y", nil ] ] ])
check("var multiple with init value", is_num_tok(caddr(r_var_multi_init)), true)

r_var_mixed := Parser("var x: int, y, z: str = 10")!stmt_line()
check("var multiple mixed target", $[ car(r_var_mixed), cadr(r_var_mixed) ],
    $[ 'var, $[ $[ "x", $[ "int" ] ], $[ "y", nil ], $[ "z", $[ "str" ] ] ] ])
check("var multiple mixed value", is_num_tok(caddr(r_var_mixed)), true)

# Test that var is not parsed as an expression
check("var not expr", Parser("var x")!expression(), 'NO_MATCH)
