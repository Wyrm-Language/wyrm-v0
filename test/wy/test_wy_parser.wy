import wyrm::parser::parser::*
import wyrm::ast::*
import std::io::*

fn check(what: str, got, want):
    if got == want:
        println("PASS " + what)
    else:
        println("FAIL " + what + " got " + str(got))

fn cmd_type(v: pair) -> sym: car(v)

fn is_num_tok(t) -> bool: t.kind == 'TOK_LITERAL_NUMBER

check("basic xid", Parser("std")!xid(), "std")
check("basic xid split on operator", Parser("std.asdf")!xid(), "std")
check("xid includes $", Parser("$_ope1n$.asdf")!xid(), "$_ope1n$")
check("xid excludes keyword", Parser("fn")!xid(), 'NO_MATCH)

basic_import := Parser("import std::io")!import_stmt()
check("basic import parse", cmd_type(basic_import), 'import)
check("basic import target", cmd_type(car(cadr(basic_import))), 'qualified_name)

p_import_2 := Parser("import std::io 12345")
r_import_2 := p_import_2!import_stmt()
check("import with garbage", r_import_2 is error, true)

check("nil parse", Parser("nil")!nil_literal(), 'nil)

p_qual_id_1 := Parser("foo::bar::baz::bleet")
r_qual_id_1 := p_qual_id_1!qualified_name()
check("qual_id parsed into correct size", len(r_qual_id_1), 5)

p_qual_id_2 := Parser("**")
r_qual_id_2 := p_qual_id_2!qualified_name()
check("qual_id parsed into 'NO_MATCH", r_qual_id_2, 'NO_MATCH)

check("bool true parse", Parser("true")!literal(), 'true)
check("bool false parse", Parser("false")!bool_literal(), 'false)
check("bool non-parse", Parser("!")!bool_literal(), 'NO_MATCH)
# #check("bool in paren (primary recurse)", Parser("(true)")!expression(), $['true])

