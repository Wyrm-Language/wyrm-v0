import wyrm::parser::tokenizer::*
import wyrm::ast

import static wyrm::parser::_dsl::*



class Parser:
    slot buffer: str
    slot tokens: list
    slot pos: int

    fn init(buffer: str):
        this.buffer = buffer
        this.tokens = TokenStream(buffer) ! scan()
        this.pos = 0

    fn peek(n: int) -> Token:
        idx := this.pos + n
        last := len(this.tokens) - 1
        if idx > last:
            idx = last
        return this.tokens[idx]

    fn advance() -> Token:
        t := this ! peek(0)
        this.pos = this.pos + 1
        return t

    fn mark() -> int:
        return this.pos

    fn reset(mark: int):
        this.pos = mark

    # -------------------------------------------------------------------------
    # Low Level / Near Lexical Tokens
    # -------------------------------------------------------------------------






    fn program():
        # GRAMMAR: program ::= { top_level_stmt }
        @accept
        many(top_level_stmt)

    fn top_level_stmt():
        # GRAMMAR: top_level_stmt ::= import_stmt | stmt_line
        @accept
        $[import_stmt | stmt_line]



    # import_stmt     ::= "import" , [ "static" ] , import_body ;

    # import_body     ::= module_path , [ "as" , identifier ]
    #                    | module_path , "::" , "(" , import_item_list , ")"
    #                    | module_path , "::" , "*" , [ "except" , except_names ] ;

    # import_item_list
    #                 ::= import_item , { "," , import_item } ;

    # import_item     ::= identifier , [ "as" , identifier ] ;

    # except_names    ::= identifier
    #                    | "(" , name_list , ")" ;

    # module_path     ::= identifier , { "::" , identifier } ;

    # name_list       ::= identifier , { "," , identifier } ;

    fn import_stmt():
        # GRAMMAR: import_stmt     ::= "import" , [ "static" ] , import_body ;
        @accept
        $["import", bool("static"), import_body, expect("statement end", stmt_end)]

    fn import_body():
        # GRAMMAR:
        #   import_body     ::= qual_id , [ "as" , identifier ]
        #           | qual_id , "::" , "(" , import_item_list , ")"
        #           | qual_id , "::" , "*" , [ "except" , except_names ] ;
        @accept
        $[module_path]
    
    fn module_path():
        @accept
        $[qual_id]

    # -------------------------------------------------------------------------
    # Primitive Tokens
    # -------------------------------------------------------------------------

    fn qual_id():
        # GRAMMAR: qual_id ::= xid, { "::", xid } ;
        @accept
        $[xid, many($[~'TOK_SCOPE, xid])]

    # -------------------------------------------------------------------------
    # Lexical Token to Primitive Type
    # -------------------------------------------------------------------------

    fn stmt_end():
        # GRAMMAR: stmt_end ::= NEWLINE | ";"
        @accept
        $['TOK_NEWLINE | 'TOK_SEMICOLON | 'TOK_END]

    fn expect_stmt_end() -> bool:
        @accept $[expect("statement end", stmt_end)]

    fn xid() -> str:
        tok := @accept 'TOK_XID
        return tok ! get_text(this.buffer)




