    {"name": "defer_reg", "value": 0xAD, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "iter", "value": 0xAE, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "itnext", "value": 0xAF, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "yield_from", "value": 0xB0, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "unpack", "value": 0xB1, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "cmp3", "value": 0xB2, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "getscope", "value": 0xB3, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "setscope", "value": 0xB4, "form": "long", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "import_star", "value": 0xB5, "form": "long", "shape": "", "wide_name": "", "wide_value": 0}
