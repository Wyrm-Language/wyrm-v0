# wyrm bytecode opcodes - GENERATED from wypoc/compiler_bc/opcodes.py.
#
# Do not hand-edit: run pypoc/tools/generate_opcode_wy.py after changing
# the opcode table. doc/llm-bytecode.md section 3 is the prose alongside
# it.
#
# Instruction encoding (section 2), little-endian:
#
#   word 0:  [ a0 : u16 ][ f : u8 ][ op : u8 ]
#   word 1:  [ a1 : u16 ][ a2 : u16 ]
#
# Bit 7 of the opcode is the length: op < 0x80 is one word, op >= 0x80
# is two words.
#
# This module carries only what epic 9 needs to *encode* instructions -
# the data table, lookup, register-reference helpers, and pack() - not a
# disassembler (deferred; see vm_plan/epic_9.md M2 scope) and not
# pack_pairable's automatic compact/wide fallback (hand-assembly already
# knows which form each instruction uses).

LONG_START := 0x80
P_BIT := 0x8000

CORE := "core"
PAIRABLE := "pairable"
LONG := "long"

# Every row carries name/value/form; pairable rows additionally carry
# shape/wide_name/wide_value (the wide twin's mnemonic and value, or
# ""/0 on a row that has none).
OPS := [
    {"name": "noop", "value": 0x00, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "trap", "value": 0x01, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "return", "value": 0x02, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "lnil", "value": 0x03, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "lbool", "value": 0x04, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "lunset", "value": 0x05, "form": "core", "shape": "", "wide_name": "", "wide_value": 0},
    {"name": "i8", "value": 0x40, "form": "pairable", "shape": "imm", "wide_name": "i32", "wide_value": 0xC0},
    {"name": "move", "value": 0x41, "form": "pairable", "shape": "reg", "wide_name": "move", "wide_value": 0xC1},
    {"name": "gget", "value": 0x42, "form": "pairable", "shape": "inv", "wide_name": "gget", "wide_value": 0xC2},
    {"name": "gset", "value": 0x43, "form": "pairable", "shape": "inv", "wide_name": "gset", "wide_value": 0xC3},
    {"name": "lsym", "value": 0x45, "form": "pairable", "shape": "inv", "wide_name": "lsym", "wide_value": 0xC5},
    {"name": "lconst", "value": 0x46, "form": "pairable", "shape": "inv", "wide_name": "lconst", "wide_value": 0xC6},
    {"name": "import", "value": 0x47, "form": "pairable", "shape": "inv", "wide_name": "import", "wide_value": 0xC7},
    {"name": "neg", "value": 0x48, "form": "pairable", "shape": "reg", "wide_name": "neg", "wide_value": 0xC8},
    {"name": "inv", "value": 0x49, "form": "pairable", "shape": "reg", "wide_name": "inv", "wide_value": 0xC9},
    {"name": "not", "value": 0x4A, "form": "pairable", "shape": "reg", "wide_name": "not", "wide_value": 0xCA},
