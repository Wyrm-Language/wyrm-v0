# wy/wyrm/tools/test_image_driver.wy - epic 9 M3 milestone-verification
# driver for wy/wyrm/image.wy.
#
# NOT wired into any test harness (see wy/wyrm/tools/test_cbor_driver.wy's
# header comment for why: this compiles under pypoc's compiler_bc and runs
# on this repo's C VM `wyrm` binary, a different pipeline from the
# tree-walker `test/wy/*` suite). Hand-builds the `hello` module image from
# doc/wyc-format.md Appendix A (statics, one function `greet`, the 15 code
# words, exports, free - all given verbatim in doc-llm/history/wypoc-vm-port/epic_9.md's M3
# section) via image.wy's constructors and opcodes.wy's `pack()`, then
# writes `to_wyc()`'s bytes to a file with the C VM's raw `std::io`
# natives (open/write/close on an int handle - see the import comment
# below for why, not wy/std/io.wy's `File` class).
#
# Run it by hand:
#
#   work=$(mktemp -d)
#   cp wy/wyrm/cbor.wy wy/wyrm/opcodes.wy wy/wyrm/image.wy \
#      wy/wyrm/tools/test_image_driver.wy "$work/"
#   for f in cbor opcodes image test_image_driver; do
#     pypoc/.venv/bin/wyrm -Iwy -Iwy/wyrm --build-bc "$work/$f.wy"
#   done
#   ./buildDir/src/wyrm/wyrm -I"$work" "$work/test_image_driver.wyc"
#
#   mkdir -p /tmp/e9_hello_ref
#   pypoc/.venv/bin/wyrm --build-bc --strip --emit wyc -o /tmp/e9_hello_ref \
#     pypoc/test/bytecode/hello.wy
#   cmp /tmp/hello_built.wyc /tmp/e9_hello_ref/hello.wyc
#
# `cmp` reporting no difference is this milestone's real acceptance gate.
#
# The output path is hardcoded below (OUT_PATH) rather than taken from a
# CLI argument: this repo's wy scripts have no exposed `argv`-equivalent
# builtin to read the extra `wyrm file.wyc [args...]` CLI arguments from
# wy source (checked: no such builtin in doc/stdlib.md, and nothing in
# src/*.c wires CLI argv into a wy-visible global/builtin).

import cbor::*
import image::*
import std::io

# The C VM has no compiled `.wy` corelib (no compiler exists in this repo
# until epics 9-11 - see test/bytecode/bytes_header/cvm_header.wy's header
# comment for the precedent), so `std::io` here is raw POSIX natives
# (open/write/close on an int handle), not wy/std/io.wy's `File` class /
# `write_bytes_file` helper (those only exist on pypoc's tree-walker).

OUT_PATH := "/tmp/hello_built.wyc"

fn build_hello_image() -> dict:
    img := make_image("hello", 2)
    img["statics"] = ["Hello ", "World"]
    # functions[0] is the module init (4 locals, code offset 0); greet is functions[1]
    img["functions"] = [make_function("<init>", [], 4, 0, 0), make_function("greet", [make_param("name")], 3, 12, 0)]
    img["exports"] = {"greet": 0}
    img["free"] = {"println": 1}

    # The words `wyrm --disasm` shows for test/corpus/hello.wy: the init routine
    # (functions[0]) at offset 0, then greet at offset 12.
    words := []
    # -- module init (functions[0], offset 0) --
    for w in pack('closure, a0=1, a1=1):
        words!append(w)
    for w in pack('gset, f=1, a0=0):
        words!append(w)
    for w in pack('gget, f=1, a0=1):
        words!append(w)
    for w in pack('gget, f=2, a0=0):
        words!append(w)
    for w in pack('lconst, f=3, a0=1):
        words!append(w)
    for w in pack('call, f=1, a0=2):
        words!append(w)
    for w in pack('move, f=0, a0=2):
        words!append(w)
    for w in pack('call, f=1, a0=1):
        words!append(w)
    for w in pack('move, f=0, a0=1):
        words!append(w)
    for w in pack('lnil, f=0, a0=0):
        words!append(w)
    for w in pack('return, f=0, a0=0):
        words!append(w)
    # -- greet (functions[1], offset 12) --
    for w in pack('lconst, f=1, a0=0):
        words!append(w)
    for w in pack('add, f=0, a0=2, a1=1, a2=P(0)):
        words!append(w)
    for w in pack('return, f=0, a0=2):
        words!append(w)

    img["code"] = words
    return img

fn main():
    img := build_hello_image()
    encoded := to_wyc(img)
    if encoded is error:
        println("FAIL: to_wyc errored: " + str(encoded))
        return
    handle := std::io::open(OUT_PATH, "wb")
    handle!write(encoded)
    handle!close()
    println("wrote hello image to " + OUT_PATH)

main()
