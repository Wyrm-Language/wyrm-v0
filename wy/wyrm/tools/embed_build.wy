# wy/wyrm/tools/embed_build.wy - epic 11 M1
#
# Emits the builtin module table's C sources: for every module in
# src/embed/modules.txt it compiles the .wy source (exactly like compiler_main
# does: parse, compile_module strict, the decorator expander on) and writes the
# static wy_module_image C array via wyrm::image's to_c(), plus the generated
# table .c and the unity-include .c that meson compiles. They are build output,
# never committed: scripts/embed_stage.py runs this during the build (project
# design/plans/I-generated-images.md).
#
#     wyrm [-I<tree> ...] embed_build.wy[d] <src/embed root> <out-dir> [option...]
#
# --scopes DIR: expansion scope images from a wyrm_bootstrap on an older image format
#     (wyrm::compiler::tree_build).
# --only REL: compile this one module and write no table, so a slow interpreter can
#     compile modules in parallel. --tables then writes the table and the unity file.
# --native-parse: parse with the interpreter's own parser (wypoc's `__parse_tree`),
#     which builds the same tree as wyrm::parser and is far faster there.
#
# std::expand stays a host module installed by src/wyrm/main.c and is
# deliberately absent. An expansion VM (epic 10a D10) imports the embedded
# std::io fine but has no `__open`/`__read`/... natives, so it still cannot do
# any I/O.

import std::io
import wyrm::parser::*
import wyrm::compiler::module::*
import wyrm::compiler::expansion::*
import wyrm::image::*
import wyrm::opcodes::*
import wyrm::compiler::tree_build::*

# Package-relative spellings (`cbor::*`/`opcodes::*`, not wyrm::cbor): extra
# table rows pointing at the same images.
ALIAS_SYMBOLS := ["cbor", "opcodes"]

native_parse := false

fn basename(path: str) -> str:
    last := 0
    i := 0
    n := len(path)
    while i < n:
        if substr(path, i, 1) == "/":
            last = i + 1
        i = i + 1
    return substr(path, last, n - last)

fn stem(name: str) -> str:
    n := len(name)
    if (n > 3) and (substr(name, n - 3, 3) == ".wy"):
        return substr(name, 0, n - 3)
    return name

# "wyrm/compiler/module.wy" -> "wyrm/compiler/module" (the .c path, relative to
# the embed root, minus extension: each image lands beside its source; the
# image symbol inside comes from to_c and is the module's own stem).
fn c_file_stem(rel: str) -> str:
    return substr(rel, 0, len(rel) - 3)  # every EMBED path ends in ".wy"

fn join_lines(lines: list) -> str:
    out := ""
    i := 0
    n := len(lines)
    while i < n:
        if i > 0:
            out = out + "\n"
        out = out + lines[i]
        i = i + 1
    return out + "\n"

fn write_text(path: str, text: str) -> bool:
    f := std::io::open(path, "w")
    if f is error:
        println("EMBED-FAIL " + path + " (open for write)")
        return false
    w := f!write(text)
    f!close()
    if w is error:
        println("EMBED-FAIL " + path + " (write)")
        return false
    return true

# The embed list, src/embed/modules.txt: one path per line, relative to src/embed and in
# dependency order. Its order is also the table's row order. A package with no code needs
# no row: the rows filed under it make it a namespace package (design/modules.md M1), so
# `import wyrm::compiler::module` resolves `wyrm::compiler` with no file.
fn read_embed_list(src_root: str):
    f := std::io::open(src_root + "/modules.txt", "r")
    if f is error:
        return error("modules.txt: unreadable")
    text := f!readall()
    f!close()
    if text is error:
        return error("modules.txt: unreadable")
    rows := []
    begin := 0
    i := 0
    n := len(text)
    while i < n:
        if substr(text, i, 1) == "\n":
            if i > begin:
                rows ! append(substr(text, begin, i - begin))
            begin = i + 1
        i = i + 1
    if n > begin:
        rows ! append(substr(text, begin, n - begin))
    return rows

# Compile one embed-list module and write its image .c; answers the .c file
# stem, or an error value.
fn embed_one(src_root: str, out_dir: str, rel: str):
    path := src_root + "/" + rel
    name := stem(basename(rel))
    f := std::io::open(path, "r")
    if f is error:
        return error("unreadable")
    src := f!readall()
    f!close()
    if src is error:
        return error("unreadable")
    tree := nil
    if native_parse:
        tree = src ! __parse_tree()
    else:
        tree = Parser(src)!program()
    if tree is error:
        return error("parse")
    img := compile_module(tree, name, path, true, false, false, false, expand_decorators)
    if img is error:
        return error("compile: " + str(error_message(img)))
    note_tree_image(rel, img)
    text := to_c(img)
    if text is error:
        return error("to_c: " + str(error_message(text)))
    file_stem := c_file_stem(rel)
    if not write_text(out_dir + "/" + file_stem + ".c", text):
        return error("write failed")
    return file_stem

args := __ARGS
only := nil
tables_only := false
usage_error := len(args) < 2
arg := 2
while (not usage_error) and (arg < len(args)):
    if args[arg] == "--native-parse":
        native_parse = true
        arg = arg + 1
    elif args[arg] == "--tables":
        tables_only = true
        arg = arg + 1
    elif (args[arg] == "--scopes") and (arg + 1 < len(args)):
        set_expansion_scopes(args[arg + 1])
        arg = arg + 2
    elif (args[arg] == "--only") and (arg + 1 < len(args)):
        only = args[arg + 1]
        arg = arg + 2
    else:
        usage_error = true
if usage_error:
    println("usage: embed_build.wyd <embed-src-root> <out-dir> [--scopes DIR] [--only REL] [--tables] [--native-parse]")
elif only is not nil:
    got := embed_one(args[0], args[1], only)
    if got is error:
        println("EMBED-FAIL " + only + " (" + str(error_message(got)) + ")")
    else:
        println("embed_build: done (" + only + ")")
else:
    q := _char_from_cp(34)  # wy strings have no \" escape; image.wy does the same dance
    src_root := args[0]
    out_dir := args[1]
    unity := ["/* Generated by wy/wyrm/tools/embed_build.wy - every embedded image", "   translation unit in one include, so meson lists exactly one file. Do not edit. */", ""]
    rows := []
    failed := 0
    embed_list := read_embed_list(src_root)
    if embed_list is error:
        println("EMBED-FAIL " + str(error_message(embed_list)))
        embed_list = []
        failed = 1
    for rel in embed_list:
        got := nil
        if tables_only:
            got = c_file_stem(rel)
        else:
            got = embed_one(src_root, out_dir, rel)
        if got is error:
            println("EMBED-FAIL " + rel + " (" + str(error_message(got)) + ")")
            failed = failed + 1
        else:
            # row: [virtual import path, image symbol stem, .c file stem]
            rows ! append([module_path_of(rel), stem(basename(rel)), got])
            unity ! append("#include " + q + got + ".c" + q)
    for sym in ALIAS_SYMBOLS:
        rows ! append([sym, sym, ""])
    tbl := ["/* Generated by wy/wyrm/tools/embed_build.wy - do not edit. */", "", "#include <wyrm/image.h>", "#include <wyrm/platform/hosted/import_fs.h>", "", "/* The embedded images were generated for this format version; a stale table fails the build. */", "_Static_assert(WY_IMAGE_VERSION == " + str(WYC_VERSION) + "u, " + q + "embedded images are for another .wyc version; regenerate them" + q + ");", "", "/* Image symbols, defined in embedded_images.c's translation units: */", ""]
    for row in rows:
        if row[2] != "":
            tbl ! append("extern const wy_module_image " + row[1] + "_image;")
    tbl ! append("")
    tbl ! append("const wy_import_fs_builtin wyrm_builtin_modules[] = {")
    for row in rows:
        tbl ! append("    { " + q + row[0] + q + ", &" + row[1] + "_image },")
    tbl ! append("};")
    tbl ! append("")
    tbl ! append("const wy_uword wyrm_builtin_module_count = " + str(len(rows)) + ";")
    if not write_text(out_dir + "/wyrm_builtins_table.c", join_lines(tbl)):
        failed = failed + 1
    if not write_text(out_dir + "/embedded_images.c", join_lines(unity)):
        failed = failed + 1
    if failed > 0:
        println("embed_build: FAILED (" + str(failed) + " failures)")
    else:
        println("embed_build: done (" + str(len(rows)) + " table rows)")
