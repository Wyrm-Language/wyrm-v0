# Low level / not well thought out std io library

newline := "\n"

fn println(*content):
    first := true
    for arg in content:
        if not first:
            __write(__STDOUT, " ")
        first = false
        __write(__STDOUT, str(arg))
    __write(__STDOUT, "\n")

class File:
    slot handle: int = -1

    fn read(size) -> str:
        return __read(this.handle, size)

    fn readall() -> str:
        return __read(this.handle, -1)

    # For a handle opened in binary mode ("rb", ...): __read then answers a
    # Python bytes object rather than a str, and bytes(...) copies it into a
    # real wyrm bytes value (see doc/stdlib.md's `### bytes`).
    fn read_bytes(size) -> bytes:
        return bytes(__read(this.handle, size))

    # `data` may be a str or a bytes value - __write just hands it to the
    # underlying handle's own write(), so this matches whichever mode the
    # handle was opened in ("w"/"a" for str, "wb"/"ab" for bytes).
    fn write(data) -> int:
        return __write(this.handle, data)

    fn seek(offset, whence) -> int:
        return __lseek(this.handle, offset, whence)

    fn tell() -> int:
        return __lseek(this.handle, 0, 1)

    fn flush() -> int:
        return __flush(this.handle)

    fn close() -> int:
        return __close(this.handle)

# Open a file
#
# @param path Path of the file to open
# @param mode Mode string, C style, "r", "w", "rw"
fn open(path: str, mode: str) -> File:
    f := File()
    f.handle = try __open(path, mode)
    return f

# Read full contents of a file
#
# @param path Path of file to read
fn read_file(path) -> str:
    f := try open(path, "r")
    defer:
        f!close()
    return f!readall()

# Write a file
#
# @param path path of the file
# param data content to write
fn write_file(path, data) -> int:
    f := try open(path, "w")
    defer:
        f!close()
    return f!write(data)

# Binary-mode counterpart to write_file, for a bytes value (epic 7). See
# pypoc/wypoc/corelib/std/io.wy's copy for why this is a separate top-level
# function rather than just "open(path, 'wb')" from an external caller.
fn write_bytes_file(path, data) -> int:
    f := try open(path, "wb")
    defer:
        f!close()
    return f!write(data)
